<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Klodi.App.ViewModels"
             xmlns:inf="using:Klodi.App.Infrastructure"
             xmlns:c="using:Klodi.App.Controls"
             x:Class="Klodi.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Focusable="True">

  <!-- Flat combo boxes: text + chevron, like the original's font pickers. -->
  <UserControl.Resources>
    <SolidColorBrush x:Key="ComboBoxBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="Transparent" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="Transparent" />
    <SolidColorBrush x:Key="ComboBoxForeground" Color="#EEEDE8" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#20201E" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#363636" />
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#A8A6A0" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBlock.pagetitle">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="TextBlock.rowlabel">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.rowhint">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
    <Style Selector="Grid.row">
      <Setter Property="MinHeight" Value="56" />
    </Style>
    <Style Selector="Border.rowline">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="#262624" />
    </Style>
    <Style Selector="Border.segments">
      <Setter Property="Background" Value="#262624" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinWidth" Value="200" />
      <Setter Property="HorizontalContentAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="MaxDropDownHeight" Value="420" />
    </Style>
    <Style Selector="Border.field">
      <Setter Property="Background" Value="#202020" />
      <Setter Property="BorderBrush" Value="#383838" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Height" Value="31" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Border Background="#1A1A18"
          BorderBrush="#262624"
          BorderThickness="1"
          CornerRadius="12"
          MaxWidth="1278"
          MaxHeight="935"
          Margin="24,48"
          ClipToBounds="True"
          BoxShadow="0 16 48 0 #59000000">
    <Grid ColumnDefinitions="211,*">

      <!-- Navigation -->
      <Border Background="{StaticResource BgMainBrush}" BorderBrush="#2C2C2C" BorderThickness="0,0,1,0">
        <StackPanel Margin="12,0" Spacing="1">
          <TextBlock Text="Settings" Classes="section" FontSize="13" Margin="8,30,0,10" />
          <Button Theme="{StaticResource NavButton}" Classes.selected="{Binding IsGeneralPage}" Command="{Binding ShowGeneralCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <c:Icon Data="{StaticResource IconGear}" />
              <TextBlock Text="General" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Theme="{StaticResource NavButton}" Classes.selected="{Binding IsClaudeCodePage}" Command="{Binding ShowClaudeCodeCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <c:Icon Data="{StaticResource IconTerminal}" />
              <TextBlock Text="Claude Code" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <!-- Pages -->
      <Panel Grid.Column="1">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Panel Margin="24,58,34,32">

            <!-- General -->
            <StackPanel IsVisible="{Binding IsGeneralPage}">
              <TextBlock Text="Appearance" Classes="pagetitle" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Interface font" Classes="rowlabel" />
                  <TextBlock Text="Font for the whole interface — menus, sidebar and transcript." Classes="rowhint" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding UiFonts}" SelectedItem="{Binding InterfaceFont}" />
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Code font" Classes="rowlabel" />
                  <TextBlock Text="Used for code blocks, inline code and tool details." Classes="rowhint" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding CodeFonts}" SelectedItem="{Binding CodeFont}" />
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <TextBlock Text="Transcript text size" Classes="rowlabel" VerticalAlignment="Center" />
                <Border Grid.Column="1" Classes="segments">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="TextSize" IsChecked="{Binding IsTextSmall}" Content="Small" />
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="TextSize" IsChecked="{Binding IsTextMedium}" Content="Medium" />
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="TextSize" IsChecked="{Binding IsTextLarge}" Content="Large" />
                  </StackPanel>
                </Border>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Transcript width" Classes="rowlabel" />
                  <TextBlock Text="Maximum width of the transcript and composer columns." Classes="rowhint" />
                </StackPanel>
                <Border Grid.Column="1" Classes="segments">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="Width" IsChecked="{Binding IsWidthNarrow}" Content="Narrow" />
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="Width" IsChecked="{Binding IsWidthMedium}" Content="Medium" />
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="Width" IsChecked="{Binding IsWidthWide}" Content="Wide" />
                  </StackPanel>
                </Border>
              </Grid>

              <TextBlock Text="Account" Classes="pagetitle" Margin="0,40,0,10" />
              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Display name" Classes="rowlabel" />
                  <TextBlock Text="Shown at the bottom of the sidebar. Empty uses your Windows user name." Classes="rowhint" />
                </StackPanel>
                <Border Grid.Column="1" Classes="field" Width="260">
                  <TextBox Theme="{StaticResource BareTextBox}" Text="{Binding DisplayName}" Watermark="Your name" FontSize="14.5" />
                </Border>
              </Grid>
            </StackPanel>

            <!-- Claude Code -->
            <StackPanel IsVisible="{Binding IsClaudeCodePage}">
              <TextBlock Text="Claude Code" Classes="pagetitle" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="CLI path" Classes="rowlabel" />
                  <TextBlock Text="The claude executable Klodi starts. &quot;claude&quot; looks it up on PATH." Classes="rowhint" />
                  <TextBlock Text="{Binding CliStatus}" Classes="rowhint" Classes.ok="{Binding CliFound}" FontSize="13" />
                </StackPanel>
                <Border Grid.Column="1" Classes="field" Width="360">
                  <TextBox Theme="{StaticResource BareTextBox}" Text="{Binding CliPath}" Watermark="claude" FontSize="14" FontFamily="{DynamicResource MonoFont}" />
                </Border>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Default model" Classes="rowlabel" />
                  <TextBlock Text="Model of new sessions; each session can switch from the status row." Classes="rowhint" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Models}" SelectedItem="{Binding DefaultModel}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="inf:ModelOption">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Default permission mode" Classes="rowlabel" />
                  <TextBlock Text="How new sessions ask before Claude changes things." Classes="rowhint" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Modes}" SelectedItem="{Binding DefaultMode}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="inf:ModeOption">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Default effort" Classes="rowlabel" />
                  <TextBlock Text="Thinking effort of new sessions (passed as --effort)." Classes="rowhint" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Efforts}" SelectedItem="{Binding DefaultEffort}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="inf:EffortOption">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>

              <TextBlock Classes="rowhint" Margin="0,28,0,0" FontSize="13">
                <Run Text="Settings are saved to" />
                <Run Text="{Binding SettingsPath}" FontFamily="{DynamicResource MonoFont}" />
              </TextBlock>
            </StackPanel>
          </Panel>
        </ScrollViewer>

        <Button Theme="{StaticResource IconButton}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,14,16,0"
                Foreground="{StaticResource TextPrimaryBrush}"
                Click="OnCloseClick"
                ToolTip.Tip="Close (Esc)">
          <c:Icon Data="{StaticResource IconClose}" StrokeThickness="1.6" />
        </Button>
      </Panel>
    </Grid>
  </Border>
</UserControl>
