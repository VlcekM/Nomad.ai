<?xml version="1.0" encoding="utf-8"?>
<!-- Emulator test builds only (-p:NomadEmulatorTest=true): plain HTTP to the PC running the emulator (10.0.2.2), so a local
     test hub can be reached without a certificate. Release builds never include this file. -->
<network-security-config>
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">10.0.2.2</domain>
  </domain-config>
</network-security-config>
