<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    The desktop's button themes (linked Theme/Desktop/Controls.axaml) made for a finger. Each keeps the desktop's face (its
    fill, border, corner, label and hover and pressed colors, which the themes they are based on set) at about the desktop's
    size, drawn centered in a hit area at least 44 px tall (and wide, for the icon buttons): the extra is transparent, so the
    button looks as on the desktop but a thumb can't miss it.
  -->

  <!-- The face: the control's own size is the hit area, the border inside it the visible button. -->
  <ControlTemplate x:Key="PhoneFace" TargetType="Button">
    <Panel Background="Transparent">
      <Border Name="PART_Face"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="{TemplateBinding CornerRadius}"
              VerticalAlignment="Center">
        <Border.Transitions>
          <Transitions>
            <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut" />
          </Transitions>
        </Border.Transitions>
        <ContentPresenter Name="PART_ContentPresenter"
                          Padding="{TemplateBinding Padding}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          Foreground="{TemplateBinding Foreground}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      </Border>
    </Panel>
  </ControlTemplate>

  <!-- Labelled buttons: the desktop's 30 px face a little taller (34) for a thumb, in a 44 px row. -->
  <ControlTheme x:Key="PhonePrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
    <Setter Property="Template" Value="{StaticResource PhoneFace}" />
    <Setter Property="Height" Value="NaN" />
    <Setter Property="MinHeight" Value="44" />
    <Style Selector="^ /template/ Border#PART_Face">
      <Setter Property="Height" Value="34" />
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="PhoneSecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
    <Setter Property="Template" Value="{StaticResource PhoneFace}" />
    <Setter Property="Height" Value="NaN" />
    <Setter Property="MinHeight" Value="44" />
    <Style Selector="^ /template/ Border#PART_Face">
      <Setter Property="Height" Value="34" />
    </Style>
    <!-- Sign out: the danger color on the same face. -->
    <Style Selector="^.danger">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="PhoneGhostButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
    <Setter Property="Template" Value="{StaticResource PhoneFace}" />
    <Setter Property="Height" Value="NaN" />
    <Setter Property="MinHeight" Value="44" />
    <Style Selector="^ /template/ Border#PART_Face">
      <Setter Property="Height" Value="34" />
    </Style>
    <!-- A finger has no hover: Deny shows its color while pressed, as the desktop's does under the pointer. -->
    <Style Selector="^.danger:pressed">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
      <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}" />
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="PhoneInvertedButton" TargetType="Button" BasedOn="{StaticResource InvertedButton}">
    <Setter Property="Template" Value="{StaticResource PhoneFace}" />
    <Setter Property="Height" Value="NaN" />
    <Setter Property="MinHeight" Value="44" />
    <Style Selector="^ /template/ Border#PART_Face">
      <Setter Property="Height" Value="34" />
    </Style>
  </ControlTheme>

  <!-- Icon buttons (back, settings): the desktop's flat 28 px square, its pressed fill a 36 px square in a 44 px target. -->
  <ControlTheme x:Key="PhoneIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
    <Setter Property="Template" Value="{StaticResource PhoneFace}" />
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="CornerRadius" Value="8" />
    <Style Selector="^ /template/ Border#PART_Face">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
  </ControlTheme>

  <!-- The composer's Send and Stop: the desktop's rounded square (30 px there, 32 here) in a 44 px target. -->
  <ControlTheme x:Key="PhoneSendButton" TargetType="Button" BasedOn="{StaticResource SendButton}">
    <Setter Property="Template" Value="{StaticResource PhoneFace}" />
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Style Selector="^ /template/ Border#PART_Face">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
  </ControlTheme>

  <!-- A line to tap (an activity, a thought, Show more): the desktop's text-only line, its target 44 px tall. -->
  <ControlTheme x:Key="PhoneLineButton" TargetType="Button" BasedOn="{StaticResource LineButton}">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="0" />
    <Style Selector="^:pressed">
      <Setter Property="Foreground" Value="{DynamicResource TextChromeBrush}" />
    </Style>
  </ControlTheme>

  <!-- A chat in the list: the desktop sidebar's row, tall enough to tap, with its last line under the title. -->
  <ControlTheme x:Key="PhoneRowButton" TargetType="Button" BasedOn="{StaticResource RowButton}">
    <Setter Property="Height" Value="NaN" />
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="Padding" Value="12,8,12,9" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </ControlTheme>

  <!-- A question's option: the desktop's OptionButton (a rounded row, a fill once chosen), as a toggle, 44 px tall at least. -->
  <ControlTheme x:Key="OptionToggle" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextChromeBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Padding="{TemplateBinding Padding}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          Foreground="{TemplateBinding Foreground}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
          <ContentPresenter.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut" />
            </Transitions>
          </ContentPresenter.Transitions>
        </ContentPresenter>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource BgPressedBrush}" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
