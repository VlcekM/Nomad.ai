<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The phone's look: Nomad's colors on Fluent controls, touch-sized. Motion is short eases only (AGENTS.md). -->

  <Style Selector="TextBlock, SelectableTextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.muted, SelectableTextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <Style Selector="Button">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Background" Value="{DynamicResource BgButtonBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
  </Style>
  <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentEmphasisBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
  </Style>

  <!-- A question's options: picked ones take Nomad's green, not Fluent's blue. -->
  <Style Selector="ToggleButton">
    <Setter Property="Background" Value="{DynamicResource BgButtonBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>
  <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!-- An activity or a thought, tapped to fold open: a chip, not a full button. -->
  <Style Selector="Button.step">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource BgChipBrush}" />
  </Style>
  <Style Selector="Button.step:disabled">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.step:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgChipBrush}" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>
  <Style Selector="Button.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="10,6" />
  </Style>
  <Style Selector="Button.row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{DynamicResource BgInputBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderInputBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,12" />
  </Style>
  <Style Selector="Border.bar">
    <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
  </Style>

  <!-- A chat's state, as a small dot. -->
  <Style Selector="Ellipse.state">
    <Setter Property="Width" Value="9" />
    <Setter Property="Height" Value="9" />
    <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="Ellipse.state.working">
    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Ellipse.state.waiting">
    <Setter Property="Fill" Value="{DynamicResource WaitingBrush}" />
  </Style>

  <!-- Things that appear ease in. -->
  <Style Selector="ContentControl.page">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
</Styles>
