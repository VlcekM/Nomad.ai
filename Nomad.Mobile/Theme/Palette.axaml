<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    The phone's sizes, over the desktop's palette (linked from Nomad.App/Theme/Palette.axaml, merged before this one): the
    same colors, the same transcript body (15), the interface text a step up from the desktop's 13, which is small in a hand.
    A phone has no Cascadia or Consolas, so code falls through to Android's own monospace.
  -->
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Roboto Mono, Droid Sans Mono, monospace</FontFamily>
  <x:Double x:Key="UiFontSize">14</x:Double>
  <x:Double x:Key="UiFontSizeSmall">13</x:Double>
  <x:Double x:Key="UiFontSizeTiny">12</x:Double>
  <x:Double x:Key="UiFontSizeLarge">15</x:Double>
  <x:Double x:Key="UiFontSizeTitle">17</x:Double>
  <x:Double x:Key="BodyFontSize">15</x:Double>
  <x:Double x:Key="BodyLineHeight">21</x:Double>
  <x:Double x:Key="CodeFontSize">13</x:Double>
</ResourceDictionary>
