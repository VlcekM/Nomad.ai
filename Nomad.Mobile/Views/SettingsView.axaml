<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nomad.Mobile.ViewModels"
             xmlns:c="using:Nomad.App.Controls"
             x:Class="Nomad.Mobile.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <DockPanel>
    <!-- The top bar, as the chat's: back and the page's title. -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Height="56" Margin="4,0,14,0">
      <Button Theme="{StaticResource PhoneIconButton}" Command="{Binding BackCommand}" AutomationProperties.Name="Back to chats" ToolTip.Tip="Chats">
        <c:Icon Size="18" Data="{StaticResource IconArrowLeft}" />
      </Button>
      <TextBlock Grid.Column="1" Classes="title" Text="Settings" VerticalAlignment="Center" Margin="4,0,0,0" />
    </Grid>

    <!-- The desktop settings' pages: a section title, then rows (a label, its value or hint) between thin rules. -->
    <ScrollViewer>
      <StackPanel Margin="20,8,20,20">
        <TextBlock Classes="section" Text="Hub" Margin="0,8,0,6" />
        <StackPanel Margin="0,10" Spacing="3">
          <TextBlock Classes="rowlabel" Text="{Binding HubAddress}" TextWrapping="Wrap" />
          <TextBlock Classes="rowhint" Text="{Binding ConnectionText}" />
        </StackPanel>
        <Border Classes="rowline" />
        <Grid ColumnDefinitions="*,Auto" Margin="0,10" MinHeight="24">
          <TextBlock Classes="rowlabel" Text="This phone" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Classes="rowhint" Text="{Binding DeviceName}" VerticalAlignment="Center" />
        </Grid>

        <TextBlock Classes="section" Text="PCs sharing chats" Margin="0,22,0,6" />
        <TextBlock Classes="rowhint" Text="None right now." IsVisible="{Binding !HasPcs}" Margin="0,10" />
        <ItemsControl ItemsSource="{Binding Pcs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:PcLine">
              <StackPanel>
                <Grid ColumnDefinitions="*,Auto" Margin="0,10" MinHeight="24">
                  <TextBlock Classes="rowlabel" Text="{Binding Name}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="rowhint" Text="{Binding Detail}" VerticalAlignment="Center" />
                </Grid>
                <Border Classes="rowline" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Spacing="2" Margin="0,26,0,0">
          <Button Theme="{StaticResource PhoneSecondaryButton}" Content="Connect to another hub" Command="{Binding ConnectElsewhereCommand}"
                  HorizontalAlignment="Stretch" />
          <Button Theme="{StaticResource PhoneSecondaryButton}" Classes="danger" Content="{Binding SignOutText}" Command="{Binding SignOutCommand}"
                  IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Stretch" />
          <TextBlock Classes="rowhint" FontSize="{DynamicResource UiFontSizeSmall}" Margin="0,8,0,0"
                     Text="Signing out revokes this phone on the hub, so its saved sign-in no longer works. A lost phone can be revoked in Settings › Hub on any PC." />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
