<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nomad.Mobile.ViewModels"
             xmlns:v="using:Nomad.Mobile.Views"
             xmlns:c="using:Nomad.App.Controls"
             x:Class="Nomad.Mobile.Views.NewChatView"
             x:DataType="vm:NewChatViewModel">
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Height="56" Margin="4,0,14,0">
      <Button Theme="{StaticResource PhoneIconButton}" Command="{Binding BackCommand}" AutomationProperties.Name="Back to chats" ToolTip.Tip="Chats">
        <c:Icon Size="18" Data="{StaticResource IconArrowLeft}" />
      </Button>
      <TextBlock Grid.Column="1" Classes="title" Text="New chat" VerticalAlignment="Center" Margin="4,0,0,0" />
    </Grid>

    <!-- The first message, in the desktop's composer bar, above the keyboard; its arrow starts the chat. -->
    <StackPanel DockPanel.Dock="Bottom" Margin="12,4,12,12" Spacing="6">
      <TextBlock Text="{Binding Status}" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Classes="muted small" Classes.problem="{Binding StatusIsProblem}" TextWrapping="Wrap" Margin="4,0">
        <TextBlock.Styles>
          <Style Selector="TextBlock.problem">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
          </Style>
        </TextBlock.Styles>
      </TextBlock>
      <Border Classes="composer">
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Text="{Binding Prompt}" Watermark="Describe a task or ask a question" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="160"
                   Margin="14,12,4,12" VerticalAlignment="Center" VerticalContentAlignment="Top"
                   TextInputOptions.Multiline="True" TextInputOptions.AutoCapitalization="True" TextInputOptions.ShowSuggestions="True" />
          <Button Grid.Column="1" Theme="{StaticResource PhoneSendButton}" Command="{Binding StartCommand}"
                  Focusable="False" VerticalAlignment="Bottom" Margin="0,0,2,1" AutomationProperties.Name="Start the chat">
            <c:Icon Size="16" Data="{StaticResource IconSendArrow}" StrokeThickness="1.8" />
          </Button>
        </Grid>
      </Border>
    </StackPanel>

    <!-- Where and how it starts: the PC's own choices, as its new-session page offers them. -->
    <ScrollViewer>
      <StackPanel Margin="20,8,20,20">
        <TextBlock Classes="rowhint" Text="Asking the PC…" IsVisible="{Binding IsLoading}" Margin="0,10" />
        <ItemsControl ItemsSource="{Binding Settings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:SettingViewModel">
              <v:SettingRowView />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="rowhint" FontSize="{DynamicResource UiFontSizeSmall}" TextWrapping="Wrap" Margin="0,12,0,0"
                   Text="It starts on the PC as its new-session page would start it, and opens here once it has begun." />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
