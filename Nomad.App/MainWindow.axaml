<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Nomad.App.ViewModels"
        xmlns:views="using:Nomad.App.Views"
        xmlns:c="using:Nomad.App.Controls"
        xmlns:md="using:Nomad.App.Markdown"
        x:Class="Nomad.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Nomad.ai"
        Icon="/Assets/nomad.ico"
        Width="1400" Height="900"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="36"
        Background="{DynamicResource BgMainBrush}">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewSessionCommand}" />
    <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <!-- Resize grips (the sidebar's right edge, the side panel's left): a thin blue line fades in over the edge on
         hover and stays while dragging, as in the desktop app. -->
    <Style Selector="Border.resizegrip">
      <Setter Property="Width" Value="7" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="SizeWestEast" />
      <Setter Property="ZIndex" Value="1" />
    </Style>
    <Style Selector="Border.resizegrip > Border">
      <Setter Property="Width" Value="2" />
      <Setter Property="Background" Value="{DynamicResource RingBrush}" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.resizegrip:pointerover > Border, Border.resizegrip.dragging > Border">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </Window.Styles>

  <Panel>
    <Grid ColumnDefinitions="Auto,*">

      <!-- ============================================================ sidebar -->
      <!-- Ctrl+B or the sidebar button: the width slides between SidebarWidth and 0, the content keeps
           its width and is right-aligned, so it slides out to the left instead of reflowing. -->
      <!-- (Its right edge, SidebarGrip below, drags the width.) -->
      <Border Grid.Column="0"
              Name="Sidebar"
              Classes.closed="{Binding !IsSidebarOpen}"
              ClipToBounds="True"
              Background="{DynamicResource BgSidebarBrush}"
              BorderBrush="{DynamicResource BorderDividerBrush}"
              BorderThickness="0,0,1,0">
        <Border.Styles>
          <Style Selector="Border#Sidebar">
            <Setter Property="Width" Value="{Binding SidebarWidth}" />
          </Style>
          <Style Selector="Border#Sidebar.closed">
            <Setter Property="Width" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
          </Style>
        </Border.Styles>
        <Border.Transitions>
          <Transitions>
            <DoubleTransition Property="Width" Duration="0:0:0.2" Easing="CubicEaseOut" />
          </Transitions>
        </Border.Transitions>
        <Grid Width="{Binding SidebarContentWidth}" HorizontalAlignment="Right" RowDefinitions="36,Auto,Auto,Auto,Auto,Auto,*,Auto">
          <Grid.Styles>
            <!-- Session rows fold their height and fade when they are archived or deleted. -->
            <Style Selector="Button.sessionrow">
              <Setter Property="Height" Value="26" />
              <Setter Property="Margin" Value="8,2,11,2" />
              <Setter Property="Transitions">
                <Transitions>
                  <DoubleTransition Property="Height" Duration="0:0:0.2" Easing="CubicEaseOut" />
                  <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut" />
                  <ThicknessTransition Property="Margin" Duration="0:0:0.2" Easing="CubicEaseOut" />
                </Transitions>
              </Setter>
            </Style>
            <Style Selector="Button.sessionrow.leaving">
              <Setter Property="Height" Value="0" />
              <Setter Property="Opacity" Value="0" />
              <Setter Property="Margin" Value="8,0,11,0" />
              <Setter Property="IsHitTestVisible" Value="False" />
            </Style>

            <!-- Section and group headings: the chevron shows on hover (always while collapsed) and turns
                 to point right when collapsed; a collapsed group shows its count. -->
            <Style Selector="c|Icon.sectionchev">
              <Setter Property="Opacity" Value="0" />
              <Setter Property="RenderTransform" Value="rotate(0deg)" />
              <Setter Property="Transitions">
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
                  <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
                </Transitions>
              </Setter>
            </Style>
            <Style Selector="Button:pointerover c|Icon.sectionchev">
              <Setter Property="Opacity" Value="1" />
            </Style>
            <Style Selector="Button.collapsed c|Icon.sectionchev">
              <Setter Property="Opacity" Value="1" />
              <Setter Property="RenderTransform" Value="rotate(-90deg)" />
            </Style>
            <Style Selector="TextBlock.groupcount">
              <Setter Property="Opacity" Value="0" />
              <Setter Property="Transitions">
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut" />
                </Transitions>
              </Setter>
            </Style>
            <Style Selector="Button.collapsed TextBlock.groupcount">
              <Setter Property="Opacity" Value="1" />
            </Style>
            <Style Selector="Button.groupheader:pointerover, Button.groupheader:pressed">
              <Setter Property="Background" Value="Transparent" />
            </Style>
            <Style Selector="Button.groupheader:pointerover TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource TextChromeBrush}" />
            </Style>

            <Style Selector="Panel#IdleList">
              <Setter Property="RenderTransform" Value="translateY(0px)" />
              <Setter Property="Transitions">
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut" />
                  <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
                </Transitions>
              </Setter>
            </Style>
            <Style Selector="Panel#IdleList.collapsed">
              <Setter Property="Opacity" Value="0" />
              <Setter Property="RenderTransform" Value="translateY(-6px)" />
              <Setter Property="IsHitTestVisible" Value="False" />
            </Style>

            <!-- The Ctrl+number badge fades in over the row's mark while Ctrl is held. -->
            <Style Selector="Border.shortcut">
              <Setter Property="Opacity" Value="0" />
              <Setter Property="IsHitTestVisible" Value="False" />
              <Setter Property="Transitions">
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
              </Setter>
            </Style>
            <Style Selector="Border.shortcut.on">
              <Setter Property="Opacity" Value="1" />
            </Style>

            <!-- Alive / Idle: a heading with a count badge. -->
            <Style Selector="TextBlock.sectiontitle">
              <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSmall}" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
              <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style Selector="Border.sectioncount">
              <Setter Property="Background" Value="{DynamicResource BgChipBrush}" />
              <Setter Property="CornerRadius" Value="8" />
              <Setter Property="Padding" Value="6,0" />
              <Setter Property="Height" Value="16" />
              <Setter Property="MinWidth" Value="18" />
              <Setter Property="Margin" Value="7,0,0,0" />
              <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style Selector="Border.sectioncount > TextBlock">
              <Setter Property="FontSize" Value="{DynamicResource UiFontSizeTiny}" />
              <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
              <Setter Property="HorizontalAlignment" Value="Center" />
              <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
          </Grid.Styles>
          <!-- Inherited by both lists: a session row, and the Idle list's group headings. -->
          <Grid.DataTemplates>
            <!-- Right-click: move it between Alive and Idle, archive it, or delete it. -->
            <DataTemplate x:DataType="vm:SessionListItemViewModel">
              <Button Theme="{StaticResource RowButton}"
                      Classes="sessionrow"
                      Classes.selected="{Binding IsSelected}"
                      Classes.leaving="{Binding IsLeaving}"
                      Padding="10,0,8,0"
                      Click="OnRecentClick"
                      DoubleTapped="OnSessionRowDoubleTapped"
                      ToolTip.Tip="{Binding ToolTipText}"
                      ToolTip.ShowDelay="700">
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Rename" InputGesture="F2" Click="OnRenameSessionClick" />
                    <Separator />
                    <MenuItem Header="{Binding AliveToggleText}" Click="OnToggleAliveClick" IsEnabled="{Binding CanManage}" />
                    <MenuItem Header="{Binding ArchiveToggleText}" Click="OnToggleArchivedClick" IsEnabled="{Binding CanManage}" />
                    <Separator />
                    <MenuItem Header="Delete" Click="OnDeleteSessionClick" IsEnabled="{Binding CanManage}"
                              ToolTip.Tip="Moves the session's transcript to the Recycle Bin" />
                  </ContextMenu>
                </Button.ContextMenu>
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <!-- Started from the phone: it runs in the Claude app, Nomad shows it live. -->
                  <c:Icon Size="12"
                          Data="{StaticResource IconPhone}"
                          Margin="0,0,6,0"
                          VerticalAlignment="Center"
                          IsVisible="{Binding IsPhone}"
                          ToolTip.Tip="Running from the Claude app" />
                  <!-- Run by another Nomad window or a terminal: alive, but not this window's to run. -->
                  <c:Icon Size="12"
                          Data="{StaticResource IconLaptop}"
                          Margin="0,0,6,0"
                          VerticalAlignment="Center"
                          IsVisible="{Binding IsElsewhere}"
                          ToolTip.Tip="Running in another Nomad window or a terminal" />
                  <!-- A title too long for the row fades out before the marks rather than ending in "…". -->
                  <c:EdgeFade Grid.Column="1" IsVisible="{Binding !IsRenaming}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" />
                  </c:EdgeFade>
                  <!-- Rename (double-click, F2 or the context menu): the title turns editable in place, no frame;
                       Enter saves, Esc keeps the old name. -->
                  <TextBox Grid.Column="1"
                           Classes="rename"
                           Theme="{StaticResource BareTextBox}"
                           IsVisible="{Binding IsRenaming}"
                           VerticalAlignment="Center"
                           Text="{Binding RenameText}"
                           MaxLength="200"
                           LostFocus="OnRenameLostFocus" />
                  <!-- Idle (no CLI process): a sleeping moon, unless a mark has something to say. -->
                  <c:Icon Grid.Column="2"
                          Classes="sleep"
                          Size="13"
                          Data="{StaticResource IconSleep}"
                          Stroke="{DynamicResource TextMutedBrush}"
                          IsVisible="{Binding IsAsleep}"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"
                          ToolTip.Tip="Idle: no Claude Code process (it starts again with the next prompt)" />
                  <!-- Working (spinner), asking something (yellow), done and not seen yet (blue). -->
                  <c:StatusMark Grid.Column="2"
                                Margin="10,0,1,0"
                                VerticalAlignment="Center"
                                Mark="{Binding Mark}"
                                WorkingBrush="{DynamicResource AccentBrush}"
                                WaitingBrush="{DynamicResource WaitingBrush}"
                                UnreadBrush="{DynamicResource UnreadBrush}" />
                  <!-- Ctrl held: the row's Ctrl+number, over its mark. -->
                  <Border Grid.Column="2"
                          Classes="shortcut"
                          Classes.on="{Binding ShowShortcut}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          MinWidth="18" Height="18"
                          Padding="4,0"
                          CornerRadius="4"
                          Background="{DynamicResource BgChipBrush}"
                          BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1">
                    <TextBlock Text="{Binding ShortcutNumber}"
                               FontSize="{DynamicResource UiFontSizeTiny}"
                               Foreground="{DynamicResource TextChromeBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                  </Border>
                </Grid>
              </Button>
            </DataTemplate>
            <!-- A click folds the group's rows away; collapsed, it shows how many it holds. -->
            <DataTemplate x:DataType="vm:SessionGroupHeader">
              <Button Theme="{StaticResource RowButton}"
                      Classes="groupheader"
                      Classes.collapsed="{Binding IsCollapsed}"
                      Height="24"
                      Margin="8,8,11,1"
                      Padding="10,0,8,0"
                      Click="OnGroupHeaderClick">
                <Grid ColumnDefinitions="Auto,Auto,*">
                  <TextBlock Text="{Binding Title}"
                             FontSize="{DynamicResource UiFontSizeSmall}"
                             Foreground="{DynamicResource TextMutedBrush}"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                  <c:Icon Grid.Column="1"
                          Classes="sectionchev"
                          Size="11"
                          Margin="5,0,0,0"
                          Data="{StaticResource IconChevronDown}"
                          Stroke="{DynamicResource TextMutedBrush}"
                          VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2"
                             Classes="groupcount"
                             Text="{Binding Count}"
                             HorizontalAlignment="Right"
                             FontSize="{DynamicResource UiFontSizeSmall}"
                             Foreground="{DynamicResource TextMutedBrush}"
                             VerticalAlignment="Center" />
                </Grid>
              </Button>
            </DataTemplate>
          </Grid.DataTemplates>

          <!-- Title bar part over the sidebar: drags the window. -->
          <Panel Grid.Row="0" Background="Transparent" PointerPressed="OnTitleBarPointerPressed">
            <StackPanel Orientation="Horizontal" Spacing="3" Margin="12,0,0,0" VerticalAlignment="Center">
              <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Menu" Name="AppMenuButton" Foreground="{DynamicResource TextPrimaryBrush}">
                <c:Icon Data="{StaticResource IconMenu}" />
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="menu">
                    <StackPanel MinWidth="200">
                      <Button Theme="{StaticResource MenuItemButton}" Command="{Binding NewSessionCommand}" Click="OnMenuItemClick">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="New session" />
                          <TextBlock Grid.Column="1" Text="Ctrl+N" Classes="muted" FontWeight="Normal" FontSize="{DynamicResource UiFontSizeSmall}" />
                        </Grid>
                      </Button>
                      <Button Theme="{StaticResource MenuItemButton}" Command="{Binding OpenSettingsCommand}" Click="OnMenuItemClick">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="Settings" />
                          <TextBlock Grid.Column="1" Text="Ctrl+," Classes="muted" FontWeight="Normal" FontSize="{DynamicResource UiFontSizeSmall}" />
                        </Grid>
                      </Button>
                      <Border Classes="rule" />
                      <Button Theme="{StaticResource MenuItemButton}" Click="OnExitClick">
                        <TextBlock Text="Exit" />
                      </Button>
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <Button Theme="{StaticResource IconButton}" Command="{Binding ToggleSidebarCommand}" ToolTip.Tip="Hide sidebar (Ctrl+B)" Foreground="{DynamicResource TextPrimaryBrush}">
                <c:Icon Data="{StaticResource IconSidebar}" />
              </Button>
              <Button Theme="{StaticResource IconButton}" Command="{Binding GoBackCommand}" ToolTip.Tip="Back" Foreground="{DynamicResource TextPrimaryBrush}">
                <c:Icon Data="{StaticResource IconArrowLeft}" />
              </Button>
              <Button Theme="{StaticResource IconButton}" Command="{Binding GoForwardCommand}" ToolTip.Tip="Forward" Foreground="{DynamicResource TextPrimaryBrush}">
                <c:Icon Data="{StaticResource IconArrowRight}" />
              </Button>
            </StackPanel>
          </Panel>

          <!-- Search -->
          <Border Grid.Row="1"
                  Margin="10,8,14,0"
                  Height="25"
                  CornerRadius="6"
                  Background="{DynamicResource BgSearchBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*">
              <c:Icon Size="13" Data="{StaticResource IconSearch}" Stroke="{DynamicResource TextMutedBrush}" Margin="8,0,10,0" />
              <TextBox Grid.Column="1"
                       Theme="{StaticResource BareTextBox}"
                       Watermark="Search"
                       Text="{Binding SearchText}"
                       FontSize="{DynamicResource UiFontSize}"
                       Margin="0,0,8,0" />
            </Grid>
          </Border>

          <!-- New -->
          <Button Grid.Row="2"
                  Theme="{StaticResource RowButton}"
                  Classes.selected="{Binding IsNewSelected}"
                  Command="{Binding NewSessionCommand}"
                  Height="26"
                  Margin="8,9,11,0"
                  Padding="10,0"
                  FontWeight="Normal"
                  ToolTip.Tip="New session (Ctrl+N)">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:Icon Size="13" Data="{StaticResource IconPlus}" />
              <TextBlock Text="New" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <!-- Alive: sessions with a running CLI process. The heading folds the list. -->
          <Button Grid.Row="3"
                  Theme="{StaticResource RowButton}"
                  Classes="groupheader"
                  Classes.collapsed="{Binding IsAliveCollapsed}"
                  Height="24"
                  Margin="8,18,11,3"
                  Padding="10,0,8,0"
                  IsVisible="{Binding HasAlive}"
                  Command="{Binding ToggleAliveSectionCommand}"
                  ToolTip.Tip="Sessions with a running Claude Code process. Quiet for an hour, they move to Idle."
                  ToolTip.ShowDelay="700">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Alive" Classes="sectiontitle" />
              <Border Classes="sectioncount">
                <TextBlock Text="{Binding AliveCount}" />
              </Border>
              <c:Icon Classes="sectionchev" Size="11" Margin="6,0,0,0" Data="{StaticResource IconChevronDown}" Stroke="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Panel Grid.Row="4" IsVisible="{Binding HasAlive}">
            <ScrollViewer MaxHeight="240"
                          c:Fold.IsOpen="{Binding !IsAliveCollapsed}"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Alive}" />
            </ScrollViewer>
          </Panel>

          <!-- Idle header: the heading folds the list. -->
          <Grid Grid.Row="5" ColumnDefinitions="Auto,*,Auto,Auto" Margin="8,18,11,2" Height="24">
            <Button Theme="{StaticResource RowButton}"
                    Classes="groupheader"
                    Classes.collapsed="{Binding IsIdleCollapsed}"
                    Height="24"
                    Padding="10,0,8,0"
                    Command="{Binding ToggleIdleSectionCommand}"
                    ToolTip.Tip="Sessions without a process. Sending a prompt resumes one."
                    ToolTip.ShowDelay="700">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Idle" Classes="sectiontitle" />
                <Border Classes="sectioncount">
                  <TextBlock Text="{Binding IdleCount}" />
                </Border>
                <c:Icon Classes="sectionchev" Size="11" Margin="6,0,0,0" Data="{StaticResource IconChevronDown}" Stroke="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <!-- List options: grouping and archived sessions. -->
            <Button Grid.Column="2"
                    Name="ListOptionsButton"
                    Theme="{StaticResource IconButton}"
                    Width="24" Height="24"
                    ToolTip.Tip="List options">
              <c:Icon Size="13" Data="{StaticResource IconSliders}" />
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="menu">
                  <StackPanel Width="210">
                    <TextBlock Text="Group by"
                               Margin="8,3,8,3"
                               FontSize="{DynamicResource UiFontSizeSmall}"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <ItemsControl ItemsSource="{Binding GroupingOptions}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MenuOption">
                          <Button Theme="{StaticResource MenuItemButton}" Click="OnGroupingClick">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="{Binding Label}" />
                              <c:Icon Grid.Column="1" Size="13" Data="{StaticResource IconCheck}" Stroke="{DynamicResource CheckBrush}" IsVisible="{Binding IsSelected}" />
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Classes="rule" />
                    <Button Theme="{StaticResource MenuItemButton}" Click="OnShowArchivedClick">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Show archived" />
                        <Border Grid.Column="1" Classes="switch" Classes.on="{Binding ShowArchived}" VerticalAlignment="Center">
                          <Ellipse />
                        </Border>
                      </Grid>
                    </Button>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <Button Grid.Column="3"
                    Theme="{StaticResource IconButton}"
                    Width="24" Height="24"
                    Command="{Binding NewSessionCommand}"
                    ToolTip.Tip="New session">
              <c:Icon Size="13" Data="{StaticResource IconPlus}" />
            </Button>
          </Grid>

          <!-- Idle list: folded, it fades and slides up out of sight (the space below it was empty anyway). -->
          <Panel Grid.Row="6" Name="IdleList" Classes.collapsed="{Binding IsIdleCollapsed}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Recents}" Margin="0,0,0,8">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="No sessions yet"
                       Classes="muted"
                       FontSize="{DynamicResource UiFontSizeSmall}"
                       Margin="18,6,0,0"
                       IsVisible="{Binding HasNoSessions}" />
          </Panel>

          <!-- Account footer -->
          <Border Grid.Row="7"
                  Height="54"
                  BorderBrush="{DynamicResource BorderDividerBrush}"
                  BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
            <!-- The whole footer is the settings button: a rounded row 6 px inside the corner. -->
            <Button Theme="{StaticResource RowButton}"
                    Command="{Binding OpenSettingsCommand}"
                    Height="NaN"
                    Margin="6"
                    Padding="10,0,10,0"
                    CornerRadius="6"
                    ToolTip.Tip="Settings (Ctrl+,)">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
              <Border Width="22" Height="22"
                      CornerRadius="11"
                      Background="{DynamicResource BgChipBrush}"
                      VerticalAlignment="Center">
                <TextBlock Text="{Binding UserInitials}"
                           FontSize="{DynamicResource UiFontSizeTiny}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextChromeBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>
              <TextBlock Grid.Column="1"
                         Text="{Binding UserName}"
                         Margin="6,0,0,0"
                         FontWeight="Medium"
                         Foreground="{DynamicResource TextChromeBrush}"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="2"
                         IsVisible="{Binding HasPlan}"
                         Margin="5,1,0,0"
                         FontSize="{DynamicResource UiFontSizeSmall}"
                         Classes="muted"
                         VerticalAlignment="Center">
                <Run Text="·" />
                <Run Text="{Binding PlanLabel}" />
              </TextBlock>
              <c:Icon Grid.Column="4" Data="{StaticResource IconGear}" Margin="0,0,1,0" />
            </Grid>
            </Button>

            <!-- Update chip, right of the gear: it folds out when an update is found. Downloaded, a click restarts into
                 it; otherwise the click opens the prompt with the version's notes. -->
            <Button Grid.Column="1"
                    Name="UpdateChip"
                    Theme="{StaticResource ChipButton}"
                    Classes.on="{Binding Updates.ShowChip}"
                    Foreground="{DynamicResource AccentBrush}"
                    VerticalAlignment="Center"
                    ClipToBounds="True"
                    Click="OnUpdateChipClick"
                    ToolTip.Tip="{Binding Updates.ChipTip}">
              <Button.Styles>
                <Style Selector="Button#UpdateChip">
                  <Setter Property="Opacity" Value="0" />
                  <Setter Property="MaxWidth" Value="0" />
                  <Setter Property="Margin" Value="0" />
                  <Setter Property="IsHitTestVisible" Value="False" />
                </Style>
                <Style Selector="Button#UpdateChip.on">
                  <Setter Property="Opacity" Value="1" />
                  <Setter Property="MaxWidth" Value="260" />
                  <Setter Property="Margin" Value="0,0,8,0" />
                  <Setter Property="IsHitTestVisible" Value="True" />
                </Style>
              </Button.Styles>
              <Button.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut" />
                  <DoubleTransition Property="MaxWidth" Duration="0:0:0.2" Easing="CubicEaseOut" />
                  <ThicknessTransition Property="Margin" Duration="0:0:0.2" Easing="CubicEaseOut" />
                </Transitions>
              </Button.Transitions>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon Size="13" Data="{StaticResource IconUpdate}" IsVisible="{Binding Updates.ShowRestartChip}" />
                <c:Icon Size="13" Data="{StaticResource IconDownload}" IsVisible="{Binding !Updates.ShowRestartChip}" />
                <TextBlock Text="{Binding Updates.ChipText}" FontSize="{DynamicResource UiFontSize}" FontWeight="Medium" VerticalAlignment="Center" />
              </StackPanel>
              <FlyoutBase.AttachedFlyout>
                <Flyout Placement="TopEdgeAlignedLeft" FlyoutPresenterClasses="menu">
                  <StackPanel Width="400" Margin="10,8,10,6" Spacing="10">
                    <TextBlock Text="{Binding Updates.PromptTitle}" FontSize="{DynamicResource UiFontSizeLarge}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding Updates.HasAvailableNotes}">
                      <md:MarkdownView Markdown="{Binding Updates.AvailableNotes}" Margin="0,0,8,0" />
                    </ScrollViewer>
                    <TextBlock Text="{Binding Updates.Status}"
                               IsVisible="{Binding Updates.IsFailed}"
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="{DynamicResource UiFontSizeSmall}"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                      <Button Theme="{StaticResource GhostButton}" Content="Later" Click="OnUpdateLaterClick" />
                      <Button Theme="{StaticResource PrimaryButton}"
                              Content="{Binding Updates.PromptActionText}"
                              Command="{Binding Updates.InstallCommand}"
                              IsEnabled="{Binding Updates.CanAct}" />
                    </StackPanel>
                  </StackPanel>
                </Flyout>
              </FlyoutBase.AttachedFlyout>
            </Button>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- The sidebar's right edge: drag to resize it, double-click for the default width. The line sits over the
           sidebar's border. -->
      <Border Grid.Column="0"
              Name="SidebarGrip"
              Classes="resizegrip"
              Margin="0,0,-4,0"
              HorizontalAlignment="Right"
              IsVisible="{Binding IsSidebarOpen}"
              PointerPressed="OnSidebarGripPressed"
              PointerMoved="OnSidebarGripMoved"
              PointerReleased="OnSidebarGripReleased"
              PointerCaptureLost="OnGripCaptureLost">
        <Border HorizontalAlignment="Right" Margin="0,0,3,0" />
      </Border>

      <!-- ============================================================ main -->
      <Grid Grid.Column="1" RowDefinitions="36,*">
        <Grid Grid.Row="0"
              Name="TitleBar"
              ColumnDefinitions="Auto,*,Auto"
              Background="Transparent"
              PointerPressed="OnTitleBarPointerPressed">
          <!-- Sidebar collapsed: its buttons move here. -->
          <StackPanel Orientation="Horizontal" Spacing="3" Margin="12,0,0,0" VerticalAlignment="Center"
                      IsVisible="{Binding !IsSidebarOpen}">
            <Button Theme="{StaticResource IconButton}" Command="{Binding ToggleSidebarCommand}" ToolTip.Tip="Show sidebar (Ctrl+B)">
              <c:Icon Data="{StaticResource IconSidebar}" />
            </Button>
            <Button Theme="{StaticResource IconButton}" Command="{Binding NewSessionCommand}" ToolTip.Tip="New session (Ctrl+N)">
              <c:Icon Data="{StaticResource IconPlus}" />
            </Button>
          </StackPanel>

          <!-- The title (a click renames the session in place) and, for a session in a git repository, its branch
               and worktree. -->
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="2"
                      Margin="17,0,12,0"
                      VerticalAlignment="Center">
            <Button Theme="{StaticResource FlatButton}"
                    Padding="6,3"
                    MaxWidth="560"
                    IsVisible="{Binding Current.HasTitle}"
                    Click="OnTitleClick"
                    ToolTip.Tip="Rename (F2)"
                    ToolTip.ShowDelay="700">
              <Panel>
                <TextBlock Text="{Binding Current.TitleOrPlaceholder}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding !IsTitleRenaming}"
                           VerticalAlignment="Center" />
                <TextBox Name="TitleRenameBox"
                         Theme="{StaticResource BareTextBox}"
                         FontWeight="Medium"
                         MinWidth="120"
                         MaxLength="200"
                         IsVisible="{Binding IsTitleRenaming}"
                         Text="{Binding TitleRenameText}"
                         LostFocus="OnTitleRenameLostFocus" />
              </Panel>
            </Button>
            <TextBlock Text="New session"
                       Classes="muted"
                       Margin="6,0,0,0"
                       IsVisible="{Binding !Current.HasTitle}"
                       VerticalAlignment="Center" />
            <StackPanel Name="TitleBranch"
                        Orientation="Horizontal"
                        Spacing="6"
                        Margin="6,0,0,0"
                        Background="Transparent"
                        IsVisible="{Binding Current.ShowTitleGit}"
                        ToolTip.Tip="{Binding Current.GitChipToolTip}">
              <c:Icon Size="13" Data="{StaticResource IconGitBranch}" Stroke="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Current.GitBranch}"
                         Classes="muted"
                         FontSize="{DynamicResource UiFontSizeSmall}"
                         MaxWidth="220"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />
            </StackPanel>
            <Border Name="TitleWorktree"
                    Background="Transparent"
                    Margin="8,0,0,0"
                    IsVisible="{Binding Current.IsWorktreeSession}"
                    ToolTip.Tip="{Binding Current.WorktreeTitleToolTip}">
              <c:Icon Size="13" Data="{StaticResource IconWorktree}" Stroke="{DynamicResource RingBrush}" VerticalAlignment="Center" />
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button Theme="{StaticResource IconButton}"
                    Classes.on="{Binding IsSidePanelOpen}"
                    IsVisible="{Binding !Current.IsNew}"
                    Command="{Binding ToggleSidePanelCommand}"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0"
                    ToolTip.Tip="Side panel: project, context, usage, MCP servers (Ctrl+Shift+B)">
              <c:Icon Data="{StaticResource IconPanelRight}" />
            </Button>
            <Button Theme="{StaticResource CaptionButton}" Click="OnMinimizeClick" ToolTip.Tip="Minimize">
              <c:Icon Data="{StaticResource IconCaptionMin}" StrokeThickness="1" />
            </Button>
            <Button Theme="{StaticResource CaptionButton}" Click="OnMaximizeClick" ToolTip.Tip="Maximize">
              <c:Icon Name="MaximizeIcon" Data="{StaticResource IconCaptionMax}" StrokeThickness="1" />
            </Button>
            <Button Theme="{StaticResource CaptionButton}" Classes="close" Click="OnCloseClick" ToolTip.Tip="Close">
              <c:Icon Data="{StaticResource IconCaptionClose}" StrokeThickness="1" />
            </Button>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto">
          <ContentControl Content="{Binding Current}">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="vm:SessionViewModel">
                <views:SessionView />
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>

          <!-- A thin strip on the right edge toggles the side panel: "Side panel" written sideways along it, brighter
               on hover, fading out while the panel is open. -->
          <Border Grid.Column="1"
                  Name="PanelStrip"
                  Classes.open="{Binding ShowSidePanel}"
                  IsVisible="{Binding !Current.IsNew}"
                  Width="14"
                  Background="Transparent"
                  Cursor="Hand"
                  PointerPressed="OnPanelStripPressed"
                  ToolTip.Tip="Side panel (Ctrl+Shift+B)"
                  ToolTip.Placement="Left">
            <Border.Styles>
              <Style Selector="Border#PanelStrip TextBlock">
                <Setter Property="Opacity" Value="0.55" />
                <Setter Property="Transitions">
                  <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
                  </Transitions>
                </Setter>
              </Style>
              <Style Selector="Border#PanelStrip:pointerover TextBlock">
                <Setter Property="Opacity" Value="1" />
              </Style>
              <Style Selector="Border#PanelStrip.open TextBlock">
                <Setter Property="Opacity" Value="0" />
              </Style>
            </Border.Styles>
            <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
              <LayoutTransformControl.LayoutTransform>
                <RotateTransform Angle="90" />
              </LayoutTransformControl.LayoutTransform>
              <TextBlock Text="Side panel"
                         FontSize="{DynamicResource UiFontSizeTiny}"
                         Foreground="{DynamicResource TextMutedBrush}" />
            </LayoutTransformControl>
          </Border>

          <!-- The side panel slides open from the right edge; its content keeps its width while it does. -->
          <Border Grid.Column="2" Name="SidePanel" Classes="sidepanel" Classes.open="{Binding ShowSidePanel}" ClipToBounds="True">
            <Border.Styles>
              <Style Selector="Border.sidepanel">
                <Setter Property="Width" Value="0" />
                <Setter Property="Opacity" Value="0" />
                <Setter Property="IsHitTestVisible" Value="False" />
              </Style>
              <Style Selector="Border.sidepanel.open">
                <Setter Property="Width" Value="{Binding SidePanelWidth}" />
                <Setter Property="Opacity" Value="1" />
                <Setter Property="IsHitTestVisible" Value="True" />
              </Style>
            </Border.Styles>
            <Border.Transitions>
              <Transitions>
                <DoubleTransition Property="Width" Duration="0:0:0.2" Easing="CubicEaseOut" />
                <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut" />
              </Transitions>
            </Border.Transitions>
            <views:SidePanelView DataContext="{Binding Current}" Width="{Binding $parent[Window].((vm:MainViewModel)DataContext).SidePanelWidth}" HorizontalAlignment="Left" />
          </Border>

          <!-- The side panel's left edge: drag to resize it, double-click for the default width. -->
          <Border Grid.Column="2"
                  Name="SidePanelGrip"
                  Classes="resizegrip"
                  Margin="-4,0,0,0"
                  HorizontalAlignment="Left"
                  IsVisible="{Binding ShowSidePanel}"
                  PointerPressed="OnSidePanelGripPressed"
                  PointerMoved="OnSidePanelGripMoved"
                  PointerReleased="OnSidePanelGripReleased"
                  PointerCaptureLost="OnGripCaptureLost">
            <Border HorizontalAlignment="Left" Margin="3,0,0,0" />
          </Border>
        </Grid>
      </Grid>
    </Grid>


    <!-- ============================================================ settings -->
    <Panel IsVisible="{Binding IsSettingsOpen}">
      <Border Background="{DynamicResource BgOverlayBrush}" PointerPressed="OnOverlayPointerPressed" />
      <views:SettingsView Name="SettingsHost" DataContext="{Binding SettingsPage}" />
    </Panel>
  </Panel>
</Window>
