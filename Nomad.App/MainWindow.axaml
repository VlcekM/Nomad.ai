<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Nomad.App.ViewModels"
        xmlns:views="using:Nomad.App.Views"
        xmlns:c="using:Nomad.App.Controls"
        x:Class="Nomad.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Nomad.ai"
        Icon="/Assets/nomad.ico"
        Width="1400" Height="900"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="36"
        Background="{StaticResource BgMainBrush}">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewSessionCommand}" />
    <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleSidebarCommand}" />
    <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}" />
  </Window.KeyBindings>

  <Panel>
    <Grid ColumnDefinitions="Auto,*">

      <!-- ============================================================ sidebar -->
      <Border Grid.Column="0"
              Width="375"
              IsVisible="{Binding IsSidebarOpen}"
              Background="{StaticResource BgSidebarBrush}"
              BorderBrush="{StaticResource BorderDividerBrush}"
              BorderThickness="0,0,1,0">
        <Grid RowDefinitions="36,Auto,Auto,Auto,*,Auto">

          <!-- Title bar part over the sidebar: drags the window. -->
          <Panel Grid.Row="0" Background="Transparent" PointerPressed="OnTitleBarPointerPressed">
            <StackPanel Orientation="Horizontal" Spacing="3" Margin="12,0,0,0" VerticalAlignment="Center">
              <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Menu" Name="AppMenuButton" Foreground="{StaticResource TextPrimaryBrush}">
                <c:Icon Data="{StaticResource IconMenu}" />
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="menu">
                    <StackPanel MinWidth="200">
                      <Button Theme="{StaticResource MenuItemButton}" Command="{Binding NewSessionCommand}" Click="OnMenuItemClick">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="New session" />
                          <TextBlock Grid.Column="1" Text="Ctrl+N" Classes="muted" FontWeight="Normal" FontSize="13" />
                        </Grid>
                      </Button>
                      <Button Theme="{StaticResource MenuItemButton}" Command="{Binding OpenSettingsCommand}" Click="OnMenuItemClick">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="Settings" />
                          <TextBlock Grid.Column="1" Text="Ctrl+," Classes="muted" FontWeight="Normal" FontSize="13" />
                        </Grid>
                      </Button>
                      <Border Classes="rule" />
                      <Button Theme="{StaticResource MenuItemButton}" Click="OnExitClick">
                        <TextBlock Text="Exit" />
                      </Button>
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <Button Theme="{StaticResource IconButton}" Command="{Binding ToggleSidebarCommand}" ToolTip.Tip="Hide sidebar (Ctrl+B)" Foreground="{StaticResource TextPrimaryBrush}">
                <c:Icon Data="{StaticResource IconSidebar}" />
              </Button>
              <Button Theme="{StaticResource IconButton}" Command="{Binding GoBackCommand}" ToolTip.Tip="Back" Foreground="{StaticResource TextPrimaryBrush}">
                <c:Icon Data="{StaticResource IconArrowLeft}" />
              </Button>
              <Button Theme="{StaticResource IconButton}" Command="{Binding GoForwardCommand}" ToolTip.Tip="Forward" Foreground="{StaticResource TextPrimaryBrush}">
                <c:Icon Data="{StaticResource IconArrowRight}" />
              </Button>
            </StackPanel>
          </Panel>

          <!-- Search -->
          <Border Grid.Row="1"
                  Margin="10,8,14,0"
                  Height="25"
                  CornerRadius="6"
                  Background="{StaticResource BgSearchBrush}"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*">
              <c:Icon Size="13" Data="{StaticResource IconSearch}" Stroke="{StaticResource TextMutedBrush}" Margin="8,0,10,0" />
              <TextBox Grid.Column="1"
                       Theme="{StaticResource BareTextBox}"
                       Watermark="Search"
                       Text="{Binding SearchText}"
                       FontSize="14"
                       Margin="0,0,8,0" />
            </Grid>
          </Border>

          <!-- New -->
          <Button Grid.Row="2"
                  Theme="{StaticResource RowButton}"
                  Classes.selected="{Binding IsNewSelected}"
                  Command="{Binding NewSessionCommand}"
                  Height="26"
                  Margin="8,9,11,0"
                  Padding="10,0"
                  FontWeight="Normal"
                  ToolTip.Tip="New session (Ctrl+N)">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:Icon Size="13" Data="{StaticResource IconPlus}" />
              <TextBlock Text="New" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <!-- Recents header -->
          <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="18,18,11,2" Height="24">
            <TextBlock Text="Recents" Classes="section" VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Theme="{StaticResource IconButton}"
                    Width="24" Height="24"
                    Command="{Binding NewSessionCommand}"
                    ToolTip.Tip="New session">
              <c:Icon Size="13" Data="{StaticResource IconPlus}" />
            </Button>
          </Grid>

          <!-- Recents list -->
          <Panel Grid.Row="4">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Recents}" Margin="0,0,0,8">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SessionListItemViewModel">
                    <Button Theme="{StaticResource RowButton}"
                            Classes.selected="{Binding IsSelected}"
                            Height="26"
                            Margin="8,2,11,2"
                            Padding="10,0,8,0"
                            Click="OnRecentClick"
                            ToolTip.Tip="{Binding ToolTipText}"
                            ToolTip.ShowDelay="700">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Title}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <Ellipse Grid.Column="1"
                                 Width="6" Height="6"
                                 Margin="10,0,4,0"
                                 Fill="{StaticResource AccentBrush}"
                                 IsVisible="{Binding IsRunning}"
                                 VerticalAlignment="Center" />
                        <Ellipse Grid.Column="1"
                                 Width="6" Height="6"
                                 Margin="10,0,4,0"
                                 Fill="{StaticResource UnreadBrush}"
                                 IsVisible="{Binding ShowUnread}"
                                 VerticalAlignment="Center" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="No sessions yet"
                       Classes="muted"
                       FontSize="13"
                       Margin="18,6,0,0"
                       IsVisible="{Binding HasNoSessions}" />
          </Panel>

          <!-- Account footer -->
          <Border Grid.Row="5"
                  Height="44"
                  BorderBrush="{StaticResource BorderDividerBrush}"
                  BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="11,0,9,0">
              <Border Width="22" Height="22"
                      CornerRadius="11"
                      Background="#282828"
                      VerticalAlignment="Center">
                <TextBlock Text="{Binding UserInitials}"
                           FontSize="9.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextChromeBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>
              <TextBlock Grid.Column="1"
                         Text="{Binding UserName}"
                         Margin="6,0,0,0"
                         FontWeight="Medium"
                         Foreground="{StaticResource TextChromeBrush}"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="2"
                         IsVisible="{Binding HasPlan}"
                         Margin="5,1,0,0"
                         FontSize="12.5"
                         Classes="muted"
                         VerticalAlignment="Center">
                <Run Text="·" />
                <Run Text="{Binding PlanLabel}" />
              </TextBlock>
              <Button Grid.Column="4"
                      Theme="{StaticResource IconButton}"
                      Command="{Binding OpenSettingsCommand}"
                      ToolTip.Tip="Settings (Ctrl+,)">
                <c:Icon Data="{StaticResource IconGear}" />
              </Button>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- ============================================================ main -->
      <Grid Grid.Column="1" RowDefinitions="36,*">
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              Background="Transparent"
              PointerPressed="OnTitleBarPointerPressed">
          <!-- Sidebar collapsed: its buttons move here. -->
          <StackPanel Orientation="Horizontal" Spacing="3" Margin="12,0,0,0" VerticalAlignment="Center"
                      IsVisible="{Binding !IsSidebarOpen}">
            <Button Theme="{StaticResource IconButton}" Command="{Binding ToggleSidebarCommand}" ToolTip.Tip="Show sidebar (Ctrl+B)">
              <c:Icon Data="{StaticResource IconSidebar}" />
            </Button>
            <Button Theme="{StaticResource IconButton}" Command="{Binding NewSessionCommand}" ToolTip.Tip="New session (Ctrl+N)">
              <c:Icon Data="{StaticResource IconPlus}" />
            </Button>
          </StackPanel>

          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="4"
                      Margin="23,0,12,0"
                      VerticalAlignment="Center">
            <TextBlock Text="{Binding Current.TitleOrPlaceholder}"
                       FontWeight="Medium"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding Current.HasTitle}"
                       VerticalAlignment="Center" />
            <TextBlock Text="New session"
                       Classes="muted"
                       IsVisible="{Binding !Current.HasTitle}"
                       VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button Theme="{StaticResource CaptionButton}" Click="OnMinimizeClick" ToolTip.Tip="Minimize">
              <c:Icon Data="{StaticResource IconCaptionMin}" StrokeThickness="1" />
            </Button>
            <Button Theme="{StaticResource CaptionButton}" Click="OnMaximizeClick" ToolTip.Tip="Maximize">
              <c:Icon Name="MaximizeIcon" Data="{StaticResource IconCaptionMax}" StrokeThickness="1" />
            </Button>
            <Button Theme="{StaticResource CaptionButton}" Classes="close" Click="OnCloseClick" ToolTip.Tip="Close">
              <c:Icon Data="{StaticResource IconCaptionClose}" StrokeThickness="1" />
            </Button>
          </StackPanel>
        </Grid>

        <ContentControl Grid.Row="1" Content="{Binding Current}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:SessionViewModel">
              <views:SessionView />
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </Grid>
    </Grid>


    <!-- ============================================================ settings -->
    <Panel IsVisible="{Binding IsSettingsOpen}">
      <Border Background="{StaticResource BgOverlayBrush}" PointerPressed="OnOverlayPointerPressed" />
      <views:SettingsView Name="SettingsHost" DataContext="{Binding SettingsPage}" />
    </Panel>
  </Panel>
</Window>
