<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nomad.App.ViewModels"
             xmlns:views="using:Nomad.App.Views"
             xmlns:ide="using:Nomad.App.Ide"
             xmlns:c="using:Nomad.App.Controls"
             x:Class="Nomad.App.Views.FilesView"
             x:DataType="vm:SessionViewModel">

  <!-- A chat's Files view (the title bar's switch), laid out like Visual Studio: the open files in tabs over a card
       (one group, or two side by side), and the folder's tree beside them on the window's own background (right by
       default, a setting swaps the sides). The tree's inner edge drags its width. -->
  <UserControl.Styles>
    <!-- A toolbar button: muted, brighter on hover; a toggle that is on keeps a filled backdrop. -->
    <Style Selector="Button.treetool">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut" />
          <BrushTransition Property="Foreground" Duration="0:0:0.15" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.treetool:pointerover, Button.treetool.on">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.treetool.on">
      <Setter Property="Background" Value="{DynamicResource BgSelectedBrush}" />
    </Style>
    <Style Selector="Button.treetool.on:pointerover">
      <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
    </Style>

    <!-- The code search (Ctrl+T): fades in and drops a little into place, and back out. -->
    <Style Selector="Panel#CodeSearch">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Panel#CodeSearch.raised">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="Border#CodeSearchCard">
      <Setter Property="RenderTransform" Value="translateY(-6px)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Panel#CodeSearch.raised Border#CodeSearchCard">
      <Setter Property="RenderTransform" Value="translateY(0px)" />
    </Style>
    <!-- The question card (new file, rename, delete, commit): fades in and drops a little into place, like the search. -->
    <Style Selector="Panel#Prompt">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Panel#Prompt.raised">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="Border#PromptCard">
      <Setter Property="RenderTransform" Value="translateY(-6px)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Panel#Prompt.raised Border#PromptCard">
      <Setter Property="RenderTransform" Value="translateY(0px)" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.danger:pointerover">
      <Setter Property="Opacity" Value="0.88" />
    </Style>
    <Style Selector="Button.coderow">
      <Setter Property="Height" Value="26" />
      <Setter Property="Margin" Value="4,0" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Run.match">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Run.type">
      <Setter Property="Foreground" Value="{DynamicResource CodeTypeBrush}" />
    </Style>
    <Style Selector="Run.muted">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid Name="Layout" ColumnDefinitions="Auto,*,Auto">

    <ItemsControl Name="Documents" Grid.Column="1" ItemsSource="{Binding Files.Groups}" Margin="8,6,4,12">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:EditorGroup">
          <views:EditorGroupView Margin="4,0" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- The tree: no card, as Visual Studio's Solution Explorer. -->
    <DockPanel Name="TreePane"
               Grid.Column="2"
               Width="{Binding $parent[Window].((vm:MainViewModel)DataContext).FileTreeWidth}"
               Margin="0,8,8,12">
      <!-- The toolbar, as Solution Explorer's: a raised strip with the folder's name, and its buttons on the right. -->
      <Border DockPanel.Dock="Top"
              Background="{DynamicResource BgRaisedBrush}"
              BorderBrush="{DynamicResource BorderCardBrush}"
              BorderThickness="1"
              CornerRadius="7"
              Margin="0,0,0,6"
              Padding="10,2,2,2">
      <Grid ColumnDefinitions="*,Auto" Height="28">
        <TextBlock Text="{Binding FolderName}"
                   ToolTip.Tip="{Binding Folder}"
                   Foreground="{DynamicResource TextChromeBrush}"
                   FontSize="{DynamicResource UiFontSizeSmall}"
                   FontWeight="Medium"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
          <Button Theme="{StaticResource IconButton}"
                  Classes="treetool"
                  IsVisible="{Binding Files.CanOpenInVisualStudio}"
                  Command="{Binding Files.OpenInVisualStudioCommand}"
                  ToolTip.Tip="Open in Visual Studio">
            <c:Icon Size="14" IsFilled="True" Stroke="#9B7BDA" Data="{StaticResource IconVisualStudio}" />
          </Button>
          <Border Width="1" Height="14" Margin="3,0" Background="{DynamicResource BorderBrush}" IsVisible="{Binding Files.CanOpenInVisualStudio}" />
          <Button Theme="{StaticResource IconButton}"
                  Classes="treetool"
                  Command="{Binding Files.SyncWithActiveCommand}"
                  ToolTip.Tip="Sync with active document">
            <c:Icon Size="14" Data="{StaticResource IconSync}" />
          </Button>
          <Button Theme="{StaticResource IconButton}"
                  Classes="treetool"
                  Command="{Binding Files.CollapseAllCommand}"
                  ToolTip.Tip="Collapse all">
            <c:Icon Size="14" Data="{StaticResource IconCollapseAll}" />
          </Button>
          <!-- Show All Files: build output (bin, obj), dot folders and per-user files too. -->
          <Button Name="ShowAllButton"
                  Theme="{StaticResource IconButton}"
                  Classes="treetool"
                  Classes.on="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowAllFiles}"
                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleShowAllFilesCommand}"
                  ToolTip.Tip="Show all files">
            <c:Icon Size="14" Data="{StaticResource IconFiles}" />
          </Button>
        </StackPanel>
      </Grid>
      </Border>
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ide:FileTreeView Name="Tree"
                          Tree="{Binding Files.Tree}"
                          ShowAll="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowAllFiles}"
                          TextElement.FontSize="{DynamicResource UiFontSizeSmall}"
                          TextElement.FontFamily="{DynamicResource UiFont}" />
      </ScrollViewer>
    </DockPanel>

    <!-- The tree's inner edge: drag to resize it, double-click for the default width. -->
    <Border Name="TreeGrip"
            Grid.Column="2"
            Classes="resizegrip"
            Margin="-4,8,0,12"
            HorizontalAlignment="Left"
            PointerPressed="OnGripPressed"
            PointerMoved="OnGripMoved"
            PointerReleased="OnGripReleased"
            PointerCaptureLost="OnGripCaptureLost">
      <Border Name="TreeGripLine" HorizontalAlignment="Left" Margin="3,0,0,0" />
    </Border>

    <!-- The code search (Ctrl+T), as Visual Studio's Go To All: a box over the open files with the matches under it.
         A click anywhere else closes it. -->
    <Border Grid.ColumnSpan="3"
            Background="Transparent"
            IsVisible="{Binding Files.CodeSearch.IsOpen}"
            PointerPressed="OnCodeSearchOutsidePressed" />
    <Panel Name="CodeSearch"
           Grid.Column="1"
           IsVisible="{Binding Files.CodeSearch.IsShown}"
           Classes.raised="{Binding Files.CodeSearch.IsRaised}">
      <Border Name="CodeSearchCard"
              MaxWidth="860"
              Margin="20,4,20,24"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Top"
              CornerRadius="9"
              ClipToBounds="True"
              Background="{DynamicResource BgMenuBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              BoxShadow="0 12 36 0 #59000000">
        <Grid RowDefinitions="Auto,Auto,*">
          <Grid ColumnDefinitions="Auto,*,Auto" Height="40">
            <c:Icon Size="14" Data="{StaticResource IconSearch}" Stroke="{DynamicResource TextMutedBrush}" Margin="14,0,10,0" />
            <TextBox Grid.Column="1"
                     Name="CodeSearchBox"
                     Theme="{StaticResource BareTextBox}"
                     Watermark="Go to type, member or file"
                     Text="{Binding Files.CodeSearch.Query}"
                     VerticalAlignment="Center" />
            <TextBlock Grid.Column="2"
                       Text="{Binding Files.CodeSearch.Status}"
                       Classes="muted"
                       FontSize="{DynamicResource UiFontSizeSmall}"
                       VerticalAlignment="Center"
                       Margin="12,0,14,0" />
          </Grid>
          <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderDividerBrush}" IsVisible="{Binding Files.CodeSearch.HasResults}" />
          <ScrollViewer Grid.Row="2"
                        Name="CodeSearchScroll"
                        MaxHeight="468"
                        HorizontalScrollBarVisibility="Disabled"
                        IsVisible="{Binding Files.CodeSearch.HasResults}">
            <ItemsControl Name="CodeSearchList" ItemsSource="{Binding Files.CodeSearch.Results}" Margin="0,4">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CodeSearchResult">
                  <Button Theme="{StaticResource RowButton}"
                          Classes="coderow"
                          Classes.selected="{Binding IsSelected}"
                          Focusable="False"
                          Click="OnCodeSearchResultClick"
                          ToolTip.Tip="{Binding ToolTipText}"
                          ToolTip.ShowDelay="900">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <ide:CodeSymbolIcon Kind="{Binding Symbol.Kind}" Width="16" Height="16" Margin="0,0,8,0" TextElement.Foreground="{DynamicResource TextSecondaryBrush}" />
                      <ide:CodeSearchText Grid.Column="1"
                                          Result="{Binding}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          FontWeight="Normal"
                                          TextTrimming="CharacterEllipsis"
                                          VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2"
                                 Text="{Binding Project}"
                                 Classes="muted"
                                 FontWeight="Normal"
                                 FontSize="{DynamicResource UiFontSizeSmall}"
                                 Margin="16,0,2,0"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Panel>

    <!-- The question card: a name, a commit message or a yes, for what the tree's menu does. Enter answers, Esc or a
         click elsewhere cancels. -->
    <Border Grid.ColumnSpan="3"
            Background="Transparent"
            IsVisible="{Binding Files.Prompt.IsOpen}"
            PointerPressed="OnPromptOutsidePressed" />
    <Panel Name="Prompt"
           Grid.ColumnSpan="3"
           IsVisible="{Binding Files.Prompt.IsShown}"
           Classes.raised="{Binding Files.Prompt.IsRaised}"
           KeyDown="OnPromptKeyDown">
      <Border Name="PromptCard"
              Width="420"
              Margin="0,56,0,0"
              Padding="18,16"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              CornerRadius="9"
              Background="{DynamicResource BgMenuBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              BoxShadow="0 12 36 0 #59000000">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding Files.Prompt.Title}"
                     FontWeight="Medium"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Files.Prompt.Message}"
                     IsVisible="{Binding Files.Prompt.HasMessage}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     FontSize="{DynamicResource UiFontSizeSmall}"
                     TextWrapping="Wrap" />
          <TextBox Name="PromptBox"
                   IsVisible="{Binding Files.Prompt.HasInput}"
                   Text="{Binding Files.Prompt.Text}"
                   Watermark="{Binding Files.Prompt.Watermark}" />
          <TextBlock Text="{Binding Files.Prompt.Error}"
                     IsVisible="{Binding Files.Prompt.HasError}"
                     Foreground="{DynamicResource DangerBrush}"
                     FontSize="{DynamicResource UiFontSizeSmall}"
                     TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Theme="{StaticResource GhostButton}" Content="Cancel" Command="{Binding Files.Prompt.CancelCommand}" ToolTip.Tip="Esc" />
            <Button Name="PromptConfirm"
                    Theme="{StaticResource PrimaryButton}"
                    Classes.danger="{Binding Files.Prompt.IsDanger}"
                    Content="{Binding Files.Prompt.ConfirmText}"
                    Command="{Binding Files.Prompt.ConfirmCommand}"
                    ToolTip.Tip="Enter" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Panel>
  </Grid>
</UserControl>
