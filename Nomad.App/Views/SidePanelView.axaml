<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nomad.App.ViewModels"
             xmlns:c="using:Nomad.App.Controls"
             x:Class="Nomad.App.Views.SidePanelView"
             x:DataType="vm:SessionViewModel">

  <!-- The right-hand panel (Ctrl+Shift+B): cards for the project, the context window, plan usage and MCP servers.
       Each card's header folds it away; which ones are folded is remembered. -->
  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource BgSidebarBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderCardBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,6,12,10" />
    </Style>
    <Style Selector="Button.cardheader">
      <Setter Property="Foreground" Value="{DynamicResource TextChromeBrush}" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="Button.cardheader TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSmall}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="c|Icon.fold">
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="c|Icon.fold.closed">
      <Setter Property="RenderTransform" Value="rotate(-90deg)" />
    </Style>
    <Style Selector="Ellipse.dot">
      <Setter Property="Width" Value="6" />
      <Setter Property="Height" Value="6" />
      <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Ellipse.dot.ok">
      <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Ellipse.dot.failed">
      <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Ellipse.dot.waiting">
      <Setter Property="Fill" Value="{DynamicResource WaitingBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="TextBlock.changes">
      <Setter Property="Foreground" Value="{DynamicResource WaitingBrush}" />
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource BgMainBrush}">
    <Grid RowDefinitions="*,Auto">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="4,4,12,12" Spacing="8">

        <!-- ============================================================ project -->
        <Border Classes="card">
          <StackPanel>
            <Button Theme="{StaticResource LineButton}" Classes="cardheader" Tag="Project" Click="OnHeaderClick">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Project" />
                <c:Icon Classes="fold" Size="12" Data="{StaticResource IconChevronDown}" />
              </StackPanel>
            </Button>
            <Panel>
              <StackPanel Spacing="8" IsVisible="{Binding HasProject}" Margin="0,4,0,0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <c:Icon Size="14" Data="{StaticResource IconFolder}" Stroke="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Project.Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" Margin="8,0,8,0" VerticalAlignment="Center" />
                  <Border Grid.Column="2" IsVisible="{Binding Project.HasBranch}" Background="{DynamicResource BgChipBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center" ToolTip.Tip="Branch">
                    <TextBlock Text="{Binding Project.Branch}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource UiFontSizeTiny}" Foreground="{DynamicResource TextChromeBrush}" MaxWidth="120" TextTrimming="CharacterEllipsis" />
                  </Border>
                </Grid>
                <TextBlock Text="{Binding Project.Path}" Classes="muted" FontSize="{DynamicResource UiFontSizeTiny}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Project.Path}" Margin="0,-4,0,0" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Project.StatusText}" Classes="muted" Classes.changes="{Binding Project.HasChanges}" FontSize="{DynamicResource UiFontSizeSmall}" VerticalAlignment="Center" />
                  <TextBlock Text="Not a git repository" IsVisible="{Binding Project.IsNotGit}" Classes="muted" FontSize="{DynamicResource UiFontSizeSmall}" VerticalAlignment="Center" />
                  <!-- Open the folder elsewhere. -->
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                    <Button Theme="{StaticResource IconButton}" Width="24" Height="24" Click="OnExplorerClick" ToolTip.Tip="Open in File Explorer">
                      <c:Icon Size="13" Data="{StaticResource IconFolderOpen}" />
                    </Button>
                    <Button Theme="{StaticResource IconButton}" Width="24" Height="24" Click="OnTerminalClick" ToolTip.Tip="Open a terminal here">
                      <c:Icon Size="13" Data="{StaticResource IconTerminal}" />
                    </Button>
                    <Button Theme="{StaticResource IconButton}" Width="24" Height="24" Click="OnCopyPathClick" ToolTip.Tip="Copy the path">
                      <c:Icon Size="13" Data="{StaticResource IconCopy}" />
                    </Button>
                  </StackPanel>
                </Grid>
                <c:Skeleton IsActive="{Binding !Project.IsLoaded}" Rows="3" RowHeight="8" RowSpacing="11" Widths="0.8,0.62,0.72" Fill="{DynamicResource SkeletonBrush}" />
                <ItemsControl ItemsSource="{Binding Project.Commits}" IsVisible="{Binding Project.HasCommits}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="3" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CommitRow">
                      <Grid ColumnDefinitions="*,Auto" Background="Transparent" ToolTip.Tip="{Binding ToolTip}">
                        <TextBlock Text="{Binding Subject}" FontSize="{DynamicResource UiFontSizeSmall}" Foreground="{DynamicResource TextChromeBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding WhenText}" Classes="muted" FontSize="{DynamicResource UiFontSizeTiny}" Margin="8,0,0,0" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <TextBlock Text="No folder: Claude works in a new scratch folder."
                         IsVisible="{Binding !HasProject}"
                         Classes="muted"
                         TextWrapping="Wrap"
                         FontSize="{DynamicResource UiFontSizeSmall}"
                         Margin="0,4,0,0" />
            </Panel>
          </StackPanel>
        </Border>

        <!-- ============================================================ subagents -->
        <Panel IsVisible="{Binding HasSubagents}">
        <Border Classes="card">
          <StackPanel>
            <Button Theme="{StaticResource LineButton}" Classes="cardheader" Tag="Subagents" Click="OnHeaderClick">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Subagents" />
                <c:Icon Classes="fold" Size="12" Data="{StaticResource IconChevronDown}" />
              </StackPanel>
            </Button>
            <ItemsControl ItemsSource="{Binding Subagents}" Margin="-6,2,-6,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SubagentViewModel">
                  <!-- A click opens its conversation over the transcript. -->
                  <Button Theme="{StaticResource FlatButton}"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          Padding="6,5"
                          Click="OnSubagentClick"
                          ToolTip.Tip="Open its conversation">
                    <!-- Its task; then the model it runs on, opposite how long it has run; then what it is doing. -->
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
                      <Panel Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0">
                        <c:Ring Width="12" Height="12" StrokeWidth="1.5"
                                IsSpinning="{Binding IsRunning}" IsVisible="{Binding IsRunning}"
                                TrackBrush="{DynamicResource RingTrackBrush}" SpinBrush="{DynamicResource AccentBrush}" />
                        <c:Icon Size="13" Data="{StaticResource IconCheck}" Stroke="{DynamicResource SuccessBrush}" IsVisible="{Binding IsDone}" />
                        <c:Icon Size="13" Data="{StaticResource IconClose}" Stroke="{DynamicResource DangerBrush}" IsVisible="{Binding IsFailed}" />
                      </Panel>
                      <c:EdgeFade Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextPrimaryBrush}" />
                      </c:EdgeFade>
                      <Border Grid.Row="1" Grid.Column="1" IsVisible="{Binding HasChip}" HorizontalAlignment="Left"
                              Background="{DynamicResource BgChipBrush}" CornerRadius="4" Padding="5,0" Margin="0,3,0,0" VerticalAlignment="Center"
                              ToolTip.Tip="{Binding AgentType}">
                        <TextBlock Text="{Binding ChipText}" FontSize="{DynamicResource UiFontSizeTiny}" Foreground="{DynamicResource TextChromeBrush}" />
                      </Border>
                      <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding DurationText}" Classes="muted" FontSize="{DynamicResource UiFontSizeSmall}"
                                 VerticalAlignment="Center" Margin="8,3,0,0" />
                      <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding LastStatus}" Classes="muted" FontSize="{DynamicResource UiFontSizeSmall}"
                                 TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        </Panel>

        <!-- ============================================================ background tasks -->
        <Panel IsVisible="{Binding HasBackgroundTasks}">
        <Border Classes="card">
          <StackPanel>
            <Button Theme="{StaticResource LineButton}" Classes="cardheader" Tag="Tasks" Click="OnHeaderClick">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Background tasks" />
                <c:Icon Classes="fold" Size="12" Data="{StaticResource IconChevronDown}" />
              </StackPanel>
            </Button>
            <ItemsControl ItemsSource="{Binding BackgroundTasks}" Margin="0,2,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BackgroundTaskViewModel">
                  <!-- What it runs; then its tool, opposite how long it has run; then how it ended. -->
                  <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" Margin="0,5" Background="Transparent" ToolTip.Tip="{Binding Command}">
                    <Panel Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0">
                      <c:Ring Width="12" Height="12" StrokeWidth="1.5"
                              IsSpinning="{Binding IsRunning}" IsVisible="{Binding IsRunning}"
                              TrackBrush="{DynamicResource RingTrackBrush}" SpinBrush="{DynamicResource AccentBrush}" />
                      <c:Icon Size="13" Data="{StaticResource IconCheck}" Stroke="{DynamicResource SuccessBrush}" IsVisible="{Binding IsDone}" />
                      <c:Icon Size="13" Data="{StaticResource IconClose}" Stroke="{DynamicResource DangerBrush}" IsVisible="{Binding IsFailed}" />
                    </Panel>
                    <c:EdgeFade Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </c:EdgeFade>
                    <Border Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left"
                            Background="{DynamicResource BgChipBrush}" CornerRadius="4" Padding="5,0" Margin="0,3,0,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding ToolName}" FontSize="{DynamicResource UiFontSizeTiny}" Foreground="{DynamicResource TextChromeBrush}" />
                    </Border>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding DurationText}" Classes="muted" FontSize="{DynamicResource UiFontSizeSmall}"
                               VerticalAlignment="Center" Margin="8,3,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding LastStatus}" Classes="muted" FontSize="{DynamicResource UiFontSizeSmall}"
                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        </Panel>

        <!-- ============================================================ context -->
        <Border Classes="card">
          <StackPanel>
            <Button Theme="{StaticResource LineButton}" Classes="cardheader" Tag="Context" Click="OnHeaderClick">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Context" />
                <c:Icon Classes="fold" Size="12" Data="{StaticResource IconChevronDown}" />
              </StackPanel>
            </Button>
            <StackPanel Spacing="6" Margin="0,4,0,0">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding ContextPercentText}" FontWeight="Medium" FontSize="{DynamicResource UiFontSizeSmall}" />
                <TextBlock Grid.Column="1" Text="{Binding ContextAmountText}" Classes="muted" FontSize="{DynamicResource UiFontSizeTiny}" VerticalAlignment="Center" />
              </Grid>
              <c:FillSlider Height="5" Thickness="5"
                            Maximum="1"
                            Value="{Binding ContextFraction}"
                            IsHitTestVisible="False"
                            TrackBrush="{DynamicResource BarTrackBrush}"
                            FillBrush="{DynamicResource RingBrush}" />
              <TextBlock Text="{Binding AgentMeta}"
                         IsVisible="{Binding HasRun}"
                         Classes="muted"
                         TextWrapping="Wrap"
                         FontSize="{DynamicResource UiFontSizeTiny}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- ============================================================ plan usage -->
        <Border Classes="card usage">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto">
              <Button Theme="{StaticResource LineButton}" Classes="cardheader" Tag="Usage" Click="OnHeaderClick">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="Plan usage" />
                  <c:Icon Classes="fold" Size="12" Data="{StaticResource IconChevronDown}" />
                </StackPanel>
              </Button>
              <Button Grid.Column="1" Theme="{StaticResource LineButton}" Click="OnUsagePageClick" ToolTip.Tip="Usage on claude.ai">
                <c:Icon Size="12" Data="{StaticResource IconArrowRight}" />
              </Button>
            </Grid>
            <StackPanel Margin="0,4,0,0">
              <c:Skeleton IsActive="{Binding Usage.IsLoading}" Rows="3" RowHeight="8" RowSpacing="16" Widths="0.9,0.7,0.8" Fill="{DynamicResource SkeletonBrush}" />
              <ItemsControl ItemsSource="{Binding Usage.Rows}" IsVisible="{Binding Usage.HasUsage}" ItemTemplate="{StaticResource UsageRowTemplate}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="11" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
              <TextBlock Text="Plan usage needs a claude.ai sign-in in Claude Code."
                         Classes="muted"
                         TextWrapping="Wrap"
                         FontSize="{DynamicResource UiFontSizeSmall}"
                         IsVisible="{Binding Usage.IsUnavailable}" />
              <ContentControl Content="{Binding Usage}"
                              ContentTemplate="{StaticResource UsageStaleTemplate}"
                              Margin="0,8,0,0"
                              IsVisible="{Binding Usage.IsStale}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- ============================================================ MCP servers -->
        <Border Classes="card">
          <StackPanel>
            <Button Theme="{StaticResource LineButton}" Classes="cardheader" Tag="Mcp" Click="OnHeaderClick">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="MCP servers" />
                <c:Icon Classes="fold" Size="12" Data="{StaticResource IconChevronDown}" />
              </StackPanel>
            </Button>
            <Panel Margin="0,4,0,0">
              <ItemsControl ItemsSource="{Binding Connectors}" IsVisible="{Binding HasConnectors}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ConnectorRow">
                    <Grid ColumnDefinitions="Auto,*" Height="24" Background="Transparent" ToolTip.Tip="{Binding StatusText}">
                      <Ellipse Classes="dot"
                               Classes.ok="{Binding IsConnected}"
                               Classes.failed="{Binding IsFailed}"
                               Classes.waiting="{Binding IsWaiting}"
                               VerticalAlignment="Center"
                               Margin="1,0,9,0" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="{DynamicResource UiFontSizeSmall}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <c:Skeleton IsActive="{Binding IsLoadingConnectors}" Rows="2" RowHeight="8" RowSpacing="16" Widths="0.55,0.4"
                          Fill="{DynamicResource SkeletonBrush}" Margin="0,8,0,0" VerticalAlignment="Top" />
              <TextBlock Text="None configured for this folder."
                         IsVisible="{Binding ShowNoConnectors}"
                         Classes="muted"
                         FontSize="{DynamicResource UiFontSizeSmall}" />
            </Panel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Bottom right: which cards the panel shows at all. -->
    <Button Grid.Row="1"
            Name="CardsButton"
            Theme="{StaticResource IconButton}"
            Width="26" Height="26"
            HorizontalAlignment="Right"
            Margin="0,0,10,8"
            ToolTip.Tip="Cards">
      <c:Icon Size="13" Data="{StaticResource IconSliders}" />
      <Button.Flyout>
        <Flyout Placement="TopEdgeAlignedRight" FlyoutPresenterClasses="menu" Opening="OnCardsMenuOpening">
          <StackPanel Name="CardsMenu" Width="200">
            <TextBlock Text="Show cards" Margin="8,3,8,3" FontSize="{DynamicResource UiFontSizeSmall}" Foreground="{DynamicResource TextMutedBrush}" />
            <Button Theme="{StaticResource MenuItemButton}" Tag="Project" Click="OnCardToggleClick">
              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Project" /><Border Grid.Column="1" Classes="switch" VerticalAlignment="Center"><Ellipse /></Border></Grid>
            </Button>
            <Button Theme="{StaticResource MenuItemButton}" Tag="Subagents" Click="OnCardToggleClick">
              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Subagents" /><Border Grid.Column="1" Classes="switch" VerticalAlignment="Center"><Ellipse /></Border></Grid>
            </Button>
            <Button Theme="{StaticResource MenuItemButton}" Tag="Tasks" Click="OnCardToggleClick">
              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Background tasks" /><Border Grid.Column="1" Classes="switch" VerticalAlignment="Center"><Ellipse /></Border></Grid>
            </Button>
            <Button Theme="{StaticResource MenuItemButton}" Tag="Context" Click="OnCardToggleClick">
              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Context" /><Border Grid.Column="1" Classes="switch" VerticalAlignment="Center"><Ellipse /></Border></Grid>
            </Button>
            <Button Theme="{StaticResource MenuItemButton}" Tag="Usage" Click="OnCardToggleClick">
              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Plan usage" /><Border Grid.Column="1" Classes="switch" VerticalAlignment="Center"><Ellipse /></Border></Grid>
            </Button>
            <Button Theme="{StaticResource MenuItemButton}" Tag="Mcp" Click="OnCardToggleClick">
              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="MCP servers" /><Border Grid.Column="1" Classes="switch" VerticalAlignment="Center"><Ellipse /></Border></Grid>
            </Button>
          </StackPanel>
        </Flyout>
      </Button.Flyout>
    </Button>
    </Grid>
  </Border>
</UserControl>
