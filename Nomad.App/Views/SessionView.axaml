<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nomad.App.ViewModels"
             xmlns:md="using:Nomad.App.Markdown"
             xmlns:c="using:Nomad.App.Controls"
             xmlns:inf="using:Nomad.App.Infrastructure"
             x:Class="Nomad.App.Views.SessionView"
             x:DataType="vm:SessionViewModel">

  <UserControl.Styles>
    <!-- +21 / −1 pills -->
    <!-- Status row labels: a size below the interface text, medium weight. -->
    <Style Selector="TextBlock.status">
      <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSmall}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- A narrow window keeps only the current model's chip (the picker still has them all). -->
    <Style Selector="Grid.narrow Button.modelchip:not(.selected)">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- Narrower still (the side panel open on a small window): the branch chip and the effort slider lose their words. -->
    <Style Selector="Grid.tight TextBlock.branchtext, Grid.tight TextBlock.effortlabel">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Buttons on the composer bar keep the arrow, not the bar's I-beam. -->
    <Style Selector="Border.composer Button">
      <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <!-- Prompt actions: hidden until the prompt is hovered, then a quick fade. -->
    <Style Selector="Grid.usermsg StackPanel.msgactions">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Grid.usermsg:pointerover StackPanel.msgactions">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="c|Icon.tick">
      <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="c|Icon.tick.seen">
      <Setter Property="Stroke" Value="{DynamicResource TextChromeBrush}" />
    </Style>

    <!-- A running tool group the working row already describes: faded out, its place kept. -->
    <Style Selector="Button.toolgroup">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.toolgroup.echoed">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- The working row: folded and transparent when idle. -->
    <Style Selector="Border.working">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="MaxHeight" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut" />
          <DoubleTransition Property="MaxHeight" Duration="0:0:0.2" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.working.on">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="MaxHeight" Value="40" />
    </Style>

    <!-- The usage ring at the end of the status row; turned off in the settings, it folds away. -->
    <Style Selector="Button#UsageChip">
      <Setter Property="Width" Value="30" />
      <Setter Property="Margin" Value="2,0,8,0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut" />
          <DoubleTransition Property="Width" Duration="0:0:0.2" Easing="CubicEaseOut" />
          <ThicknessTransition Property="Margin" Duration="0:0:0.2" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button#UsageChip.off">
      <Setter Property="Width" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style Selector="Border.pill">
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="Height" Value="17" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.pill > TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="FontSize" Value="{DynamicResource UiFontSizeTiny}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.pill.add">
      <Setter Property="Background" Value="{DynamicResource DiffAddBgBrush}" />
    </Style>
    <Style Selector="Border.pill.add > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource DiffAddBrush}" />
    </Style>
    <Style Selector="Border.pill.del">
      <Setter Property="Background" Value="{DynamicResource DiffDelBgBrush}" />
    </Style>
    <Style Selector="Border.pill.del > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource DiffDelBrush}" />
    </Style>

    <!-- Agent state word -->
    <Style Selector="TextBlock.state">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.state.running">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBlock.state.done">
      <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    </Style>
    <Style Selector="TextBlock.state.error">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>

    <!-- Mini diff lines in the permission card -->
    <Style Selector="Border.diffline">
      <Setter Property="Background" Value="{DynamicResource DiffDelBgBrush}" />
      <Setter Property="Padding" Value="8,1" />
    </Style>
    <Style Selector="Border.diffline.added">
      <Setter Property="Background" Value="{DynamicResource DiffAddBgBrush}" />
    </Style>

    <!-- Chevrons turn down when their line is expanded -->
    <Style Selector="c|Icon.chev">
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
    </Style>
    <Style Selector="c|Icon.chev.open">
      <Setter Property="RenderTransform" Value="rotate(90deg)" />
    </Style>

    <!-- Bypass permissions is a warning colour -->
    <Style Selector="Button.bypass">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="TextBlock.danger">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>

    <!-- Remote Control chip: dim while off; a dot, green once claude.ai is connected. -->
    <!-- Worktree: muted while off, the accent while on. The hover fill isn't animated: Transparent is #00FFFFFF, so
         fading it to the chip colour passes through white. -->
    <Style Selector="Button.worktree">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.15" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.worktree.on">
      <Setter Property="Foreground" Value="{DynamicResource RingBrush}" />
    </Style>
    <Style Selector="Button.remote:not(.on)">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="Button.remote Ellipse.remotedot">
      <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.remote.on Ellipse.remotedot">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.remote.on.connected Ellipse.remotedot">
      <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
    </Style>

    <!-- The model menu's Mode row stays lit while its menu is open. -->
    <Style Selector="Button#ModeRow.open">
      <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
    </Style>

    <!-- The "/" menu's keyboard choice. -->
    <Style Selector="Button.selected">
      <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
    </Style>

    <!-- "Show activity" off: thinking and tool lines are left out (their containers carry the class). -->
    <Style Selector="ItemsControl.quiet > ContentPresenter.activity">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- New-session project cards: a lighter edge on hover, the check colour when it is the session's folder. -->
    <Style Selector="Button.project">
      <Setter Property="Background" Value="{DynamicResource BgSidebarBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderCardBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,12,14,11" />
      <Setter Property="Width" Value="322" />
      <Setter Property="Height" Value="163" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15" Easing="CubicEaseOut" />
          <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.project:pointerover /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource BorderInputBrush}" />
      <Setter Property="Background" Value="{DynamicResource BgSidebarBrush}" />
    </Style>
    <Style Selector="Button.project.selected /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource CheckBrush}" />
    </Style>
    <!-- The pin: shown on hover, and always on a pinned card. -->
    <Style Selector="Button.pin">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="6,-4,-4,-4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.project:pointerover Button.pin, Button.pin.pinned">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- Pinned: the outline crossfades to a filled pin. -->
    <Style Selector="Button.pin :is(Control).pin-off, Button.pin :is(Control).pin-on">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.pin :is(Control).pin-on">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.pin.pinned :is(Control).pin-on">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.pin.pinned :is(Control).pin-off">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="StackPanel.gitpart">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="StackPanel.gitpart.loaded">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Attachment thumbnails: a lighter edge on hover says they open. -->
    <Style Selector="Border.thumb">
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Panel:pointerover > Border.thumb">
      <Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <!-- The image preview: fades in over the session while the picture grows into place. -->
    <Style Selector="Panel#ImagePreview">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Panel#ImagePreview.open">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="Panel#ImagePreview StackPanel.frame">
      <Setter Property="RenderTransform" Value="scale(0.96)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Panel#ImagePreview.open StackPanel.frame">
      <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>

    <!-- Images being dragged over the session: the composer lights up. -->
    <Style Selector="Border#ComposerBar.dragover">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- Section headers inside menus -->
    <Style Selector="TextBlock.menuheader">
      <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSmall}" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="Margin" Value="8,3,8,3" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSmall}" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <!-- ================================================================ transcript items -->
  <UserControl.DataTemplates>

    <DataTemplate DataType="{x:Type vm:UserMessageItem}" x:DataType="vm:UserMessageItem">
      <!-- Bubble, then a row that fades in on hover: seen mark, time, Copy, Rewind, Fork. -->
      <Grid Classes="usermsg" ColumnDefinitions="*,3*" RowDefinitions="Auto,Auto" Margin="0,22,0,0" Background="Transparent">
        <Border Grid.Column="1"
                HorizontalAlignment="Right"
                Background="{DynamicResource BgRaisedBrush}"
                CornerRadius="10"
                Padding="12,6,12,7">
          <StackPanel Spacing="6">
            <ItemsControl ItemsSource="{Binding Images}" IsVisible="{Binding HasImages}" Margin="0,4,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel ItemSpacing="6" LineSpacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="Bitmap">
                  <Border CornerRadius="6" ClipToBounds="True" MaxWidth="220" MaxHeight="160" Cursor="Hand" Tapped="OnSentImageTapped">
                    <Border.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Copy image" Click="OnCopyImageClick" />
                      </ContextMenu>
                    </Border.ContextMenu>
                    <Image Source="{Binding}" Stretch="Uniform" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Files}" IsVisible="{Binding HasFiles}" Margin="0,4,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel ItemSpacing="6" LineSpacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="inf:Attachment">
                  <Border Height="40" MaxWidth="240" Padding="9,0,12,0" CornerRadius="7"
                          Background="{DynamicResource BgInputBrush}"
                          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                          ToolTip.Tip="{Binding ToolTip}">
                    <Grid ColumnDefinitions="Auto,*">
                      <Panel VerticalAlignment="Center" Margin="0,0,8,0">
                      <c:Icon Size="15" Data="{StaticResource IconFile}" Stroke="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsFolder}" />
                      <c:Icon Size="15" Data="{StaticResource IconFolder}" Stroke="{DynamicResource TextMutedBrush}" IsVisible="{Binding IsFolder}" />
                    </Panel>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource UiFontSizeSmall}" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Kind}" Classes="muted" FontSize="{DynamicResource UiFontSizeTiny}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <SelectableTextBlock Text="{Binding Text}"
                                 IsVisible="{Binding HasText}"
                                 TextWrapping="Wrap"
                                 FontSize="{DynamicResource BodyFontSize}"
                                 LineHeight="{DynamicResource BodyLineHeight}"
                                 Foreground="{DynamicResource TextPrimaryBrush}" />
          </StackPanel>
        </Border>
        <StackPanel Grid.Row="1" Grid.Column="1"
                    Classes="msgactions"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="2"
                    Margin="0,4,0,0">
          <c:Icon Size="12" Data="{StaticResource IconPhone}" Classes="tick" IsVisible="{Binding IsRemote}" VerticalAlignment="Center" Margin="0,0,2,0" ToolTip.Tip="Sent from Remote Control" />
          <Panel Width="16" Height="14" VerticalAlignment="Center" ToolTip.Tip="{Binding SeenToolTip}">
            <c:Icon Size="12" Data="{StaticResource IconCheck}" HorizontalAlignment="Left" Classes.seen="{Binding IsSeen}" Classes="tick" />
            <c:Icon Size="12" Data="{StaticResource IconCheck}" HorizontalAlignment="Left" Margin="4,0,0,0" IsVisible="{Binding IsSeen}" Classes="tick seen" />
          </Panel>
          <TextBlock Text="{Binding TimeText}" Classes="muted" FontSize="{DynamicResource UiFontSizeSmall}" VerticalAlignment="Center" Margin="2,0,6,0" />
          <Button Theme="{StaticResource IconButton}" Width="24" Height="24" Click="OnCopyMessageClick" ToolTip.Tip="Copy">
            <c:Icon Size="13" Data="{StaticResource IconCopy}" />
          </Button>
          <Button Theme="{StaticResource IconButton}" Width="24" Height="24" Click="OnRewindClick" IsEnabled="{Binding CanBranch}" ToolTip.Tip="Rewind to here (edit and resend this message)">
            <c:Icon Size="13" Data="{StaticResource IconRewind}" />
          </Button>
          <Button Theme="{StaticResource IconButton}" Width="24" Height="24" Click="OnForkClick" IsEnabled="{Binding CanBranch}" ToolTip.Tip="Fork a new session after this turn">
            <c:Icon Size="13" Data="{StaticResource IconFork}" />
          </Button>
        </StackPanel>
      </Grid>
    </DataTemplate>

    <!-- Files Claude sent (SendUserFile): the caption, images large (a click opens the viewer), other files as chips. -->
    <DataTemplate DataType="{x:Type vm:SentFilesItem}" x:DataType="vm:SentFilesItem">
      <StackPanel Spacing="8" Margin="0,10,0,4">
        <SelectableTextBlock Text="{Binding Caption}"
                             IsVisible="{Binding HasCaption}"
                             TextWrapping="Wrap"
                             FontSize="{DynamicResource BodyFontSize}"
                             LineHeight="{DynamicResource BodyLineHeight}"
                             Foreground="{DynamicResource TextPrimaryBrush}" />
        <ItemsControl ItemsSource="{Binding Images}" IsVisible="{Binding HasImages}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel ItemSpacing="8" LineSpacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="Bitmap">
              <Border CornerRadius="8" ClipToBounds="True" MaxWidth="560" MaxHeight="400" Cursor="Hand"
                      BorderBrush="{DynamicResource BorderCardBrush}" BorderThickness="1"
                      HorizontalAlignment="Left" Tapped="OnSentImageTapped">
                <Border.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Copy image" Click="OnCopyImageClick" />
                  </ContextMenu>
                </Border.ContextMenu>
                <Image Source="{Binding}" Stretch="Uniform" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding Files}" IsVisible="{Binding HasFiles}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel ItemSpacing="6" LineSpacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="inf:Attachment">
              <Border Height="40" MaxWidth="280" Padding="9,0,12,0" CornerRadius="7"
                      Background="{DynamicResource BgInputBrush}"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                      Cursor="Hand" Tapped="OnSentFileTapped"
                      ToolTip.Tip="{Binding ToolTip}">
                <Border.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Open" Click="OnSentFileOpenClick" />
                    <MenuItem Header="Show in Explorer" Click="OnSentFileRevealClick" />
                  </ContextMenu>
                </Border.ContextMenu>
                <Grid ColumnDefinitions="Auto,*">
                  <c:Icon Size="15" Data="{StaticResource IconFile}" Stroke="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource UiFontSizeSmall}" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Kind}" Classes="muted" FontSize="{DynamicResource UiFontSizeTiny}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:AssistantTextItem}" x:DataType="vm:AssistantTextItem">
      <md:MarkdownView Markdown="{Binding Text}" IsStreaming="{Binding IsStreaming}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ThinkingItem}" x:DataType="vm:ThinkingItem">
      <!-- While it streams, the working row below the transcript says "Thinking"; this line appears once it is done. -->
      <StackPanel Spacing="6" IsVisible="{Binding !IsStreaming}">
        <Button Theme="{StaticResource LineButton}" Command="{Binding ToggleCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:PixelSpinner IsVisible="{Binding IsStreaming}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Label}" FontSize="{DynamicResource UiFontSize}" VerticalAlignment="Center" />
            <c:Icon Classes="chev"
                  Classes.open="{Binding IsExpanded}"
                  Data="{StaticResource IconChevronRight}"
                  IsVisible="{Binding !IsStreaming}" />
          </StackPanel>
        </Button>
        <Border c:Fold.IsOpen="{Binding IsExpanded}"
                IsVisible="False"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="2,0,0,0"
                Padding="12,0,0,0"
                Margin="1,0,0,4">
          <SelectableTextBlock Text="{Binding DisplayText}"
                               TextWrapping="Wrap"
                               FontSize="{DynamicResource UiFontSize}"
                               LineHeight="20"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
        </Border>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ToolGroupItem}" x:DataType="vm:ToolGroupItem">
      <StackPanel Spacing="2">
        <Button Theme="{StaticResource LineButton}" Command="{Binding ToggleCommand}" Classes="toolgroup" Classes.echoed="{Binding IsEchoed}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{Binding Summary}" FontSize="{DynamicResource UiFontSize}" VerticalAlignment="Center" />
            <Border Classes="pill add" IsVisible="{Binding HasAdded}">
              <TextBlock Text="{Binding AddedText}" />
            </Border>
            <Border Classes="pill del" IsVisible="{Binding HasRemoved}" Margin="-3,0,0,0">
              <TextBlock Text="{Binding RemovedText}" />
            </Border>
            <c:Icon Classes="chev" Classes.open="{Binding IsExpanded}" Data="{StaticResource IconChevronRight}" Margin="-4,0,0,0" />
          </StackPanel>
        </Button>

        <ItemsControl ItemsSource="{Binding Entries}" c:Fold.IsOpen="{Binding IsExpanded}" IsVisible="False" Margin="0,2,0,4">
          <ItemsControl.DataTemplates>
            <!-- Thinking between the calls: "Thought" and its first line, expanding to the whole text. -->
            <DataTemplate x:DataType="vm:ThinkingItem">
              <StackPanel>
                <Button Theme="{StaticResource FlatButton}"
                        Command="{Binding ToggleCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="6,0"
                        Height="28"
                        Foreground="{DynamicResource TextChromeBrush}">
                  <Grid ColumnDefinitions="Auto,Auto,*">
                    <c:Icon Data="{StaticResource IconThought}" Stroke="{DynamicResource TextMutedBrush}" />
                    <TextBlock Grid.Column="1"
                               Text="Thought"
                               FontSize="{DynamicResource UiFontSizeSmall}"
                               FontWeight="Medium"
                               Margin="8,0,10,0"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding FirstLine}"
                               FontSize="{DynamicResource UiFontSizeSmall}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Border c:Fold.IsOpen="{Binding IsExpanded}"
                        IsVisible="False"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="2,0,0,0"
                        Padding="12,0,0,0"
                        Margin="13,2,0,6">
                  <SelectableTextBlock Text="{Binding DisplayText}"
                                       TextWrapping="Wrap"
                                       FontSize="{DynamicResource UiFontSize}"
                                       LineHeight="20"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>
              </StackPanel>
            </DataTemplate>
            <DataTemplate x:DataType="vm:ToolCallItem">
              <StackPanel>
                <Button Theme="{StaticResource FlatButton}"
                        Command="{Binding ToggleCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="6,0"
                        Height="28"
                        Foreground="{DynamicResource TextChromeBrush}">
                  <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                    <c:Icon
                          Data="{Binding IconKey, Converter={x:Static inf:IconConverter.Instance}}"
                          Stroke="{DynamicResource TextMutedBrush}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Name}"
                               FontSize="{DynamicResource UiFontSizeSmall}"
                               FontWeight="Medium"
                               Margin="8,0,10,0"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding Summary}"
                               FontSize="{DynamicResource UiFontSizeSmall}"
                               Classes.mono="{Binding SummaryIsCode}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <Panel Grid.Column="3" Width="16" Height="16" Margin="8,0,2,0">
                      <c:Ring Width="12" Height="12"
                              StrokeWidth="1.5"
                              IsSpinning="{Binding IsRunning}"
                              IsVisible="{Binding IsRunning}"
                              TrackBrush="{DynamicResource RingTrackBrush}"
                              SpinBrush="{DynamicResource AccentBrush}" />
                      <c:Icon Data="{StaticResource IconCheck}" Stroke="{DynamicResource TextMutedBrush}" IsVisible="{Binding IsDone}" />
                      <c:Icon Data="{StaticResource IconClose}" Stroke="{DynamicResource DangerBrush}" IsVisible="{Binding IsFailed}" />
                    </Panel>
                  </Grid>
                </Button>
                <Border c:Fold.IsOpen="{Binding IsExpanded}"
                        IsVisible="False"
                        Margin="30,2,0,6"
                        Background="{DynamicResource BgCodeBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                  <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,10" Spacing="8">
                      <SelectableTextBlock Text="{Binding InputText}" Classes="mono" Foreground="{DynamicResource TextChromeBrush}" />
                      <Border Height="1" Background="{DynamicResource BorderBrush}" IsVisible="{Binding HasResult}" />
                      <SelectableTextBlock Text="{Binding ResultText}" Classes="mono" IsVisible="{Binding HasResult}" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                  </ScrollViewer>
                </Border>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.DataTemplates>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>

    <!-- AskUserQuestion: before the PermissionItem template, which would also match it. -->
    <DataTemplate DataType="{x:Type vm:QuestionItem}" x:DataType="vm:QuestionItem">
      <Panel>
        <!-- A star column capped at 480: as wide as the original's card, narrower only in a narrow window. -->
        <Grid IsVisible="{Binding IsPending}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="480" />
          </Grid.ColumnDefinitions>
          <Border Margin="0,8"
                  Background="{DynamicResource BgMainBrush}"
                  BorderBrush="{DynamicResource BorderCardBrush}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="12,10,12,12">
            <StackPanel Spacing="12">
              <ItemsControl ItemsSource="{Binding Questions}" ClipToBounds="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="16" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:QuestionEntry">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding Question}"
                                 FontSize="{DynamicResource UiFontSize}"
                                 FontWeight="SemiBold"
                                 LineHeight="20"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,2"
                                 Foreground="{DynamicResource TextPrimaryBrush}" />
                      <TextBlock Text="Choose any that apply" IsVisible="{Binding MultiSelect}" Classes="muted" FontSize="{DynamicResource UiFontSizeSmall}" />
                      <ItemsControl ItemsSource="{Binding Options}" Margin="-4,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:QuestionOption">
                            <Button Theme="{StaticResource OptionButton}"
                                    Classes.selected="{Binding IsSelected}"
                                    Command="{Binding PickCommand}">
                              <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="1">
                                  <TextBlock Text="{Binding Label}" FontSize="{DynamicResource UiFontSize}" TextWrapping="Wrap" />
                                  <TextBlock Text="{Binding Description}"
                                             IsVisible="{Binding HasDescription}"
                                             Classes="muted"
                                             FontSize="{DynamicResource UiFontSizeSmall}"
                                             TextWrapping="Wrap" />
                                </StackPanel>
                                <c:Icon Grid.Column="1"
                                        Data="{StaticResource IconCheck}"
                                        IsVisible="{Binding IsSelected}"
                                        Size="14"
                                        VerticalAlignment="Top"
                                        Margin="10,3,0,0" />
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Border Background="{DynamicResource BgInputBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              BorderThickness="1"
                              CornerRadius="7"
                              Height="32"
                              Padding="8,0"
                              Margin="0,4,0,0">
                        <TextBox Theme="{StaticResource BareTextBox}"
                                 Text="{Binding OtherText}"
                                 Watermark="Other answer…"
                                 VerticalAlignment="Center"
                                 FontSize="{DynamicResource UiFontSize}"
                                 KeyDown="OnQuestionOtherKeyDown" />
                      </Border>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Theme="{StaticResource GhostButton}" Command="{Binding DenyCommand}" ToolTip.Tip="Esc">
                  <TextBlock Text="Skip" />
                </Button>
                <Button Theme="{StaticResource InvertedButton}" Command="{Binding AllowCommand}" IsEnabled="{Binding CanSubmit}" ToolTip.Tip="Enter">
                  <TextBlock Text="Submit" />
                </Button>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
        <TextBlock IsVisible="{Binding IsAnswered}" Text="{Binding AnswerText}" Classes="muted" FontSize="{DynamicResource UiFontSizeSmall}" TextWrapping="Wrap" />
      </Panel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:PermissionItem}" x:DataType="vm:PermissionItem">
      <Panel>
        <Border IsVisible="{Binding IsPending}"
                Margin="0,8"
                Background="{DynamicResource BgRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14">
          <StackPanel Spacing="10">
            <TextBlock Text="{Binding Title}" FontWeight="Medium" FontSize="{DynamicResource UiFontSize}" />
            <Border IsVisible="{Binding DetailIsCode}"
                    Background="{DynamicResource BgCodeBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,7">
              <SelectableTextBlock Text="{Binding Detail}" Classes="mono" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
            </Border>
            <SelectableTextBlock Text="{Binding Detail}"
                                 IsVisible="{Binding !DetailIsCode}"
                                 TextWrapping="Wrap"
                                 FontSize="{DynamicResource UiFontSize}"
                                 Foreground="{DynamicResource TextChromeBrush}" />
            <TextBlock Text="{Binding Description}"
                       IsVisible="{Binding HasDescription}"
                       Classes="muted"
                       FontSize="{DynamicResource UiFontSizeSmall}"
                       TextWrapping="Wrap" />
            <Border IsVisible="{Binding HasDiff}" CornerRadius="6" ClipToBounds="True">
              <ItemsControl ItemsSource="{Binding DiffLines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DiffLine">
                    <Border Classes="diffline" Classes.added="{Binding IsAdded}">
                      <TextBlock Text="{Binding Text}" Classes="mono" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
              <Button Theme="{StaticResource GhostButton}" Classes="danger" Command="{Binding DenyCommand}" ToolTip.Tip="Esc">
                <TextBlock Text="Deny" />
              </Button>
              <Button Theme="{StaticResource SecondaryButton}" Command="{Binding AllowForSessionCommand}" IsVisible="{Binding CanAllowForSession}">
                <TextBlock Text="Allow for session" />
              </Button>
              <Button Theme="{StaticResource PrimaryButton}" Command="{Binding AllowCommand}" ToolTip.Tip="Enter">
                <TextBlock Text="Allow" />
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>
        <TextBlock IsVisible="{Binding IsAnswered}" Text="{Binding AnswerText}" Classes="muted" FontSize="{DynamicResource UiFontSizeSmall}" />
      </Panel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ErrorItem}" x:DataType="vm:ErrorItem">
      <Border Background="{DynamicResource DangerSubtleBrush}"
              BorderBrush="{DynamicResource DangerBrush}"
              BorderThickness="2,0,0,0"
              CornerRadius="4"
              Padding="12,8">
        <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="{DynamicResource UiFontSize}" Foreground="{DynamicResource TextPrimaryBrush}" />
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:NoticeItem}" x:DataType="vm:NoticeItem">
      <TextBlock Text="{Binding Text}" Classes="muted" FontSize="{DynamicResource UiFontSize}" TextWrapping="Wrap" />
    </DataTemplate>
  </UserControl.DataTemplates>

  <!-- ================================================================ layout -->
  <Grid RowDefinitions="*,Auto,Auto,Auto">

    <!-- Transcript -->
    <Panel Grid.Row="0">
      <!-- SelectionAssist: a press beside text starts selecting it, as in a browser. -->
      <ScrollViewer Name="Scroller"
                    c:SelectionAssist.IsEnabled="True"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{DynamicResource ColumnMaxWidth}" Margin="32,14,32,20">
          <ItemsControl Name="Transcript"
                        ItemsSource="{Binding Items}"
                        Classes.quiet="{Binding !ShowActivity}"
                        Padding="14,0,10,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="14" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>

          <!-- Working row: what Claude is doing and for how long, while a turn runs. It fades and
               slides in when the turn starts and folds away when it ends. -->
          <Border Classes="working"
                  Classes.on="{Binding IsTurnRunning}"
                  Padding="14,0,10,0"
                  ClipToBounds="True">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,14,0,0" Height="22">
              <c:ClayMark Activity="{Binding WorkingActivity}" Foreground="{DynamicResource AccentBrush}" Margin="-3,0,-3,0" VerticalAlignment="Center" />
              <!-- A highlight sweeps over the words; a new phase ("Thinking" → "Running a command") slides up in. -->
              <TransitioningContentControl Content="{Binding WorkingText}" ClipToBounds="True" Height="22" VerticalAlignment="Center">
                <TransitioningContentControl.PageTransition>
                  <CompositePageTransition>
                    <CrossFade Duration="0:0:0.2" FadeInEasing="CubicEaseOut" FadeOutEasing="CubicEaseOut" />
                    <PageSlide Duration="0:0:0.2" Orientation="Vertical" SlideInEasing="CubicEaseOut" SlideOutEasing="CubicEaseOut" />
                  </CompositePageTransition>
                </TransitioningContentControl.PageTransition>
                <TransitioningContentControl.ContentTemplate>
                  <DataTemplate x:DataType="x:String">
                    <c:Shimmer Text="{Binding}"
                               IsActive="{Binding $parent[UserControl].((vm:SessionViewModel)DataContext).IsTurnRunning}"
                               TextTrimming="CharacterEllipsis"
                               FontWeight="SemiBold"
                               MaxWidth="600"
                               VerticalAlignment="Center" />
                  </DataTemplate>
                </TransitioningContentControl.ContentTemplate>
              </TransitioningContentControl>
              <TextBlock Text="{Binding WorkingElapsed}" Classes="muted" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Scrolled: the transcript fades out under the title bar instead of being cut off there. -->
      <Border Name="TopFade"
              Height="28"
              VerticalAlignment="Top"
              IsHitTestVisible="False"
              Opacity="0"
              Margin="0,0,10,0">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="{DynamicResource BgMainColor}" Offset="0" />
            <GradientStop Color="{DynamicResource BgMainClearColor}" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <Border.Transitions>
          <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
          </Transitions>
        </Border.Transitions>
      </Border>

      <!-- New session: the latest projects as cards (click one to work there), then No folder / Open folder…. -->
      <ScrollViewer IsVisible="{Binding IsNew}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,20" Spacing="10" MaxWidth="{DynamicResource ColumnMaxWidth}">
          <Grid ColumnDefinitions="*,Auto,Auto" Margin="2,0">
            <TextBlock Text="Recent projects" Classes="muted" FontSize="{DynamicResource UiFontSizeSmall}" VerticalAlignment="Center" IsVisible="{Binding HasProjects}" />
            <Button Grid.Column="1" Theme="{StaticResource LineButton}" Click="OnNoFolderClick" Margin="0,0,16,0" ToolTip.Tip="Claude works in a new scratch folder">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <c:Icon Size="12" Data="{StaticResource IconCheck}" Stroke="{DynamicResource CheckBrush}" IsVisible="{Binding IsNoFolder}" />
                <TextBlock Text="No folder" FontSize="{DynamicResource UiFontSizeSmall}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="2" Theme="{StaticResource LineButton}" Click="OnOpenFolderClick">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <c:Icon Size="12" Data="{StaticResource IconFolderOpen}" />
                <TextBlock Text="Open folder…" FontSize="{DynamicResource UiFontSizeSmall}" />
              </StackPanel>
            </Button>
          </Grid>
          <ItemsControl Name="ProjectCards" ItemsSource="{Binding Projects}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemSpacing="10" LineSpacing="10" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ProjectViewModel">
                <Button Theme="{StaticResource FlatButton}"
                        Classes="project"
                        Classes.selected="{Binding IsSelected}"
                        Click="OnProjectClick"
                        ToolTip.Tip="{Binding Path}">
                  <Button.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="{Binding PinToolTip}" Click="OnPinClick" />
                      <MenuItem Header="Remove from recent projects" Click="OnRemoveProjectClick" />
                    </ContextMenu>
                  </Button.ContextMenu>
                  <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                      <c:Icon Size="14" Data="{StaticResource IconFolder}" Stroke="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"
                                 TextTrimming="CharacterEllipsis" Margin="8,0" VerticalAlignment="Center" />
                      <Border Grid.Column="2" IsVisible="{Binding HasBranch}" Background="{DynamicResource BgChipBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Branch}" FontFamily="{DynamicResource MonoFont}"
                                   FontSize="{DynamicResource UiFontSizeTiny}" Foreground="{DynamicResource TextChromeBrush}" MaxWidth="110" TextTrimming="CharacterEllipsis" />
                      </Border>
                      <Button Grid.Column="3" Theme="{StaticResource FlatButton}" Classes="pin" Classes.pinned="{Binding IsPinned}"
                              Click="OnPinClick" ToolTip.Tip="{Binding PinToolTip}">
                        <Panel>
                          <c:Icon Classes="pin-off" Size="13" Data="{StaticResource IconPin}" Stroke="{DynamicResource TextMutedBrush}" />
                          <Panel Classes="pin-on">
                            <c:Icon Size="13" Data="{StaticResource IconPinHead}" Stroke="{DynamicResource TextPrimaryBrush}" IsFilled="True" />
                            <c:Icon Size="13" Data="{StaticResource IconPin}" Stroke="{DynamicResource TextPrimaryBrush}" />
                          </Panel>
                        </Panel>
                      </Button>
                      <c:Icon Grid.Column="4" Size="13" Data="{StaticResource IconCheck}" Stroke="{DynamicResource CheckBrush}" IsVisible="{Binding IsSelected}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Path}" Classes="muted" FontSize="{DynamicResource UiFontSizeTiny}"
                               TextTrimming="CharacterEllipsis" Margin="22,1,0,0" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Classes="gitpart" Classes.loaded="{Binding IsLoaded}">
                      <TextBlock Text="{Binding StatusText}" IsVisible="{Binding HasStatus}" Classes="muted" Classes.warn="{Binding HasChanges}" FontSize="{DynamicResource UiFontSizeTiny}" />
                      <TextBlock Text="·" Classes="muted" FontSize="{DynamicResource UiFontSizeTiny}" IsVisible="{Binding HasBothFooterParts}" />
                      <TextBlock Text="{Binding LastSessionText}" IsVisible="{Binding HasLastSession}" Classes="muted" FontSize="{DynamicResource UiFontSizeTiny}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <!-- The latest commits, with placeholder rows while git is read. -->
                    <Panel Margin="0,9,0,6">
                      <c:Skeleton IsActive="{Binding !IsLoaded}" Rows="3" RowHeight="8" RowSpacing="12" Widths="0.78,0.6,0.7"
                                  Fill="{DynamicResource SkeletonBrush}" Margin="18,4,40,0" VerticalAlignment="Top" />
                      <StackPanel Classes="gitpart" Classes.loaded="{Binding IsLoaded}">
                        <ItemsControl ItemsSource="{Binding TopCommits}" IsVisible="{Binding HasCommits}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Spacing="3" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CommitRow">
                              <Grid ColumnDefinitions="Auto,*,Auto">
                                <Ellipse Width="4" Height="4" Fill="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="5,0,9,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Subject}" FontSize="{DynamicResource UiFontSizeSmall}" Foreground="{DynamicResource TextChromeBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding WhenText}" Classes="muted" FontSize="{DynamicResource UiFontSizeTiny}" Margin="8,0,0,0" VerticalAlignment="Center" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Not a git repository" IsVisible="{Binding IsNotGit}" Classes="muted" FontSize="{DynamicResource UiFontSizeSmall}" Margin="1,0,0,0" />
                      </StackPanel>
                    </Panel>
                  </DockPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <c:Ring Width="22" Height="22"
              IsSpinning="{Binding IsLoadingHistory}"
              IsVisible="{Binding IsLoadingHistory}"
              TrackBrush="{DynamicResource RingTrackBrush}"
              SpinBrush="{DynamicResource TextMutedBrush}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center" />

      <Button Name="ScrollDownButton"
              Theme="{StaticResource RoundButton}"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Margin="0,0,0,12"
              IsVisible="False"
              Click="OnScrollDownClick"
              ToolTip.Tip="Scroll to bottom">
        <c:Icon Data="{StaticResource IconArrowDown}" />
      </Button>
    </Panel>

    <!-- Started from the phone: shown live here, continued in the Claude app until it ends. -->
    <Border Grid.Row="2"
            MaxWidth="{DynamicResource ColumnMaxWidth}"
            Margin="32,0"
            MinHeight="44"
            CornerRadius="10"
            BorderThickness="1"
            BorderBrush="{DynamicResource BorderInputBrush}"
            Padding="14,0"
            IsVisible="{Binding IsPhoneSession}">
      <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
        <c:Icon Size="14" Data="{StaticResource IconPhone}" VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock Grid.Column="1"
                   Text="Running from the Claude app. It shows here live."
                   Classes="muted"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center" />
        <Button Grid.Column="2"
                Theme="{StaticResource LineButton}"
                Command="{Binding TakeOverCommand}"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Margin="12,0,0,0"
                ToolTip.Tip="Stop it in the Claude app's process and continue in Nomad (still reachable from the app)">
          <TextBlock Text="Continue here" FontWeight="Medium" />
        </Button>
      </Grid>
    </Border>

    <!-- Composer -->
    <StackPanel Grid.Row="2" MaxWidth="{DynamicResource ColumnMaxWidth}" Margin="32,0" IsVisible="{Binding ShowComposer}">
      <!-- Switching the model of a conversation that has history: asked first, since the cache does not carry over. -->
      <Border c:Fold.IsOpen="{Binding HasPendingModel}" IsVisible="False">
        <Border Background="{DynamicResource BgRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,10,10,10"
                Margin="0,0,0,8">
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
            <StackPanel Spacing="3" Margin="0,0,12,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding PendingModelTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="{Binding PendingModelText}" Classes="muted" FontSize="{DynamicResource UiFontSizeSmall}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Button Theme="{StaticResource SecondaryButton}" Command="{Binding CancelModelSwitchCommand}" Content="Keep" />
              <Button Theme="{StaticResource SecondaryButton}" Command="{Binding ConfirmModelSwitchCommand}" CommandParameter="always" Content="Always switch" ToolTip.Tip="Switch now, and don't ask again (Settings › Claude Code)" />
              <Button Theme="{StaticResource PrimaryButton}" Command="{Binding ConfirmModelSwitchCommand}" CommandParameter="once" Content="Switch" />
            </StackPanel>
          </Grid>
        </Border>
      </Border>

      <!-- Queued prompts: written while Claude worked, sent when it is done (or now, stopping it). -->
      <Border c:Fold.IsOpen="{Binding HasQueued}" IsVisible="False">
        <Border Background="{DynamicResource BgRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,8,8,8"
                Margin="0,0,0,8">
          <StackPanel Spacing="4">
            <ItemsControl Name="QueueList" ItemsSource="{Binding Queued}">
              <ItemsControl.ItemTemplate>
                <!-- Double-click or the pencil (↑ in an empty composer: the last one) edits it in place: Enter saves,
                     Shift+Enter is a new line, Esc drops the edit. -->
                <DataTemplate x:DataType="vm:QueuedPrompt">
                  <Grid Classes="queued" ColumnDefinitions="Auto,*,Auto" MinHeight="26" Background="Transparent">
                    <TextBlock Text="Queued" Classes="muted" FontSize="{DynamicResource UiFontSizeSmall}" VerticalAlignment="Top" Margin="0,5,10,0" />
                    <Panel Grid.Column="1" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="8" Background="Transparent" IsVisible="{Binding !IsEditing}"
                                  DoubleTapped="OnQueuedDoubleTapped" ToolTip.Tip="Double-click to edit">
                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" MaxLines="1" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AttachmentsText}" IsVisible="{Binding HasAttachments}" Classes="muted" FontSize="{DynamicResource UiFontSizeSmall}" VerticalAlignment="Center" />
                      </StackPanel>
                      <Border IsVisible="{Binding IsEditing}" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderInputBrush}"
                              BorderThickness="1" CornerRadius="6" Padding="7,3" Margin="-3,2,6,2">
                        <TextBox Classes="queuededit"
                                 Theme="{StaticResource BareTextBox}"
                                 Text="{Binding EditText}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MaxHeight="140"
                                 LostFocus="OnQueuedEditLostFocus"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                      </Border>
                    </Panel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
                      <Button Theme="{StaticResource IconButton}" Width="24" Height="24" Click="OnEditQueuedClick" IsVisible="{Binding !IsEditing}" ToolTip.Tip="Edit (↑ in an empty composer)">
                        <c:Icon Size="12" Data="{StaticResource IconPencil}" />
                      </Button>
                      <Button Theme="{StaticResource IconButton}" Width="24" Height="24" Click="OnSaveQueuedClick" IsVisible="{Binding IsEditing}" ToolTip.Tip="Save (Enter)">
                        <c:Icon Size="12" Data="{StaticResource IconCheck}" />
                      </Button>
                      <Button Theme="{StaticResource IconButton}" Width="24" Height="24" Click="OnRemoveQueuedClick" ToolTip.Tip="Remove from the queue">
                        <c:Icon Size="12" Data="{StaticResource IconClose}" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Theme="{StaticResource SecondaryButton}"
                    Height="26"
                    Padding="10,0"
                    HorizontalAlignment="Left"
                    Command="{Binding SendQueuedNowCommand}"
                    ToolTip.Tip="Stop Claude and send these now (Ctrl+Enter in the composer)">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon Size="12" Data="{StaticResource IconSendArrow}" />
                <TextBlock Text="Send now" FontSize="{DynamicResource UiFontSizeSmall}" VerticalAlignment="Center" />
                <TextBlock Text="Ctrl+Enter" Classes="muted" FontSize="{DynamicResource UiFontSizeTiny}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
      </Border>

      <!-- The "/" menu: Claude Code's commands, filtered as the name is typed. -->
      <Popup Name="CommandPopup"
             IsOpen="{Binding IsCommandMenuOpen}"
             PlacementTarget="{Binding #ComposerBar}"
             Placement="TopEdgeAlignedLeft"
             VerticalOffset="-6"
             IsLightDismissEnabled="False"
             Focusable="False">
        <Border Name="CommandMenu"
                Background="{DynamicResource BgMenuBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="9"
                Padding="5"
                BoxShadow="0 8 24 0 #73000000">
          <ScrollViewer Name="CommandScroller" MaxHeight="300" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding CommandOptions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CommandOption">
                  <Button Theme="{StaticResource MenuItemButton}"
                          Classes.selected="{Binding IsSelected}"
                          Focusable="False"
                          Click="OnCommandOptionClick">
                    <Grid ColumnDefinitions="Auto,Auto,*">
                      <TextBlock Text="{Binding Display}" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding ArgumentHint}" IsVisible="{Binding HasArgumentHint}" Classes="muted"
                                 FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource UiFontSizeSmall}" Margin="8,0,0,0" MaxWidth="220"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Description}" Classes="muted" FontSize="{DynamicResource UiFontSizeSmall}"
                                 Margin="14,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </Popup>

      <!-- The whole bar acts as the text box: I-beam over it, a click anywhere focuses it. Images can be
           pasted into it or dropped anywhere on the session. -->
      <Border Name="ComposerBar"
              Background="{DynamicResource BgInputBrush}"
              BorderBrush="{DynamicResource BorderInputBrush}"
              BorderThickness="1"
              CornerRadius="10"
              MinHeight="44"
              Classes="composer"
              Cursor="IBeam"
              PointerPressed="OnComposerBarPressed">
        <Border.Transitions>
          <Transitions>
            <BrushTransition Property="BorderBrush" Duration="0:0:0.15" Easing="CubicEaseOut" />
          </Transitions>
        </Border.Transitions>
        <Grid RowDefinitions="Auto,Auto">
        <!-- Attached images (thumbnails, named underneath, click to view) and files (chips), each with a remove
             button, in a darker tray above a dashed rule: plainly not part of the text. The button overlaps the
             corner from inside the item's own bounds, so nothing clips it. -->
        <Border c:Fold.IsOpen="{Binding HasAttachments}" IsVisible="False">
        <Border Background="#0D000000" CornerRadius="9,9,0,0">
        <StackPanel>
        <ItemsControl Name="AttachmentList" ItemsSource="{Binding Attachments}" Margin="10,2,12,8">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel ItemSpacing="4" LineSpacing="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="inf:Attachment">
              <Panel Cursor="Arrow" VerticalAlignment="Top" ToolTip.Tip="{Binding ToolTip}">
                <StackPanel Margin="2,8,8,0" Spacing="4" IsVisible="{Binding IsImage}">
                  <!-- The picture clipped to the rounded shape, its edge drawn over it: no image pixels in the corners. -->
                  <Panel Width="{Binding PreviewWidth}" Height="96" Cursor="Hand" Tapped="OnAttachmentImageTapped" Background="Transparent">
                    <Panel.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Copy image" Click="OnCopyImageClick" />
                      </ContextMenu>
                    </Panel.ContextMenu>
                    <Border CornerRadius="8" ClipToBounds="True">
                      <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                    </Border>
                    <Border Classes="thumb" CornerRadius="8" BorderThickness="1" />
                  </Panel>
                  <TextBlock Text="{Binding Name}"
                             Width="{Binding PreviewWidth}"
                             Classes="muted"
                             FontSize="{DynamicResource UiFontSizeTiny}"
                             TextTrimming="CharacterEllipsis"
                             TextAlignment="Center" />
                </StackPanel>
                <Border Margin="2,8,8,0"
                        Height="52" MaxWidth="240"
                        Padding="10,0,14,0"
                        CornerRadius="8"
                        Background="{DynamicResource BgRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        IsVisible="{Binding IsFile}">
                  <Grid ColumnDefinitions="Auto,*">
                    <Panel VerticalAlignment="Center" Margin="0,0,10,0">
                      <c:Icon Size="18" Data="{StaticResource IconFile}" Stroke="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsFolder}" />
                      <c:Icon Size="18" Data="{StaticResource IconFolder}" Stroke="{DynamicResource TextMutedBrush}" IsVisible="{Binding IsFolder}" />
                    </Panel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
                      <TextBlock Text="{Binding Kind}" Classes="muted" FontSize="{DynamicResource UiFontSizeSmall}" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Button Theme="{StaticResource RoundButton}"
                        Width="20" Height="20"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Click="OnRemoveAttachmentClick"
                        ToolTip.Tip="Remove">
                  <c:Icon Size="10" Data="{StaticResource IconClose}" />
                </Button>
              </Panel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <c:DashedRule Stroke="{DynamicResource BorderInputBrush}" Margin="10,0" />
        </StackPanel>
        </Border>
        </Border>
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
          <!-- The buttons stay level with the first line while the text grows. -->
          <Button Name="PlusButton"
                  Theme="{StaticResource IconButton}"
                  Margin="7,7,0,0"
                  VerticalAlignment="Top"
                  ToolTip.Tip="More">
            <c:Icon Data="{StaticResource IconPlus}" />
            <Button.Flyout>
              <Flyout Placement="TopEdgeAlignedLeft" FlyoutPresenterClasses="menu">
                <StackPanel MinWidth="200">
                  <Button Theme="{StaticResource MenuItemButton}" Click="OnOpenFolderClick" IsEnabled="{Binding IsNew}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <c:Icon Size="13" Data="{StaticResource IconFolderOpen}" />
                      <TextBlock Text="Open folder…" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Theme="{StaticResource MenuItemButton}" Click="OnAttachFilesClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <c:Icon Size="13" Data="{StaticResource IconFile}" />
                      <TextBlock Text="Attach files…" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Theme="{StaticResource MenuItemButton}" Click="OnSettingsClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <c:Icon Size="13" Data="{StaticResource IconGear}" />
                      <TextBlock Text="Settings" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Border Classes="rule" />
                  <!-- Activity lines: thinking and tool groups between the replies. -->
                  <Button Theme="{StaticResource MenuItemButton}" Command="{Binding ToggleActivityCommand}"
                          ToolTip.Tip="Thinking and tool lines (&quot;Read a file&quot;) between the replies">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="Show activity" VerticalAlignment="Center" />
                      <Border Grid.Column="1" Classes="switch" Classes.on="{Binding ShowActivity}" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Ellipse />
                      </Border>
                    </Grid>
                  </Button>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>

          <TextBox Name="Composer"
                   Grid.Column="1"
                   Theme="{StaticResource BareTextBox}"
                   Text="{Binding ComposerText}"
                   Watermark="{Binding ComposerPlaceholder}"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource UiFontSizeLarge}"
                   MaxHeight="190"
                   Margin="6,11,8,11"
                   VerticalContentAlignment="Top"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" />

          <!-- While Claude works, Send queues the prompt and Stop sits beside it. -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="0,7,8,0" VerticalAlignment="Top">
            <!-- A suggested prompt is showing as ghost text: how to take it. -->
            <Border Classes="keyhint" IsVisible="{Binding HasSuggestion}" VerticalAlignment="Center" Height="20" Padding="6,0" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" ToolTip.Tip="Tab, → or a right-click puts the suggestion in; Esc dismisses it">
              <TextBlock Text="Tab" Classes="muted" FontSize="{DynamicResource UiFontSizeTiny}" VerticalAlignment="Center" />
            </Border>
            <!-- Ctrl held while Claude works: "Send instantly" slides out of the button; Ctrl+click (or Ctrl+Enter) does it. -->
            <Button Name="SendButton"
                    Theme="{StaticResource SendButton}"
                    Width="NaN"
                    MinWidth="28"
                    Command="{Binding SendCommand}"
                    IsVisible="{Binding ShowSendButton}"
                    ToolTip.Tip="{Binding SendToolTip}">
              <StackPanel Orientation="Horizontal">
                <Border Name="SendInstantlyLabel" Width="0" Opacity="0" ClipToBounds="True">
                  <Border.Transitions>
                    <Transitions>
                      <DoubleTransition Property="Width" Duration="0:0:0.3" Easing="CubicEaseOut" />
                      <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseOut" />
                    </Transitions>
                  </Border.Transitions>
                  <TextBlock Text="Send instantly" FontSize="{DynamicResource UiFontSizeSmall}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </Border>
                <c:Icon Width="28" Data="{StaticResource IconSendArrow}" StrokeThickness="1.8" />
              </StackPanel>
            </Button>
            <Button Theme="{StaticResource SendButton}"
                    Classes="stop"
                    Command="{Binding StopCommand}"
                    IsVisible="{Binding IsTurnRunning}"
                    ToolTip.Tip="Stop">
              <c:Icon IsFilled="True" Size="13" Data="{StaticResource IconStopFilled}" />
            </Button>
          </StackPanel>
        </Grid>
        </Grid>
      </Border>
    </StackPanel>

    <!-- Status row -->
    <Grid Grid.Row="3"
          Name="StatusRow"
          Height="44"
          MaxWidth="{DynamicResource ColumnMaxWidth}"
          Margin="32,0"
          ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">

      <StackPanel Orientation="Horizontal">
      <Button Name="FolderChip"
              Theme="{StaticResource ChipButton}"
              Margin="9,0,0,0"
              Click="OnFolderChipClick"
              ToolTip.Tip="{Binding FolderToolTip}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <c:Icon Size="13" Data="{StaticResource IconFolder}" />
          <TextBlock Classes="status" Text="{Binding FolderName}" VerticalAlignment="Center" />
        </StackPanel>
        <FlyoutBase.AttachedFlyout>
          <Flyout Placement="TopEdgeAlignedLeft" FlyoutPresenterClasses="menu">
            <StackPanel Width="250">
              <TextBox Theme="{StaticResource BareTextBox}"
                       Watermark="Search folders…"
                       Text="{Binding FolderFilter}"
                       Height="26"
                       Margin="8,2,8,4"
                       FontSize="{DynamicResource UiFontSize}" />
              <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="-5,0,-5,4" />
              <Button Theme="{StaticResource MenuItemButton}" Click="OnNoFolderClick" ToolTip.Tip="Claude works in a new scratch folder">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="No folder" />
                  <c:Icon Grid.Column="1" Size="13" Data="{StaticResource IconCheck}" Stroke="{DynamicResource CheckBrush}" IsVisible="{Binding IsNoFolder}" />
                </Grid>
              </Button>
              <Border Classes="rule" />
              <TextBlock Text="Recent" Classes="menuheader" />
              <ItemsControl ItemsSource="{Binding MenuFolders}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MenuOption">
                    <Button Theme="{StaticResource MenuItemButton}" Click="OnFolderOptionClick" ToolTip.Tip="{Binding ToolTip}">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                        <c:Icon Grid.Column="1" Size="13" Data="{StaticResource IconCheck}" Stroke="{DynamicResource CheckBrush}" IsVisible="{Binding IsSelected}" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Classes="rule" />
              <Button Theme="{StaticResource MenuItemButton}" Click="OnOpenFolderClick">
                <TextBlock Text="Open folder…" />
              </Button>
            </StackPanel>
          </Flyout>
        </FlyoutBase.AttachedFlyout>
      </Button>

      <!--
        Git, for a folder in a repository. New session: the branch (click to switch it, or with Worktree on to pick the
        one the worktree starts from) and the Worktree switch. A started session shows its branch in the title bar.
      -->
      <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowWorktreeToggle}" Margin="4,0,0,0">
        <Button Name="BranchChip"
                Theme="{StaticResource ChipButton}"
                Click="OnBranchChipClick"
                ToolTip.Tip="{Binding GitChipToolTip}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:Icon Size="13" Data="{StaticResource IconGitBranch}" />
            <TextBlock Classes="status branchtext" Text="{Binding GitChipText}" MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <!-- Unpushed commits: "| ↑ N", the count bold white; its tooltip shows at once. -->
            <StackPanel Classes="ahead" Classes.on="{Binding HasGitAhead}" IsVisible="{Binding HasGitAhead}"
                        Orientation="Horizontal" Spacing="3" Background="Transparent"
                        ToolTip.Tip="{Binding GitAheadToolTip}" ToolTip.ShowDelay="0">
              <TextBlock Classes="status" Text="|" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,3,0" VerticalAlignment="Center" />
              <TextBlock Classes="status" Text="↑" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
              <TextBlock Classes="status" Text="{Binding GitAhead}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <!-- Uncommitted changes in the checkout: "| N changed", as on the project cards. -->
            <StackPanel Classes="ahead" Classes.on="{Binding HasGitChanges}" IsVisible="{Binding HasGitChanges}"
                        Orientation="Horizontal" Background="Transparent"
                        ToolTip.Tip="{Binding GitChangesToolTip}" ToolTip.ShowDelay="0">
              <TextBlock Classes="status" Text="|" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Classes="status" Text="{Binding GitChangesText}" FontWeight="Bold" Foreground="{DynamicResource WaitingBrush}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
          <FlyoutBase.AttachedFlyout>
            <Flyout Placement="TopEdgeAlignedLeft" FlyoutPresenterClasses="menu">
              <StackPanel Width="260">
                <TextBox Theme="{StaticResource BareTextBox}"
                         Watermark="Search branches…"
                         Text="{Binding BranchFilter}"
                         Height="26"
                         Margin="8,2,8,4"
                         FontSize="{DynamicResource UiFontSize}" />
                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="-5,0,-5,4" />
                <TextBlock Text="{Binding BranchMenuHeader}" Classes="menuheader" />
                <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding MenuBranches}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:MenuOption">
                        <Button Theme="{StaticResource MenuItemButton}" Click="OnBranchOptionClick">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Label}" FontFamily="{DynamicResource MonoFont}" TextTrimming="CharacterEllipsis" />
                            <c:Icon Grid.Column="1" Size="13" Data="{StaticResource IconCheck}" Stroke="{DynamicResource CheckBrush}" IsVisible="{Binding IsSelected}" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="{Binding BranchError}" IsVisible="{Binding HasBranchError}" Classes="muted" Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap" FontSize="{DynamicResource UiFontSizeSmall}" Margin="8,4,8,4" />
              </StackPanel>
            </Flyout>
          </FlyoutBase.AttachedFlyout>
        </Button>
        <Button Name="WorktreeToggle"
                Theme="{StaticResource ChipButton}"
                Classes="worktree"
                Classes.on="{Binding UseWorktree}"
                IsVisible="{Binding ShowWorktreeToggle}"
                Click="OnWorktreeClick"
                Margin="2,0,0,0"
                ToolTip.Tip="{Binding WorktreeToolTip}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:Icon Size="13" Data="{StaticResource IconWorktree}" />
            <TextBlock Classes="status branchtext" Text="Worktree" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
      </StackPanel>

      <!-- Remote Control: the phone icon, lit while the session is reachable from claude.ai / the app. -->
      <Button Name="RemoteChip"
              Grid.Column="2"
              Theme="{StaticResource ChipButton}"
              Classes="remote"
              Classes.on="{Binding IsRemoteControl}"
              Classes.connected="{Binding IsRemoteConnected}"
              Margin="4,0,0,0"
              ToolTip.Tip="Remote Control">
        <Panel>
          <c:Icon Size="13" Data="{StaticResource IconPhone}" />
          <Ellipse Classes="remotedot" Width="5" Height="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,-2,0" />
        </Panel>
        <Button.Flyout>
          <Flyout Placement="TopEdgeAlignedLeft" FlyoutPresenterClasses="menu">
            <StackPanel Width="290">
              <TextBlock Text="Remote Control" Classes="menuheader" />
              <Button Theme="{StaticResource MenuItemButton}" Command="{Binding ToggleRemoteControlCommand}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Continue from phone or web" />
                  <Border Grid.Column="1" Classes="switch" Classes.on="{Binding IsRemoteControl}" VerticalAlignment="Center">
                    <Ellipse />
                  </Border>
                </Grid>
              </Button>
              <TextBlock Text="{Binding RemoteControlText}"
                         Classes="muted"
                         TextWrapping="Wrap"
                         FontSize="{DynamicResource UiFontSizeSmall}"
                         Margin="8,2,8,4" />
              <StackPanel IsVisible="{Binding HasRemoteControlUrl}">
                <Border Classes="rule" />
                <Button Theme="{StaticResource MenuItemButton}" Click="OnCopyRemoteLinkClick">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <c:Icon Size="13" Data="{StaticResource IconCopy}" />
                    <TextBlock Text="Copy link" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Theme="{StaticResource MenuItemButton}" Click="OnOpenRemoteLinkClick">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <c:Icon Size="13" Data="{StaticResource IconGlobe}" />
                    <TextBlock Text="Open on claude.ai" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>

      <!-- One chip per model; clicking the current one opens the full picker. -->
      <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2">
        <ItemsControl ItemsSource="{Binding ModelOptions}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MenuOption">
              <Button Theme="{StaticResource ChipButton}"
                      Classes="modelchip"
                      Classes.selected="{Binding IsSelected}"
                      Click="OnModelChipClick"
                      ToolTip.Tip="{Binding ShortcutText, StringFormat='Ctrl+Shift+{0}'}">
                <TextBlock Classes="status" Text="{Binding Label}" VerticalAlignment="Center" />
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Effort: a small slider, Low to Max. -->
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="10,0,4,0" ToolTip.Tip="Effort (Low to Max)">
          <c:FillSlider Name="EffortSlider"
                        Width="168" Height="24"
                        Thickness="16"
                        TickBrush="{DynamicResource SliderTickBrush}"
                        Maximum="4"
                        Value="{Binding EffortPosition}"
                        TrackBrush="{DynamicResource BarTrackBrush}"
                        FillBrush="{DynamicResource RingBrush}"
                        KnobBrush="White"
                        VerticalAlignment="Center" />
          <!-- Fixed width (fits "Extra high"), so the row doesn't shift while dragging. -->
          <TextBlock Text="{Binding EffortLabel}" Classes="status muted effortlabel" Width="72" VerticalAlignment="Center" />
        </StackPanel>

        <Button Name="ModelChip" Theme="{StaticResource ChipButton}" ToolTip.Tip="All models and fast mode">
          <c:Icon Size="12" Data="{StaticResource IconChevronDown}" />
          <Button.Flyout>
            <Flyout Placement="TopEdgeAlignedRight" FlyoutPresenterClasses="menu">
              <StackPanel Width="250">
                <TextBlock Text="Model · this session" Classes="menuheader" />
                <ItemsControl ItemsSource="{Binding ModelOptions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MenuOption">
                      <Button Theme="{StaticResource MenuItemButton}" Click="OnModelOptionClick">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding Label}" />
                          <c:Icon Grid.Column="1" Size="13" Data="{StaticResource IconCheck}" Stroke="{DynamicResource CheckBrush}" IsVisible="{Binding IsSelected}" />
                          <TextBlock Grid.Column="1" Text="{Binding ShortcutText}" Classes="hint" IsVisible="{Binding ShowShortcut}" Margin="0,0,3,0" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Classes="rule" />
                <TextBlock Text="Fast mode" Classes="menuheader" />
                <Button Theme="{StaticResource MenuItemButton}" Command="{Binding ToggleFastModeCommand}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Enable fast mode" />
                    <Border Grid.Column="1" Classes="switch" Classes.on="{Binding FastMode}" VerticalAlignment="Center">
                      <Ellipse />
                    </Border>
                  </Grid>
                </Button>
                <Border Classes="rule" />
                <!-- Permission mode: the current one, with the list in a menu of its own beside this one. -->
                <Button Name="ModeRow" Theme="{StaticResource MenuItemButton}" Click="OnModeRowClick">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Text="Mode" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding ModeName}"
                               Classes="muted"
                               Classes.danger="{Binding IsBypass}"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Right"
                               Margin="12,0,4,0" />
                    <c:Icon Grid.Column="2" Size="12" Data="{StaticResource IconChevronRight}" />
                  </Grid>
                  <FlyoutBase.AttachedFlyout>
                    <Flyout Placement="LeftEdgeAlignedBottom" FlyoutPresenterClasses="menu">
                      <StackPanel Width="310">
                        <TextBlock Text="Mode" Classes="menuheader" />
                        <ItemsControl ItemsSource="{Binding ModeOptions}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MenuOption">
                              <Button Theme="{StaticResource MenuItemButton}" Click="OnModeOptionClick" Padding="8,3">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                  <StackPanel>
                                    <TextBlock Text="{Binding Label}" Classes.danger="{Binding IsDangerSelected}" />
                                    <TextBlock Text="{Binding Description}" Classes="muted" FontSize="{DynamicResource UiFontSizeSmall}" FontWeight="Normal" Margin="0,1,0,0" />
                                  </StackPanel>
                                  <c:Icon Grid.Column="1"
                                        Size="13"
                                        Data="{StaticResource IconCheck}"
                                        Stroke="{DynamicResource CheckBrush}"
                                        IsVisible="{Binding IsSelected}"
                                        VerticalAlignment="Top"
                                        Margin="8,1,0,0" />
                                  <TextBlock Grid.Column="2"
                                             Text="{Binding ShortcutText}"
                                             Classes="hint"
                                             VerticalAlignment="Top"
                                             Margin="8,1,0,0" />
                                </Grid>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Flyout>
                  </FlyoutBase.AttachedFlyout>
                </Button>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </StackPanel>

      <!-- The ring shows the context window; clicking it opens the plan usage limits. -->
      <Button Name="UsageChip"
              Grid.Column="5"
              Theme="{StaticResource ChipButton}"
              Padding="0"
              Classes.off="{Binding !ShowUsageRing}"
              ClipToBounds="True"
              HorizontalContentAlignment="Center">
        <!-- The weekly plan limit: how much is used, and when it resets. -->
        <ToolTip.Tip>
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding Usage.WeeklyText}" IsVisible="{Binding Usage.HasWeekly}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" />
            <TextBlock Text="{Binding Usage.WeeklyResetsText}" IsVisible="{Binding Usage.HasWeeklyResets}" Classes="muted" />
            <TextBlock Text="Plan usage limits" IsVisible="{Binding !Usage.HasWeekly}" />
          </StackPanel>
        </ToolTip.Tip>
        <c:Ring Width="17" Height="17"
                StrokeWidth="2"
                Fraction="{Binding Usage.WeeklyFraction}"
                TrackBrush="{DynamicResource RingTrackBrush}"
                ArcBrush="{DynamicResource RingBrush}"
                SpinBrush="{DynamicResource RingBrush}"
                VerticalAlignment="Center">
          <c:Ring.Transitions>
            <Transitions>
              <DoubleTransition Property="Fraction" Duration="0:0:0.25" Easing="CubicEaseOut" />
            </Transitions>
          </c:Ring.Transitions>
          <!-- The plan usage not read yet: a faint arc circles until it is (hidden, it doesn't). -->
          <c:Ring.IsPending>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="Usage.IsLoading" />
              <Binding Path="ShowUsageRing" />
            </MultiBinding>
          </c:Ring.IsPending>
          <!-- Hidden, it doesn't spin either. -->
          <c:Ring.IsSpinning>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="IsTurnRunning" />
              <Binding Path="ShowUsageRing" />
            </MultiBinding>
          </c:Ring.IsSpinning>
        </c:Ring>
        <Button.Flyout>
          <Flyout Placement="TopEdgeAlignedRight" FlyoutPresenterClasses="menu">
            <StackPanel Classes="usage" Background="Transparent" Width="320" Margin="8,4,8,6" Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Usage.Title}" Classes="muted" FontSize="{DynamicResource UiFontSizeSmall}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Theme="{StaticResource LineButton}" Click="OnUsagePageClick" Foreground="{DynamicResource TextPrimaryBrush}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="See all" FontWeight="Medium" FontSize="{DynamicResource UiFontSizeSmall}" />
                    <c:Icon Size="11" Data="{StaticResource IconArrowRight}" />
                  </StackPanel>
                </Button>
              </Grid>
              <c:Skeleton IsActive="{Binding Usage.IsLoading}" Rows="3" RowHeight="8" RowSpacing="16" Widths="0.9,0.7,0.8" Fill="{DynamicResource SkeletonBrush}" />
              <ItemsControl ItemsSource="{Binding Usage.Rows}" IsVisible="{Binding Usage.HasUsage}" ItemTemplate="{StaticResource UsageRowTemplate}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="11" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
              <TextBlock Text="Plan usage needs a claude.ai sign-in in Claude Code."
                         Classes="muted"
                         TextWrapping="Wrap"
                         FontSize="{DynamicResource UiFontSizeSmall}"
                         IsVisible="{Binding Usage.IsUnavailable}" />
              <ContentControl Content="{Binding Usage}"
                              ContentTemplate="{StaticResource UsageStaleTemplate}"
                              Margin="0,8,0,0"
                              IsVisible="{Binding Usage.IsStale}" />
              <Border Classes="rule" Margin="-8,0" />
              <TextBlock Text="{Binding ContextToolTip}" Classes="muted" FontSize="{DynamicResource UiFontSizeTiny}" />
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
    </Grid>

    <!-- A subagent's conversation (from the side panel), over the transcript and composer. Esc or ← goes back. -->
    <Border Grid.RowSpan="4"
            Classes="subagent"
            Classes.open="{Binding HasOpenSubagent}"
            Background="{DynamicResource BgMainBrush}">
      <Border.Styles>
        <Style Selector="Border.subagent">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="IsHitTestVisible" Value="False" />
          <Setter Property="Transitions">
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="Border.subagent.open">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
      </Border.Styles>
      <Grid RowDefinitions="Auto,*" DataContext="{Binding OpenSubagent}" x:DataType="vm:SubagentViewModel">
        <Grid ColumnDefinitions="Auto,*,Auto" MaxWidth="{DynamicResource ColumnMaxWidth}" Margin="32,10,32,8">
          <Button Theme="{StaticResource IconButton}" Click="OnCloseSubagentClick" ToolTip.Tip="Back to the session (Esc)">
            <c:Icon Data="{StaticResource IconArrowLeft}" />
          </Button>
          <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center" Spacing="1">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Description}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="{DynamicResource UiFontSizeLarge}" />
              <Border IsVisible="{Binding HasAgentType}" Background="{DynamicResource BgChipBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                <TextBlock Text="{Binding AgentType}" FontSize="{DynamicResource UiFontSizeTiny}" Foreground="{DynamicResource TextChromeBrush}" />
              </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Subagent" Classes="muted" FontSize="{DynamicResource UiFontSizeSmall}" />
              <TextBlock Text="·" Classes="muted" FontSize="{DynamicResource UiFontSizeSmall}" />
              <TextBlock Text="{Binding DurationText}" Classes="muted" FontSize="{DynamicResource UiFontSizeSmall}" />
              <TextBlock Text="·" Classes="muted" FontSize="{DynamicResource UiFontSizeSmall}" />
              <TextBlock Text="{Binding LastStatus}" Classes="muted" FontSize="{DynamicResource UiFontSizeSmall}" TextTrimming="CharacterEllipsis" MaxWidth="500" />
            </StackPanel>
          </StackPanel>
          <c:Ring Grid.Column="2" Width="14" Height="14" StrokeWidth="1.8" IsSpinning="{Binding IsRunning}" IsVisible="{Binding IsRunning}"
                  TrackBrush="{DynamicResource RingTrackBrush}" SpinBrush="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
        </Grid>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" c:SelectionAssist.IsEnabled="True">
          <StackPanel MaxWidth="{DynamicResource ColumnMaxWidth}" Margin="46,6,42,24" Spacing="14">
            <!-- What it was asked. -->
            <Border Background="{DynamicResource BgRaisedBrush}" CornerRadius="10" Padding="12,8" HorizontalAlignment="Right" MaxWidth="900">
              <SelectableTextBlock Text="{Binding Prompt}" TextWrapping="Wrap" FontSize="{DynamicResource BodyFontSize}"
                                   LineHeight="{DynamicResource BodyLineHeight}" Foreground="{DynamicResource TextPrimaryBrush}" />
            </Border>
            <ItemsControl ItemsSource="{Binding Entries}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.DataTemplates>
                <DataTemplate x:DataType="vm:ToolCallItem">
                  <StackPanel>
                    <Button Theme="{StaticResource FlatButton}" Command="{Binding ToggleCommand}" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" Padding="6,0" Height="28" Foreground="{DynamicResource TextChromeBrush}">
                      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                        <c:Icon Data="{Binding IconKey, Converter={x:Static inf:IconConverter.Instance}}" Stroke="{DynamicResource TextMutedBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="{DynamicResource UiFontSizeSmall}" FontWeight="Medium" Margin="8,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Summary}" FontSize="{DynamicResource UiFontSizeSmall}" Classes.mono="{Binding SummaryIsCode}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Panel Grid.Column="3" Width="16" Height="16" Margin="8,0,2,0">
                          <c:Ring Width="12" Height="12" StrokeWidth="1.5" IsSpinning="{Binding IsRunning}" IsVisible="{Binding IsRunning}"
                                  TrackBrush="{DynamicResource RingTrackBrush}" SpinBrush="{DynamicResource AccentBrush}" />
                          <c:Icon Data="{StaticResource IconCheck}" Stroke="{DynamicResource TextMutedBrush}" IsVisible="{Binding IsDone}" />
                          <c:Icon Data="{StaticResource IconClose}" Stroke="{DynamicResource DangerBrush}" IsVisible="{Binding IsFailed}" />
                        </Panel>
                      </Grid>
                    </Button>
                    <Border c:Fold.IsOpen="{Binding IsExpanded}" IsVisible="False" Margin="30,2,0,6" Background="{DynamicResource BgCodeBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                      <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12,10" Spacing="8">
                          <SelectableTextBlock Text="{Binding InputText}" Classes="mono" Foreground="{DynamicResource TextChromeBrush}" />
                          <Border Height="1" Background="{DynamicResource BorderBrush}" IsVisible="{Binding HasResult}" />
                          <SelectableTextBlock Text="{Binding ResultText}" Classes="mono" IsVisible="{Binding HasResult}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                      </ScrollViewer>
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.DataTemplates>
            </ItemsControl>
            <!-- Its answer, as the main agent got it. -->
            <StackPanel IsVisible="{Binding HasResult}" Spacing="6">
              <TextBlock Text="Returned" Classes="muted" FontSize="{DynamicResource UiFontSizeSmall}" />
              <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2,0,0,0" Padding="12,0,0,0">
                <md:MarkdownView Markdown="{Binding ResultText}" />
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- An image, big: from a composer thumbnail or a sent prompt. A click or Esc closes it; ← → step through. -->
    <Panel Name="ImagePreview" Grid.RowSpan="4" Background="Transparent" PointerPressed="OnImagePreviewPressed">
      <!-- The dimmed backdrop, its upper right corner rounded where it meets the title bar. -->
      <Border Background="#D90A0A0A" CornerRadius="0,8,0,0" />
      <StackPanel Classes="frame" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="48">
        <Border CornerRadius="8" ClipToBounds="True" BoxShadow="0 8 32 0 #80000000" HorizontalAlignment="Center">
          <Image Name="PreviewImage" Stretch="Uniform" StretchDirection="DownOnly" />
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <TextBlock Name="PreviewName" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="{DynamicResource UiFontSizeSmall}" />
          <TextBlock Name="PreviewMeta" Classes="muted" FontSize="{DynamicResource UiFontSizeSmall}" />
          <Button Theme="{StaticResource LineButton}" Click="OnCopyPreviewClick" Margin="8,0,0,0" ToolTip.Tip="Copy the image (Ctrl+C)">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <c:Icon Size="12" Data="{StaticResource IconCopy}" />
              <TextBlock Name="PreviewCopyText" Text="Copy image" FontSize="{DynamicResource UiFontSizeSmall}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
    </Panel>
  </Grid>
</UserControl>
