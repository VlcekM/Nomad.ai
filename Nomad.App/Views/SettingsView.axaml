<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nomad.App.ViewModels"
             xmlns:inf="using:Nomad.App.Infrastructure"
             xmlns:c="using:Nomad.App.Controls"
             xmlns:agents="using:Nomad.Core.Agents"
             xmlns:oc="using:Nomad.Core.OpenCode"
             xmlns:md="using:Nomad.App.Markdown"
             x:Class="Nomad.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Focusable="True">

  <!-- Flat combo boxes: text + chevron, like the original's font pickers. -->
  <UserControl.Resources>
    <SolidColorBrush x:Key="ComboBoxBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="Transparent" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="Transparent" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBlock.pagetitle">
      <Setter Property="FontSize" Value="{DynamicResource UiFontSizeTitle}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="TextBlock.rowlabel">
      <Setter Property="FontSize" Value="{DynamicResource UiFontSizeLarge}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.rowhint">
      <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
    <Style Selector="Grid.row">
      <Setter Property="MinHeight" Value="56" />
    </Style>
    <Style Selector="Border.rowline">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource BgSegmentsBrush}" />
    </Style>
    <Style Selector="Border.segments">
      <Setter Property="Background" Value="{DynamicResource BgSegmentsBrush}" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinWidth" Value="200" />
      <Setter Property="HorizontalContentAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
      <Setter Property="MaxDropDownHeight" Value="420" />
    </Style>
    <!-- Color theme editor: a swatch, the token's name and its hex value; reset shows once it differs from Nomad's. -->
    <Style Selector="TextBlock.colorgroup">
      <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSmall}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBlock.colorlabel">
      <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
    <Style Selector="Border.swatch">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderInputBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <!-- The color theme picker's dots: a theme's background, accent and focus colors. -->
    <Style Selector="Ellipse.themedot">
      <Setter Property="Width" Value="11" />
      <Setter Property="Height" Value="11" />
      <Setter Property="Stroke" Value="{DynamicResource BorderInputBrush}" />
      <Setter Property="StrokeThickness" Value="1" />
    </Style>
    <Style Selector="Border.swatch:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="Button.reset">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.reset.changed">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <!-- Updates page: the status line's colours, release markers and the chevron of a release. -->
    <Style Selector="TextBlock.rowhint.attention">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBlock.rowhint.failed">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Border.tag">
      <Setter Property="Background" Value="{DynamicResource BgSegmentsBrush}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,1,6,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.tag > TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSmall}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Border.tag.installed">
      <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    </Style>
    <Style Selector="Border.tag.installed > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.tag.newer">
      <Setter Property="Background" Value="{DynamicResource LinkSubtleBrush}" />
    </Style>
    <Style Selector="Border.tag.newer > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
    </Style>
    <Style Selector="c|Icon.chev">
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
    </Style>
    <Style Selector="c|Icon.chev.open">
      <Setter Property="RenderTransform" Value="rotate(90deg)" />
    </Style>
    <!-- A page fades in and rises a little into place as it is shown. -->
    <Style Selector="StackPanel.page[IsVisible=True]">
      <Style.Animations>
        <Animation Duration="0:0:0.2" Easing="CubicEaseOut">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="8" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Border.field">
      <Setter Property="Background" Value="{DynamicResource BgFieldBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderFieldBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Height" Value="31" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.field.compact">
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="8,0" />
    </Style>
    <!-- Coding agents: sign-in badge, browser login progress box and OpenCode provider chips. -->
    <Style Selector="Border.authpill">
      <Setter Property="Background" Value="{DynamicResource BgSegmentsBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderCardBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseOut" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.authpill.signedin">
      <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.authpanel">
      <Setter Property="Background" Value="{DynamicResource BgRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,6,0,4" />
    </Style>
    <Style Selector="Border.providerchip">
      <Setter Property="Background" Value="{DynamicResource BgChipBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,2,4,2" />
      <Setter Property="Margin" Value="0,0,6,4" />
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource BgSettingsBrush}"
          BorderBrush="{DynamicResource BorderSettingsBrush}"
          BorderThickness="1"
          CornerRadius="12"
          MaxWidth="1278"
          MaxHeight="935"
          Margin="24,48"
          ClipToBounds="True"
          BoxShadow="0 16 48 0 #59000000">
    <Grid ColumnDefinitions="211,*">

      <!-- Navigation -->
      <Border Background="{DynamicResource BgMainBrush}" BorderBrush="{DynamicResource BorderCardBrush}" BorderThickness="0,0,1,0">
        <StackPanel Margin="12,0" Spacing="1">
          <TextBlock Text="Settings" Classes="section" FontSize="{DynamicResource UiFontSizeSmall}" Margin="8,30,0,10" />
          <Button Theme="{StaticResource NavButton}" Classes.selected="{Binding IsGeneralPage}"
                  Command="{Binding ShowPageCommand}" CommandParameter="{x:Static vm:SettingsPageKind.General}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <c:Icon Data="{StaticResource IconGear}" />
              <TextBlock Text="General" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Theme="{StaticResource NavButton}" Classes.selected="{Binding IsAppearancePage}"
                  Command="{Binding ShowPageCommand}" CommandParameter="{x:Static vm:SettingsPageKind.Appearance}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <c:Icon Data="{StaticResource IconSliders}" />
              <TextBlock Text="Appearance" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Theme="{StaticResource NavButton}" Classes.selected="{Binding IsFilesPage}"
                  Command="{Binding ShowPageCommand}" CommandParameter="{x:Static vm:SettingsPageKind.Files}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <c:Icon Data="{StaticResource IconFiles}" />
              <TextBlock Text="Files" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Theme="{StaticResource NavButton}" Classes.selected="{Binding IsAgentsPage}"
                  Command="{Binding ShowPageCommand}" CommandParameter="{x:Static vm:SettingsPageKind.Agents}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <c:Icon Data="{StaticResource IconAgent}" />
              <TextBlock Text="Agents" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Theme="{StaticResource NavButton}" Classes.selected="{Binding IsRemoteControlPage}"
                  Command="{Binding ShowPageCommand}" CommandParameter="{x:Static vm:SettingsPageKind.RemoteControl}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <c:Icon Data="{StaticResource IconPhone}" />
              <TextBlock Text="Remote Control" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Theme="{StaticResource NavButton}" Classes.selected="{Binding IsHubPage}"
                  Command="{Binding ShowPageCommand}" CommandParameter="{x:Static vm:SettingsPageKind.Hub}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <c:Icon Data="{StaticResource IconGlobe}" />
              <TextBlock Text="Hub" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Theme="{StaticResource NavButton}" Classes.selected="{Binding IsUpdatesPage}"
                  Command="{Binding ShowPageCommand}" CommandParameter="{x:Static vm:SettingsPageKind.Updates}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <c:Icon Data="{StaticResource IconUpdate}" />
              <TextBlock Text="Updates" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <!-- Pages -->
      <Panel Grid.Column="1">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Panel Margin="24,58,34,32">

            <!-- General: the window, old sessions -->
            <StackPanel Classes="page" IsVisible="{Binding IsGeneralPage}">
              <StackPanel.RenderTransform><TranslateTransform /></StackPanel.RenderTransform>
              <TextBlock Text="Window" Classes="pagetitle" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Close to the tray" Classes="rowlabel" />
                  <TextBlock Text="Closing the window keeps Nomad.ai running in the notification area, sessions and all. Click its icon to bring it back; Exit (in the menu or the icon's) quits."
                             Classes="rowhint" />
                </StackPanel>
                <Button Grid.Column="1"
                        Theme="{StaticResource FlatButton}"
                        Padding="6"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleCloseToTrayCommand}">
                  <Border Classes="switch large" Classes.on="{Binding CloseToTray}">
                    <Ellipse />
                  </Border>
                </Button>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Notifications" Classes="rowlabel" />
                  <TextBlock Text="A Windows notification when a session finishes or needs an answer while Nomad.ai is in the background. Click it to come back."
                             Classes="rowhint" />
                </StackPanel>
                <Button Grid.Column="1" Theme="{StaticResource FlatButton}" Padding="6" VerticalAlignment="Center" Command="{Binding ToggleNotifyWhenDoneCommand}">
                  <Border Classes="switch large" Classes.on="{Binding NotifyWhenDone}">
                    <Ellipse />
                  </Border>
                </Button>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Flash the taskbar" Classes="rowlabel" />
                  <TextBlock Text="The taskbar button flashes then too, until you bring the window up." Classes="rowhint" />
                </StackPanel>
                <Button Grid.Column="1" Theme="{StaticResource FlatButton}" Padding="6" VerticalAlignment="Center" Command="{Binding ToggleFlashTaskbarCommand}">
                  <Border Classes="switch large" Classes.on="{Binding FlashTaskbar}">
                    <Ellipse />
                  </Border>
                </Button>
              </Grid>

              <TextBlock Text="Sessions" Classes="pagetitle" Margin="0,40,0,10" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Archive old sessions" Classes="rowlabel" />
                  <TextBlock Text="Archive sessions left untouched for a while. Alive and open ones are kept; &quot;Show archived&quot; in the sidebar lists them again."
                             Classes="rowhint" />
                </StackPanel>
                <Button Grid.Column="1"
                        Theme="{StaticResource FlatButton}"
                        Padding="6"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleAutoArchiveCommand}">
                  <Border Classes="switch large" Classes.on="{Binding AutoArchive}">
                    <Ellipse />
                  </Border>
                </Button>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto" IsEnabled="{Binding AutoArchive}">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Archive after" Classes="rowlabel" />
                  <TextBlock Text="Hours without activity before a session is archived (at least 1)." Classes="rowhint" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Border Classes="field" Width="72">
                    <TextBox Theme="{StaticResource BareTextBox}" Text="{Binding AutoArchiveHoursText}" Watermark="24" TextAlignment="Right" FontSize="{DynamicResource UiFontSize}" />
                  </Border>
                  <TextBlock Text="hours" Classes="rowhint" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="End quiet sessions" Classes="rowlabel" />
                  <TextBlock Text="End the process of a session left quiet for a while; it moves to Idle and resumes when you send it something. Turn off to keep every session running until you end it. Pinned sessions, and ones with background work, are never ended."
                             Classes="rowhint" />
                </StackPanel>
                <Button Grid.Column="1"
                        Theme="{StaticResource FlatButton}"
                        Padding="6"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleSleepIdleCommand}">
                  <Border Classes="switch large" Classes.on="{Binding SleepIdle}">
                    <Ellipse />
                  </Border>
                </Button>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto" IsEnabled="{Binding SleepIdle}">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="End after" Classes="rowlabel" />
                  <TextBlock Text="Hours without activity before a session's process is ended (at least 1)." Classes="rowhint" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Border Classes="field" Width="72">
                    <TextBox Theme="{StaticResource BareTextBox}" Text="{Binding SleepAfterHoursText}" Watermark="1" TextAlignment="Right" FontSize="{DynamicResource UiFontSize}" />
                  </Border>
                  <TextBlock Text="hours" Classes="rowhint" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>

              <TextBlock Classes="rowhint" Margin="0,28,0,0" FontSize="{DynamicResource UiFontSizeSmall}">
                <Run Text="Settings are saved to" />
                <Run Text="{Binding SettingsPath}" FontFamily="{DynamicResource MonoFont}" />
              </TextBlock>
            </StackPanel>

            <!-- Appearance: colors, text, layout -->
            <StackPanel Classes="page" IsVisible="{Binding IsAppearancePage}">
              <StackPanel.RenderTransform><TranslateTransform /></StackPanel.RenderTransform>
              <TextBlock Text="Theme" Classes="pagetitle" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Theme" Classes="rowlabel" />
                  <TextBlock Text="System follows the Windows app mode." Classes="rowhint" />
                </StackPanel>
                <Border Grid.Column="1" Classes="segments">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="Theme" IsChecked="{Binding IsThemeDark}" Content="Dark" />
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="Theme" IsChecked="{Binding IsThemeLight}" Content="Light" />
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="Theme" IsChecked="{Binding IsThemeSystem}" Content="System" />
                  </StackPanel>
                </Border>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12,16,12">
                  <TextBlock Text="Color theme" Classes="rowlabel" />
                  <TextBlock Text="Nomad and its presets are built in. Duplicate a theme to make one of your own and change its colors, or import one exported as JSON."
                             Classes="rowhint" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <ComboBox ItemsSource="{Binding ColorThemes}" SelectedItem="{Binding SelectedColorTheme}" MinWidth="160">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ThemeChoice">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <StackPanel Orientation="Horizontal" Spacing="-3" VerticalAlignment="Center">
                            <Ellipse Classes="themedot" Fill="{Binding Background}" />
                            <Ellipse Classes="themedot" Fill="{Binding Accent}" />
                            <Ellipse Classes="themedot" Fill="{Binding Focus}" />
                          </StackPanel>
                          <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Theme="{StaticResource LineButton}" Command="{Binding DuplicateThemeCommand}" VerticalAlignment="Center"
                          Foreground="{DynamicResource TextPrimaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <c:Icon Size="13" Data="{StaticResource IconCopy}" />
                      <TextBlock Text="Duplicate" FontWeight="Medium" />
                    </StackPanel>
                  </Button>
                  <Button Theme="{StaticResource LineButton}" Click="OnImportThemeClick" VerticalAlignment="Center"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          ToolTip.Tip="Add a theme from a JSON file">
                    <TextBlock Text="Import…" FontWeight="Medium" />
                  </Button>
                  <Button Theme="{StaticResource LineButton}" Click="OnExportThemeClick" VerticalAlignment="Center"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          ToolTip.Tip="Save this theme as a JSON file">
                    <TextBlock Text="Export…" FontWeight="Medium" />
                  </Button>
                  <Button Theme="{StaticResource IconButton}" Command="{Binding DeleteThemeCommand}" VerticalAlignment="Center"
                          IsVisible="{Binding IsCustomTheme}"
                          ToolTip.Tip="Delete this theme (to the Recycle Bin)">
                    <c:Icon Size="13" Data="{StaticResource IconClose}" />
                  </Button>
                </StackPanel>
              </Grid>

              <!-- Why an import or export failed. -->
              <TextBlock Classes="rowhint failed" Text="{Binding ThemeFileProblem}" Margin="0,0,0,12"
                         c:Fold.IsOpen="{Binding ThemeFileProblem, Converter={x:Static ObjectConverters.IsNotNull}}" IsVisible="False" />

              <!-- A custom theme's name and colors, folding open under its picker. -->
              <StackPanel c:Fold.IsOpen="{Binding IsCustomTheme}" IsVisible="False">
                <Border Classes="rowline" />
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <TextBlock Text="Theme name" Classes="rowlabel" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Classes="field" Width="240">
                    <TextBox Theme="{StaticResource BareTextBox}" Text="{Binding ThemeName}" Watermark="Name" FontSize="{DynamicResource UiFontSize}" />
                  </Border>
                </Grid>
                <Border Classes="rowline" />
                <StackPanel Margin="0,12,0,4">
                  <TextBlock Text="Colors" Classes="rowlabel" />
                  <TextBlock Text="{Binding ThemeColorsHint}" Classes="rowhint" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding ThemeColorGroups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ThemeColorGroup">
                      <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="{Binding Title}" Classes="colorgroup" />
                        <ItemsControl ItemsSource="{Binding Colors}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ThemeColorRow">
                              <Grid ColumnDefinitions="Auto,*,Auto,26" Margin="0,3,16,3">
                                <Border Classes="swatch" Background="{Binding Swatch}" PointerPressed="OnSwatchPressed" ToolTip.Tip="Pick a color">
                                  <FlyoutBase.AttachedFlyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="menu">
                                      <c:ColorPad Color="{Binding Color}" Margin="5" />
                                    </Flyout>
                                  </FlyoutBase.AttachedFlyout>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Label}" Classes="colorlabel" />
                                <Border Grid.Column="2" Classes="field" Width="96" Height="26" Padding="8,0">
                                  <TextBox Theme="{StaticResource BareTextBox}" Text="{Binding Hex}" MaxLength="9" FontSize="{DynamicResource UiFontSizeSmall}" />
                                </Border>
                                <Button Grid.Column="3" Theme="{StaticResource IconButton}" Classes="reset" Classes.changed="{Binding IsChanged}"
                                        Command="{Binding ResetCommand}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                        ToolTip.Tip="{Binding ResetToolTip}">
                                  <c:Icon Size="12" Data="{StaticResource IconRewind}" />
                                </Button>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <TextBlock Text="Text" Classes="pagetitle" Margin="0,40,0,10" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Interface font" Classes="rowlabel" />
                  <TextBlock Text="Font for the whole interface — menus, sidebar and transcript." Classes="rowhint" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding UiFonts}" SelectedItem="{Binding InterfaceFont}" />
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Code font" Classes="rowlabel" />
                  <TextBlock Text="Used for code blocks, inline code and tool details." Classes="rowhint" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding CodeFonts}" SelectedItem="{Binding CodeFont}" />
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <TextBlock Text="Interface text size" Classes="rowlabel" VerticalAlignment="Center" />
                <Border Grid.Column="1" Classes="segments">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="UiTextSize" IsChecked="{Binding IsUiTextSmall}" Content="Small" />
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="UiTextSize" IsChecked="{Binding IsUiTextMedium}" Content="Medium" />
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="UiTextSize" IsChecked="{Binding IsUiTextLarge}" Content="Large" />
                  </StackPanel>
                </Border>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <TextBlock Text="Transcript text size" Classes="rowlabel" VerticalAlignment="Center" />
                <Border Grid.Column="1" Classes="segments">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="TextSize" IsChecked="{Binding IsTextSmall}" Content="Small" />
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="TextSize" IsChecked="{Binding IsTextMedium}" Content="Medium" />
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="TextSize" IsChecked="{Binding IsTextLarge}" Content="Large" />
                  </StackPanel>
                </Border>
              </Grid>

              <TextBlock Text="Layout" Classes="pagetitle" Margin="0,40,0,10" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Transcript width" Classes="rowlabel" />
                  <TextBlock Text="Maximum width of the transcript and composer columns." Classes="rowhint" />
                </StackPanel>
                <Border Grid.Column="1" Classes="segments">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="Width" IsChecked="{Binding IsWidthNarrow}" Content="Narrow" />
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="Width" IsChecked="{Binding IsWidthMedium}" Content="Medium" />
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="Width" IsChecked="{Binding IsWidthWide}" Content="Wide" />
                  </StackPanel>
                </Border>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Compact model picker" Classes="rowlabel" />
                  <TextBlock Text="The status row shows only the current model. The other models and the effort slider are in its menu."
                             Classes="rowhint" />
                </StackPanel>
                <Button Grid.Column="1" Theme="{StaticResource FlatButton}" Padding="6" VerticalAlignment="Center" Command="{Binding ToggleCompactModelPickerCommand}">
                  <Border Classes="switch large" Classes.on="{Binding CompactModelPicker}">
                    <Ellipse />
                  </Border>
                </Button>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Usage ring" Classes="rowlabel" />
                  <TextBlock Text="The ring at the end of the status row: your weekly plan usage, spinning while an agent works. Click it for the usage limits."
                             Classes="rowhint" />
                </StackPanel>
                <Button Grid.Column="1" Theme="{StaticResource FlatButton}" Padding="6" VerticalAlignment="Center" Command="{Binding ToggleShowUsageRingCommand}">
                  <Border Classes="switch large" Classes.on="{Binding ShowUsageRing}">
                    <Ellipse />
                  </Border>
                </Button>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Usage on new sessions" Classes="rowlabel" />
                  <TextBlock Text="Show your chosen usage cards above recent projects."
                             Classes="rowhint" />
                </StackPanel>
                <Button Grid.Column="1" Theme="{StaticResource FlatButton}" Padding="6" VerticalAlignment="Center" Command="{Binding ToggleShowNewSessionUsageCommand}">
                  <Border Classes="switch large" Classes.on="{Binding ShowNewSessionUsage}">
                    <Ellipse />
                  </Border>
                </Button>
              </Grid>
            </StackPanel>

            <!-- Files: the Files view and its editor -->
            <StackPanel Classes="page" IsVisible="{Binding IsFilesPage}">
              <StackPanel.RenderTransform><TranslateTransform /></StackPanel.RenderTransform>
              <TextBlock Text="Files view" Classes="pagetitle" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Files view" Classes="rowlabel" />
                  <TextBlock Text="Chats can switch to their folder's files and a code editor. Off: the Chat / Files switch is hidden and chats are chat only."
                             Classes="rowhint" />
                </StackPanel>
                <Button Grid.Column="1" Theme="{StaticResource FlatButton}" Padding="6" VerticalAlignment="Center" Command="{Binding ToggleFilesViewEnabledCommand}">
                  <Border Classes="switch large" Classes.on="{Binding FilesViewEnabled}">
                    <Ellipse />
                  </Border>
                </Button>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto" IsEnabled="{Binding FilesViewEnabled}">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Folder tree on the right" Classes="rowlabel" />
                  <TextBlock Text="In a chat's Files view, the folder tree is on the right and the open file on the left. Off: the other way round."
                             Classes="rowhint" />
                </StackPanel>
                <Button Grid.Column="1" Theme="{StaticResource FlatButton}" Padding="6" VerticalAlignment="Center" Command="{Binding ToggleFileTreeOnRightCommand}">
                  <Border Classes="switch large" Classes.on="{Binding FileTreeOnRight}">
                    <Ellipse />
                  </Border>
                </Button>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto" IsEnabled="{Binding FilesViewEnabled}">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Chat / Files key" Classes="rowlabel" />
                  <TextBlock Text="Switches a chat between its conversation and its Files view. Click, then press the key to use (Esc keeps the current one). In the composer, Tab still completes a / command or takes a suggestion first."
                             Classes="rowhint" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <Button Theme="{StaticResource FlatButton}"
                          Padding="4"
                          IsVisible="{Binding IsFilesViewKeyChanged}"
                          Command="{Binding ResetFilesKeyCommand}"
                          ToolTip.Tip="Back to Tab">
                    <c:Icon Size="13" Data="{StaticResource IconRewind}" />
                  </Button>
                  <Button Theme="{StaticResource FlatButton}"
                          MinWidth="96"
                          Padding="12,5"
                          HorizontalContentAlignment="Center"
                          Background="{DynamicResource BgButtonBrush}"
                          BorderBrush="{DynamicResource BorderInputBrush}"
                          BorderThickness="1"
                          Classes.capturing="{Binding IsCapturingFilesKey}"
                          Command="{Binding CaptureFilesKeyCommand}">
                    <TextBlock Text="{Binding FilesViewKeyText}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource UiFontSizeSmall}" />
                  </Button>
                </StackPanel>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto" IsEnabled="{Binding FilesViewEnabled}">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Editor text size" Classes="rowlabel" />
                  <TextBlock Text="Size of the code in the Files view's editor, in points." Classes="rowhint" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding EditorFontSizes}" SelectedItem="{Binding EditorFontSize}" />
              </Grid>
            </StackPanel>

            <!-- Agents: the CLIs, subscription sign-in, new sessions' defaults, models -->
            <StackPanel Classes="page" IsVisible="{Binding IsAgentsPage}">
              <StackPanel.RenderTransform><TranslateTransform /></StackPanel.RenderTransform>
              <TextBlock Text="Coding agents" Classes="pagetitle" />
              <TextBlock Text="Sign in to each CLI with your subscription in the browser, or point Nomad.ai at a custom executable path."
                         Classes="rowhint" Margin="0,-4,0,14" />

              <ItemsControl ItemsSource="{Binding AgentAccounts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AgentAccountViewModel">
                    <StackPanel>
                      <!-- Header: logo, name, live status pill, and sign-in / sign-out actions -->
                      <Grid ColumnDefinitions="*,Auto" Margin="0,14,0,0">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <c:AgentLogo Backend="{Binding BackendId}" Size="16" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Name}" Classes="rowlabel" VerticalAlignment="Center" />
                            <Border Classes="authpill"
                                    Classes.signedin="{Binding IsSignedIn}"
                                    IsVisible="{Binding ShowStatusBadge}"
                                    ToolTip.Tip="{Binding AuthDetail}">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <c:PixelSpinner Width="10" Height="10"
                                                Foreground="{DynamicResource TextMutedBrush}"
                                                IsVisible="{Binding IsChecking}"
                                                VerticalAlignment="Center" />
                                <Ellipse Width="6" Height="6"
                                         Fill="{DynamicResource SuccessBrush}"
                                         IsVisible="{Binding IsSignedIn}"
                                         VerticalAlignment="Center" />
                                <Ellipse Width="6" Height="6"
                                         Fill="{DynamicResource TextMutedBrush}"
                                         IsVisible="{Binding IsSignedOutBadge}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding AuthSummary}"
                                           FontSize="{DynamicResource UiFontSizeSmall}"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           IsVisible="{Binding IsSignedIn}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding AuthSummary}"
                                           FontSize="{DynamicResource UiFontSizeSmall}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           IsVisible="{Binding !IsSignedIn}"
                                           VerticalAlignment="Center" />
                              </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding AuthDetail}"
                                       IsVisible="{Binding HasAuthDetail}"
                                       FontSize="{DynamicResource UiFontSizeSmall}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="280"
                                       VerticalAlignment="Center" />
                          </StackPanel>
                          <TextBlock Text="{Binding Description}" Classes="rowhint" Margin="24,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <Button Theme="{StaticResource PrimaryButton}"
                                  IsVisible="{Binding ShowPrimarySignIn}"
                                  Command="{Binding SignInCommand}"
                                  ToolTip.Tip="{Binding SignInToolTip}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="{Binding SignInButtonText}" VerticalAlignment="Center" />
                              <c:Icon Size="12" Data="{StaticResource IconExternalLink}" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                          <Button Theme="{StaticResource SecondaryButton}"
                                  IsVisible="{Binding ShowSecondarySignIn}"
                                  Command="{Binding SignInCommand}"
                                  ToolTip.Tip="{Binding SignInToolTip}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="{Binding SignInButtonText}" VerticalAlignment="Center" />
                              <c:Icon Size="12" Data="{StaticResource IconExternalLink}"
                                      IsVisible="{Binding !IsProviderPickerOpen}"
                                      VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                          <Button Theme="{StaticResource GhostButton}"
                                  Classes="danger"
                                  IsVisible="{Binding ShowSignOut}"
                                  Command="{Binding SignOutCommand}"
                                  Content="Sign out"
                                  ToolTip.Tip="Sign out and clear this CLI's stored credentials" />
                          <Button Theme="{StaticResource SecondaryButton}"
                                  IsVisible="{Binding IsSigningIn}"
                                  Command="{Binding CancelLoginCommand}"
                                  Content="Cancel" />
                          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsSigningOut}" VerticalAlignment="Center" Margin="6,0">
                            <c:PixelSpinner Width="12" Height="12" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="Signing out…" Classes="muted" FontSize="{DynamicResource UiFontSizeSmall}" VerticalAlignment="Center" />
                          </StackPanel>
                        </StackPanel>
                      </Grid>

                      <!-- OpenCode connected providers (each can be disconnected individually) -->
                      <ItemsControl ItemsSource="{Binding ConnectedProviders}"
                                    c:Fold.IsOpen="{Binding HasConnectedProviders}"
                                    IsVisible="False"
                                    Margin="24,6,0,0">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="oc:OpenCodeConnectedProvider">
                            <Border Classes="providerchip">
                              <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" FontSize="{DynamicResource UiFontSizeSmall}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Button Theme="{StaticResource IconButton}"
                                        Width="18" Height="18"
                                        Command="{Binding $parent[ItemsControl].((vm:AgentAccountViewModel)DataContext).DisconnectOpenCodeProviderCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="{Binding Name, StringFormat='Disconnect {0}'}">
                                  <c:Icon Size="9" Data="{StaticResource IconClose}" />
                                </Button>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <!-- Active browser sign-in progress panel -->
                      <Border Classes="authpanel"
                              Margin="24,8,0,2"
                              c:Fold.IsOpen="{Binding ShowLoginPanel}"
                              IsVisible="False">
                        <StackPanel Spacing="8">
                          <Grid ColumnDefinitions="Auto,*,Auto">
                            <c:PixelSpinner Width="14" Height="14"
                                            Foreground="{DynamicResource AccentBrush}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding LoginMessage}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="{DynamicResource UiFontSize}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="2"
                                    Theme="{StaticResource LineButton}"
                                    IsVisible="{Binding HasLoginUrl}"
                                    Command="{Binding OpenLoginPageCommand}"
                                    Foreground="{DynamicResource LinkBrush}"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="Open the sign-in page in your browser again">
                              <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="Open page" FontSize="{DynamicResource UiFontSizeSmall}" FontWeight="Medium" VerticalAlignment="Center" />
                                <c:Icon Size="12" Data="{StaticResource IconExternalLink}" VerticalAlignment="Center" />
                              </StackPanel>
                            </Button>
                          </Grid>

                          <!-- Device code banner (e.g. GitHub Copilot) -->
                          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasDeviceCode}" Margin="24,0,0,0">
                            <Border Background="{DynamicResource BgCodeBrush}"
                                    BorderBrush="{DynamicResource BorderInputBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="10,4">
                              <SelectableTextBlock Text="{Binding DeviceCode}"
                                                   FontFamily="{DynamicResource MonoFont}"
                                                   FontSize="{DynamicResource UiFontSizeLarge}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Border>
                            <Button Theme="{StaticResource SecondaryButton}"
                                    Height="28"
                                    Click="OnCopyDeviceCodeClick"
                                    Content="{Binding CopyCodeText}" />
                          </StackPanel>

                          <!-- Manual authorization code entry when a provider uses OAuth "code" flow -->
                          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding NeedsCodeInput}" Margin="24,2,0,0">
                            <Border Classes="field compact" Margin="0,0,8,0">
                              <TextBox Theme="{StaticResource BareTextBox}"
                                       Text="{Binding AuthCodeInput}"
                                       Watermark="Paste the authorization code from your browser"
                                       FontFamily="{DynamicResource MonoFont}"
                                       FontSize="{DynamicResource UiFontSizeSmall}" />
                            </Border>
                            <Button Grid.Column="1"
                                    Theme="{StaticResource PrimaryButton}"
                                    Height="28"
                                    Command="{Binding SubmitCodeCommand}"
                                    Content="Complete" />
                          </Grid>
                        </StackPanel>
                      </Border>

                      <!-- OpenCode subscription OAuth provider picker -->
                      <Border Classes="authpanel"
                              Margin="24,8,0,2"
                              c:Fold.IsOpen="{Binding IsProviderPickerOpen}"
                              IsVisible="False">
                        <StackPanel Spacing="6">
                          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsLoadingProviders}">
                            <c:PixelSpinner Width="13" Height="13" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="Loading OpenCode subscription providers…" Classes="muted" FontSize="{DynamicResource UiFontSizeSmall}" VerticalAlignment="Center" />
                          </StackPanel>

                          <StackPanel IsVisible="{Binding !IsLoadingProviders}" Spacing="4">
                            <StackPanel IsVisible="{Binding !IsPromptingInputs}" Spacing="2">
                              <TextBlock Text="Choose a subscription to sign in to in your browser:"
                                         FontSize="{DynamicResource UiFontSizeSmall}"
                                         Foreground="{DynamicResource TextMutedBrush}"
                                         Margin="4,0,0,4" />
                              <ItemsControl ItemsSource="{Binding OpenCodeProviders}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:OpenCodeProviderOption">
                                    <Button Theme="{StaticResource MenuItemButton}"
                                            Padding="8,5"
                                            Command="{Binding $parent[ItemsControl].((vm:AgentAccountViewModel)DataContext).ChooseOpenCodeProviderCommand}"
                                            CommandParameter="{Binding}">
                                      <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding MethodLabel}" Classes="muted" FontSize="{DynamicResource UiFontSizeSmall}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0,0,0">
                                          <c:Icon Size="12" Data="{StaticResource IconCheck}" Stroke="{DynamicResource SuccessBrush}" IsVisible="{Binding IsConnected}" />
                                          <c:Icon Size="12" Data="{StaticResource IconExternalLink}" Stroke="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                      </Grid>
                                    </Button>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>

                            <!-- Extra fields for providers like GitLab / Snowflake before launching browser -->
                            <StackPanel IsVisible="{Binding IsPromptingInputs}" Spacing="8">
                              <TextBlock Text="{Binding PromptingTitle}" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                              <ItemsControl ItemsSource="{Binding PromptFields}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:OpenCodePromptField">
                                    <StackPanel Spacing="3" Margin="0,0,0,4">
                                      <TextBlock Text="{Binding Label}" FontSize="{DynamicResource UiFontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                      <Border Classes="field compact">
                                        <TextBox Theme="{StaticResource BareTextBox}"
                                                 Text="{Binding Value}"
                                                 Watermark="{Binding Placeholder}"
                                                 FontSize="{DynamicResource UiFontSize}" />
                                      </Border>
                                    </StackPanel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Theme="{StaticResource GhostButton}" Command="{Binding CancelOpenCodePromptCommand}" Content="Back" />
                                <Button Theme="{StaticResource PrimaryButton}" Command="{Binding ContinueOpenCodePromptCommand}">
                                  <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Continue in browser" VerticalAlignment="Center" />
                                    <c:Icon Size="12" Data="{StaticResource IconExternalLink}" VerticalAlignment="Center" />
                                  </StackPanel>
                                </Button>
                              </StackPanel>
                            </StackPanel>
                          </StackPanel>
                        </StackPanel>
                      </Border>

                      <!-- Brief confirmation after sign-in completes -->
                      <StackPanel Orientation="Horizontal" Spacing="6" Margin="24,6,0,0"
                                  c:Fold.IsOpen="{Binding HasSuccess}" IsVisible="False">
                        <c:Icon Size="13" Data="{StaticResource IconCheck}" Stroke="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SuccessMessage}"
                                   FontSize="{DynamicResource UiFontSizeSmall}"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   VerticalAlignment="Center" />
                      </StackPanel>

                      <!-- Error line when sign-in / sign-out fails -->
                      <Grid ColumnDefinitions="*,Auto" Margin="24,6,0,0"
                            c:Fold.IsOpen="{Binding HasError}" IsVisible="False">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Classes="rowhint failed"
                                   Margin="0"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Theme="{StaticResource IconButton}" Width="22" Height="22"
                                Command="{Binding DismissErrorCommand}" ToolTip.Tip="Dismiss">
                          <c:Icon Size="11" Data="{StaticResource IconClose}" />
                        </Button>
                      </Grid>

                      <!-- Executable path row -->
                      <Grid ColumnDefinitions="*,Auto" Margin="24,8,0,14">
                        <TextBlock Text="{Binding PathStatus}"
                                   Classes="rowhint"
                                   FontSize="{DynamicResource UiFontSizeSmall}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding PathStatus}"
                                   Margin="0,0,16,0"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1" Classes="field compact" Width="280">
                          <TextBox Theme="{StaticResource BareTextBox}"
                                   Text="{Binding CliPath}"
                                   Watermark="{Binding PathWatermark}"
                                   FontSize="{DynamicResource UiFontSizeSmall}"
                                   FontFamily="{DynamicResource MonoFont}" />
                        </Border>
                      </Grid>
                      <Border Classes="rowline" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Main agent" Classes="rowlabel" />
                  <TextBlock Text="Its sessions show no logo in the sidebar; the other agents' sessions do. None: every session shows its logo." Classes="rowhint" TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding MainBackends}" SelectedItem="{Binding MainBackend}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="agents:AgentBackendInfo">
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>

              <TextBlock Text="New sessions" Classes="pagetitle" Margin="0,40,0,10" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Default agent" Classes="rowlabel" />
                  <TextBlock Text="Agent new sessions start on; each session can switch from the status row." Classes="rowhint" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Backends}" SelectedItem="{Binding DefaultBackend}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="agents:AgentBackendInfo">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:AgentLogo Backend="{Binding Id}" Size="13" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Default model" Classes="rowlabel" />
                  <TextBlock Text="{Binding DefaultModelHint}" Classes="rowhint" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding DefaultModelChoices}" SelectedItem="{Binding DefaultModel}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="inf:ModelOption">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Default permission mode" Classes="rowlabel" />
                  <TextBlock Text="How new sessions ask before an agent makes changes." Classes="rowhint" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Modes}" SelectedItem="{Binding DefaultMode}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="inf:ModeOption">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Default effort" Classes="rowlabel" />
                  <TextBlock Text="Starting reasoning effort for new sessions when the model supports it. Each model remembers the effort you last chose with it." Classes="rowhint" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Efforts}" SelectedItem="{Binding DefaultEffort}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="inf:EffortOption">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Suggest the next prompt" Classes="rowlabel" />
                  <TextBlock Text="After a turn, supported agents (Claude Code and Antigravity) suggest what you might ask next as grey text in the empty composer. Tab, → or a right-click takes it, Esc dismisses it. Applies to sessions started from now on."
                             Classes="rowhint" />
                </StackPanel>
                <Button Grid.Column="1"
                        Theme="{StaticResource FlatButton}"
                        Padding="6"
                        VerticalAlignment="Center"
                        Command="{Binding TogglePromptSuggestionsCommand}">
                  <Border Classes="switch large" Classes.on="{Binding PromptSuggestions}">
                    <Ellipse />
                  </Border>
                </Button>
              </Grid>

              <TextBlock Text="Models and workflows" Classes="pagetitle" Margin="0,40,0,10" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Ask before switching models" Classes="rowlabel" />
                  <TextBlock Text="A conversation is cached for its model: after a switch the next reply reads all of it again, slower and using more of your plan."
                             Classes="rowhint" />
                </StackPanel>
                <Button Grid.Column="1"
                        Theme="{StaticResource FlatButton}"
                        Padding="6"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleConfirmModelSwitchCommand}">
                  <Border Classes="switch large" Classes.on="{Binding ConfirmModelSwitch}">
                    <Ellipse />
                  </Border>
                </Button>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="F1–F4 switch the model" Classes="rowlabel" />
                  <TextBlock Text="On the new session screen, F1–F4 pick the current agent's first four models (on OpenCode, your first four starred models), besides Ctrl+Shift+1…4."
                             Classes="rowhint" />
                </StackPanel>
                <Button Grid.Column="1"
                        Theme="{StaticResource FlatButton}"
                        Padding="6"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleModelFunctionKeysCommand}">
                  <Border Classes="switch large" Classes.on="{Binding ModelFunctionKeys}">
                    <Ellipse />
                  </Border>
                </Button>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Claude Code workflow size" Classes="rowlabel" />
                  <TextBlock Text="How many agents Claude Code's workflows aim to stay under: Small fewer than 5, Medium fewer than 10, Large fewer than 50. Running sessions take it at once."
                             Classes="rowhint" />
                </StackPanel>
                <Border Grid.Column="1" Classes="segments">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="WorkflowSize" IsChecked="{Binding IsWorkflowSmall}" Content="Small" />
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="WorkflowSize" IsChecked="{Binding IsWorkflowMedium}" Content="Medium" />
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="WorkflowSize" IsChecked="{Binding IsWorkflowLarge}" Content="Large" />
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="WorkflowSize" IsChecked="{Binding IsWorkflowUnrestricted}" Content="No limit" />
                  </StackPanel>
                </Border>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="System prompts by folder" Classes="rowlabel" />
                  <TextBlock Text="A text file that replaces Claude Code's or Codex's own system prompt in a folder and the folders inside it. Antigravity can only add to its prompt, so it is left out. Sessions take it the next time they start."
                             Classes="rowhint" />
                </StackPanel>
                <Button Grid.Column="1" Theme="{StaticResource LineButton}" Click="OnAddFolderSystemPromptClick" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:Icon Size="13" Data="{StaticResource IconPlus}" />
                    <TextBlock Text="Add folder…" FontWeight="Medium" />
                  </StackPanel>
                </Button>
              </Grid>

              <ItemsControl ItemsSource="{Binding FolderSystemPrompts}" IsVisible="{Binding HasFolderSystemPrompts}" Margin="0,0,0,4">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FolderSystemPromptRow">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" Margin="0,6">
                      <TextBlock Text="{Binding Folder}" FontFamily="{DynamicResource MonoFont}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Theme="{StaticResource IconButton}" Margin="6,0,0,0" VerticalAlignment="Center"
                              Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveFolderSystemPromptCommand}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="Remove the folder: both agents use a parent folder's file, if any">
                        <c:Icon Size="13" Data="{StaticResource IconClose}" />
                      </Button>
                      <!-- One line per agent: its file (or its own prompt), Choose… and Clear. -->
                      <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="96,*,Auto,Auto" Margin="12,2,0,0">
                        <TextBlock Text="Claude Code" Classes="rowhint" FontSize="{DynamicResource UiFontSizeSmall}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ClaudeStatus}" Classes="rowhint" TextTrimming="CharacterEllipsis"
                                   FontSize="{DynamicResource UiFontSizeSmall}" VerticalAlignment="Center" ToolTip.Tip="{Binding ClaudeFile}" />
                        <Button Grid.Column="2" Theme="{StaticResource FlatButton}" Padding="6,2" Margin="8,0,0,0" Tag="claude" Click="OnChooseSystemPromptClick">
                          <TextBlock Text="Choose…" FontSize="{DynamicResource UiFontSizeSmall}" />
                        </Button>
                        <Button Grid.Column="3" Theme="{StaticResource FlatButton}" Padding="6,2" IsVisible="{Binding HasClaudeFile}"
                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).ClearClaudeSystemPromptCommand}"
                                CommandParameter="{Binding}" ToolTip.Tip="Claude Code uses its own prompt here">
                          <TextBlock Text="Clear" FontSize="{DynamicResource UiFontSizeSmall}" />
                        </Button>
                      </Grid>
                      <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="96,*,Auto,Auto" Margin="12,0,0,0">
                        <TextBlock Text="Codex" Classes="rowhint" FontSize="{DynamicResource UiFontSizeSmall}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding CodexStatus}" Classes="rowhint" TextTrimming="CharacterEllipsis"
                                   FontSize="{DynamicResource UiFontSizeSmall}" VerticalAlignment="Center" ToolTip.Tip="{Binding CodexFile}" />
                        <Button Grid.Column="2" Theme="{StaticResource FlatButton}" Padding="6,2" Margin="8,0,0,0" Tag="codex" Click="OnChooseSystemPromptClick">
                          <TextBlock Text="Choose…" FontSize="{DynamicResource UiFontSizeSmall}" />
                        </Button>
                        <Button Grid.Column="3" Theme="{StaticResource FlatButton}" Padding="6,2" IsVisible="{Binding HasCodexFile}"
                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).ClearCodexSystemPromptCommand}"
                                CommandParameter="{Binding}" ToolTip.Tip="Codex uses its own prompt here">
                          <TextBlock Text="Clear" FontSize="{DynamicResource UiFontSizeSmall}" />
                        </Button>
                      </Grid>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Suggest new chats" Classes="rowlabel" />
                  <TextBlock Text="Claude Code may offer a task that is unrelated to the chat, or that it noticed along the way, as a card you can start as a chat of its own, and stops instead of doing it there. Turn off to keep every task in the chat you asked in. Sessions take it the next time they start."
                             Classes="rowhint" />
                </StackPanel>
                <Button Grid.Column="1"
                        Theme="{StaticResource FlatButton}"
                        Padding="6"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleSuggestNewChatsCommand}">
                  <Border Classes="switch large" Classes.on="{Binding SuggestNewChats}">
                    <Ellipse />
                  </Border>
                </Button>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto" IsEnabled="{Binding SuggestNewChats}">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Not in these folders" Classes="rowlabel" />
                  <TextBlock Text="No new-chat suggestions in these folders and the folders inside them." Classes="rowhint" />
                </StackPanel>
                <Button Grid.Column="1" Theme="{StaticResource LineButton}" Click="OnAddNoNewChatFolderClick" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:Icon Size="13" Data="{StaticResource IconPlus}" />
                    <TextBlock Text="Add folder…" FontWeight="Medium" />
                  </StackPanel>
                </Button>
              </Grid>

              <ItemsControl ItemsSource="{Binding NoNewChatFolders}" IsVisible="{Binding HasNoNewChatFolders}" IsEnabled="{Binding SuggestNewChats}" Margin="0,0,0,4">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,6">
                      <TextBlock Text="{Binding}" FontFamily="{DynamicResource MonoFont}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Theme="{StaticResource IconButton}" Margin="6,0,0,0" VerticalAlignment="Center"
                              Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveNoNewChatFolderCommand}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="Remove">
                        <c:Icon Size="13" Data="{StaticResource IconClose}" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Remote Control -->
            <StackPanel Classes="page" IsVisible="{Binding IsRemoteControlPage}">
              <StackPanel.RenderTransform><TranslateTransform /></StackPanel.RenderTransform>
              <TextBlock Text="Remote Control" Classes="pagetitle" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Remote Control for new sessions" Classes="rowlabel" />
                  <TextBlock Text="Continue sessions from the Claude app or claude.ai while they run here. Each session can turn it off with the phone icon in the status row."
                             Classes="rowhint" />
                </StackPanel>
                <Button Grid.Column="1" Theme="{StaticResource FlatButton}" Command="{Binding ToggleRemoteControlByDefaultCommand}" VerticalAlignment="Center" Padding="4">
                  <Border Classes="switch large" Classes.on="{Binding RemoteControlByDefault}">
                    <Ellipse />
                  </Border>
                </Button>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Start sessions from the phone" Classes="rowlabel" />
                  <TextBlock Text="In these folders Nomad keeps Claude Code's Remote Control server running, so the Claude app and claude.ai/code can start new sessions here. They appear under Alive with a phone icon."
                             Classes="rowhint" />
                </StackPanel>
                <Button Grid.Column="1" Theme="{StaticResource LineButton}" Click="OnAddPhoneFolderClick" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:Icon Size="13" Data="{StaticResource IconPlus}" />
                    <TextBlock Text="Add folder…" FontWeight="Medium" />
                  </StackPanel>
                </Button>
              </Grid>

              <ItemsControl ItemsSource="{Binding PhoneFolders}" IsVisible="{Binding HasPhoneFolders}" Margin="0,0,0,4">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PhoneFolderRow">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,6">
                      <Ellipse Width="7" Height="7" Margin="2,0,10,0" VerticalAlignment="Center"
                               Fill="{DynamicResource TextMutedBrush}"
                               IsVisible="{Binding !IsReady}" />
                      <Ellipse Width="7" Height="7" Margin="2,0,10,0" VerticalAlignment="Center"
                               Fill="{DynamicResource SuccessBrush}"
                               IsVisible="{Binding IsReady}" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Folder}" FontFamily="{DynamicResource MonoFont}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Status}" Classes="rowhint" TextWrapping="Wrap" FontSize="{DynamicResource UiFontSizeSmall}" />
                      </StackPanel>
                      <Button Grid.Column="2" Theme="{StaticResource LineButton}" Margin="10,0,0,0" VerticalAlignment="Center"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              IsVisible="{Binding NeedsSetup}"
                              Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).SetUpPhoneFolderCommand}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="Opens claude remote-control in a terminal to answer its one-time questions">
                        <TextBlock Text="Set up" FontWeight="Medium" />
                      </Button>
                      <Button Grid.Column="3" Theme="{StaticResource LineButton}" Margin="10,0,0,0" VerticalAlignment="Center"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              IsVisible="{Binding CanRetry}"
                              Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RetryPhoneFolderCommand}"
                              CommandParameter="{Binding}">
                        <TextBlock Text="Retry" FontWeight="Medium" />
                      </Button>
                      <Button Grid.Column="4" Theme="{StaticResource IconButton}" Margin="6,0,0,0" VerticalAlignment="Center"
                              Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemovePhoneFolderCommand}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="Remove">
                        <c:Icon Size="13" Data="{StaticResource IconClose}" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Hub -->
            <StackPanel Classes="page" IsVisible="{Binding IsHubPage}">
              <StackPanel.RenderTransform><TranslateTransform /></StackPanel.RenderTransform>
              <TextBlock Text="Nomad Hub" Classes="pagetitle" />
              <TextBlock Text="A hub you host keeps this PC's sessions and your other PCs' in step, and adds up everyone's token use. Without one, Nomad works on its own."
                         Classes="rowhint" TextWrapping="Wrap" Margin="0,0,0,8" />

              <!-- Not connected: address, one-time token, this PC's name. -->
              <StackPanel IsVisible="{Binding Hub.IsNotEnrolled}">
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <StackPanel VerticalAlignment="Center" Margin="0,12">
                    <TextBlock Text="Hub address" Classes="rowlabel" />
                    <TextBlock Text="Where your hub answers, behind your proxy or tunnel." Classes="rowhint" />
                  </StackPanel>
                  <Border Grid.Column="1" Classes="field" Width="360">
                    <TextBox Theme="{StaticResource BareTextBox}" Text="{Binding Hub.Url}" Watermark="https://hub.example.com" FontSize="{DynamicResource UiFontSize}" />
                  </Border>
                </Grid>
                <Border Classes="rowline" />

                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <StackPanel VerticalAlignment="Center" Margin="0,12">
                    <TextBlock Text="Enrollment token" Classes="rowlabel" />
                    <TextBlock Text="From the hub's log on its first start, or Add device on a PC already connected. It works once." Classes="rowhint" TextWrapping="Wrap" />
                  </StackPanel>
                  <Border Grid.Column="1" Classes="field" Width="360">
                    <TextBox Theme="{StaticResource BareTextBox}" Text="{Binding Hub.Token}" FontSize="{DynamicResource UiFontSize}" FontFamily="{DynamicResource MonoFont}" />
                  </Border>
                </Grid>
                <Border Classes="rowline" />

                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <StackPanel VerticalAlignment="Center" Margin="0,12">
                    <TextBlock Text="This PC's name" Classes="rowlabel" />
                    <TextBlock Text="How your other PCs see it." Classes="rowhint" />
                  </StackPanel>
                  <Border Grid.Column="1" Classes="field" Width="360">
                    <TextBox Theme="{StaticResource BareTextBox}" Text="{Binding Hub.DeviceName}" FontSize="{DynamicResource UiFontSize}" />
                  </Border>
                </Grid>
                <Border Classes="rowline" />

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                  <Button Theme="{StaticResource PrimaryButton}" Content="Connect" Command="{Binding Hub.ConnectCommand}" />
                </StackPanel>
              </StackPanel>

              <!-- Connected: status, sync now, devices. -->
              <StackPanel IsVisible="{Binding Hub.IsEnrolled}">
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <StackPanel VerticalAlignment="Center" Margin="0,12">
                    <TextBlock Text="{Binding Hub.Url}" Classes="rowlabel" />
                    <TextBlock Text="Live" Classes="rowhint ok" IsVisible="{Binding Hub.IsConnected}" />
                    <TextBlock Text="Not reachable now: sessions sync when it is." Classes="rowhint" IsVisible="{Binding !Hub.IsConnected}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Theme="{StaticResource SecondaryButton}" Content="Sync now" Command="{Binding Hub.SyncNowCommand}" />
                    <Button Theme="{StaticResource SecondaryButton}" Content="Disconnect" Command="{Binding Hub.DisconnectCommand}" />
                  </StackPanel>
                </Grid>
                <Border Classes="rowline" />

                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <StackPanel VerticalAlignment="Center" Margin="0,12">
                    <TextBlock Text="Stream live sessions" Classes="rowlabel" />
                    <TextBlock Text="Your other PCs watch a session running here as it happens, and can prompt, answer and stop it. Off: they ask for it instead, and it moves to them after its turn."
                               Classes="rowhint" TextWrapping="Wrap" />
                    <TextBlock Text="This hub has streaming turned off (Hub__RelayEnabled)." Classes="rowhint" IsVisible="{Binding Hub.RelayOffOnHub}" />
                  </StackPanel>
                  <Button Grid.Column="1"
                          Theme="{StaticResource FlatButton}"
                          Padding="6"
                          VerticalAlignment="Center"
                          Command="{Binding Hub.ToggleStreamLiveCommand}">
                    <Border Classes="switch large" Classes.on="{Binding Hub.StreamLive}">
                      <Ellipse />
                    </Border>
                  </Button>
                </Grid>
                <Border Classes="rowline" />

                <TextBlock Text="Devices" Classes="rowlabel" Margin="0,18,0,6" />
                <ItemsControl ItemsSource="{Binding Hub.Devices}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HubDeviceRow">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,6">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" Classes="rowlabel" />
                          <TextBlock Text="{Binding Seen}" Classes="rowhint" />
                        </StackPanel>
                        <Button Grid.Column="1" Theme="{StaticResource SecondaryButton}" Content="Remove" VerticalAlignment="Center"
                                IsVisible="{Binding CanRevoke}"
                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).Hub.RevokeCommand}"
                                CommandParameter="{Binding}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Classes="rowline" />

                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <StackPanel VerticalAlignment="Center" Margin="0,12">
                    <TextBlock Text="Add device" Classes="rowlabel" />
                    <TextBlock Text="A one-time token for another PC's Settings › Hub." Classes="rowhint" />
                    <SelectableTextBlock Text="{Binding Hub.NewToken}" IsVisible="{Binding Hub.HasNewToken}" FontFamily="{DynamicResource MonoFont}" Margin="0,6,0,0" />
                  </StackPanel>
                  <Button Grid.Column="1" Theme="{StaticResource SecondaryButton}" Content="Add device" VerticalAlignment="Center" Command="{Binding Hub.AddDeviceCommand}" />
                </Grid>
                <Border Classes="rowline" />
              </StackPanel>

              <TextBlock Text="{Binding Hub.Status}" IsVisible="{Binding Hub.HasStatus}" Classes="rowhint" TextWrapping="Wrap" Margin="0,14,0,0" />
            </StackPanel>

            <!-- Updates -->
            <StackPanel Classes="page" IsVisible="{Binding IsUpdatesPage}">
              <StackPanel.RenderTransform><TranslateTransform /></StackPanel.RenderTransform>
              <TextBlock Text="Updates" Classes="pagetitle" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12,16,12">
                  <TextBlock Text="{Binding Updates.VersionLine}" Classes="rowlabel" />
                  <TextBlock Text="{Binding Updates.InstallHint}" IsVisible="{Binding !Updates.IsInstalled}" Classes="rowhint" />
                  <TextBlock Text="{Binding Updates.Status}"
                             IsVisible="{Binding Updates.HasStatus}"
                             Classes="rowhint"
                             Classes.attention="{Binding Updates.IsAttention}"
                             Classes.failed="{Binding Updates.IsFailed}" />
                </StackPanel>
                <Panel Grid.Column="1" VerticalAlignment="Center">
                  <Button Theme="{StaticResource PrimaryButton}"
                          IsVisible="{Binding Updates.ActionIsPrimary}"
                          IsEnabled="{Binding Updates.CanAct}"
                          Command="{Binding Updates.ActCommand}"
                          Content="{Binding Updates.ActionText}" />
                  <Button Theme="{StaticResource SecondaryButton}"
                          IsVisible="{Binding !Updates.ActionIsPrimary}"
                          IsEnabled="{Binding Updates.CanAct}"
                          Command="{Binding Updates.ActCommand}"
                          Content="{Binding Updates.ActionText}" />
                </Panel>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Install updates automatically" Classes="rowlabel" />
                  <TextBlock Text="Download new versions in the background and restart into them while no turn is running. Off: Nomad.ai only tells you about them."
                             Classes="rowhint" />
                </StackPanel>
                <Button Grid.Column="1"
                        Theme="{StaticResource FlatButton}"
                        Padding="6"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleAutoUpdateCommand}">
                  <Border Classes="switch large" Classes.on="{Binding AutoUpdate}">
                    <Ellipse />
                  </Border>
                </Button>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Include pre-releases" Classes="rowlabel" />
                  <TextBlock Text="Also offer versions published as pre-releases on GitHub." Classes="rowhint" />
                </StackPanel>
                <Button Grid.Column="1"
                        Theme="{StaticResource FlatButton}"
                        Padding="6"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleIncludePrereleasesCommand}">
                  <Border Classes="switch large" Classes.on="{Binding IncludePrereleases}">
                    <Ellipse />
                  </Border>
                </Button>
              </Grid>

              <Grid ColumnDefinitions="*,Auto" Margin="0,40,0,4">
                <TextBlock Text="Releases" Classes="pagetitle" Margin="0" VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Theme="{StaticResource LineButton}"
                        Command="{Binding Updates.OpenReleasesPageCommand}"
                        ToolTip.Tip="{Binding Updates.Feed.PageUrl}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="View on GitHub" FontSize="{DynamicResource UiFontSize}" VerticalAlignment="Center" />
                    <c:Icon Size="13" Data="{StaticResource IconArrowRight}" />
                  </StackPanel>
                </Button>
              </Grid>
              <TextBlock Text="{Binding ReleasesStatus}" IsVisible="{Binding HasReleasesStatus}" Classes="rowhint" Margin="0,6,0,10" />

              <ItemsControl ItemsSource="{Binding Releases}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ReleaseItemViewModel">
                    <StackPanel>
                      <Button Theme="{StaticResource LineButton}"
                              Command="{Binding ToggleCommand}"
                              HorizontalAlignment="Stretch"
                              Padding="0,11">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <c:Icon Classes="chev" Classes.open="{Binding IsExpanded}" Size="13" Data="{StaticResource IconChevronRight}" Margin="-3,0,0,0" />
                          <TextBlock Text="{Binding Tag}" FontSize="{DynamicResource UiFontSizeLarge}" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding DateText}" FontSize="{DynamicResource UiFontSize}" VerticalAlignment="Center" />
                          <Border Classes="tag installed" IsVisible="{Binding IsInstalled}">
                            <TextBlock Text="installed" />
                          </Border>
                          <Border Classes="tag newer" IsVisible="{Binding IsNewer}">
                            <TextBlock Text="newer" />
                          </Border>
                          <Border Classes="tag" IsVisible="{Binding IsPrerelease}">
                            <TextBlock Text="pre-release" />
                          </Border>
                        </StackPanel>
                      </Button>
                      <md:MarkdownView Markdown="{Binding VisibleNotes}" IsVisible="{Binding IsExpanded}" Margin="21,0,0,16" />
                      <TextBlock Text="No release notes." IsVisible="{Binding ShowNoNotes}" Classes="rowhint" Margin="21,0,0,16" />
                      <Border Classes="rowline" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Panel>
        </ScrollViewer>

        <Button Theme="{StaticResource IconButton}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,14,16,0"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Click="OnCloseClick"
                ToolTip.Tip="Close (Esc)">
          <c:Icon Data="{StaticResource IconClose}" StrokeThickness="1.6" />
        </Button>
      </Panel>
    </Grid>
  </Border>
</UserControl>
