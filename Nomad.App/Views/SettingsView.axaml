<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nomad.App.ViewModels"
             xmlns:inf="using:Nomad.App.Infrastructure"
             xmlns:c="using:Nomad.App.Controls"
             xmlns:md="using:Nomad.App.Markdown"
             x:Class="Nomad.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Focusable="True">

  <!-- Flat combo boxes: text + chevron, like the original's font pickers. -->
  <UserControl.Resources>
    <SolidColorBrush x:Key="ComboBoxBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="Transparent" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="Transparent" />
    <SolidColorBrush x:Key="ComboBoxForeground" Color="#EEEDE8" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#20201E" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#363636" />
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#A8A6A0" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBlock.pagetitle">
      <Setter Property="FontSize" Value="{DynamicResource UiFontSizeTitle}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="TextBlock.rowlabel">
      <Setter Property="FontSize" Value="{DynamicResource UiFontSizeLarge}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.rowhint">
      <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
    <Style Selector="Grid.row">
      <Setter Property="MinHeight" Value="56" />
    </Style>
    <Style Selector="Border.rowline">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="#262624" />
    </Style>
    <Style Selector="Border.segments">
      <Setter Property="Background" Value="#262624" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinWidth" Value="200" />
      <Setter Property="HorizontalContentAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
      <Setter Property="MaxDropDownHeight" Value="420" />
    </Style>
    <!-- Updates page: the status line's colours, release markers and the chevron of a release. -->
    <Style Selector="TextBlock.rowhint.attention">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="TextBlock.rowhint.failed">
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    </Style>
    <Style Selector="Border.tag">
      <Setter Property="Background" Value="#262624" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,1,6,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.tag > TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSmall}" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Border.tag.installed">
      <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
    </Style>
    <Style Selector="Border.tag.installed > TextBlock">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="Border.tag.newer">
      <Setter Property="Background" Value="#262A78D6" />
    </Style>
    <Style Selector="Border.tag.newer > TextBlock">
      <Setter Property="Foreground" Value="{StaticResource LinkBrush}" />
    </Style>
    <Style Selector="c|Icon.chev">
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
    </Style>
    <Style Selector="c|Icon.chev.open">
      <Setter Property="RenderTransform" Value="rotate(90deg)" />
    </Style>
    <Style Selector="Border.field">
      <Setter Property="Background" Value="#202020" />
      <Setter Property="BorderBrush" Value="#383838" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Height" Value="31" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Border Background="#1A1A18"
          BorderBrush="#262624"
          BorderThickness="1"
          CornerRadius="12"
          MaxWidth="1278"
          MaxHeight="935"
          Margin="24,48"
          ClipToBounds="True"
          BoxShadow="0 16 48 0 #59000000">
    <Grid ColumnDefinitions="211,*">

      <!-- Navigation -->
      <Border Background="{StaticResource BgMainBrush}" BorderBrush="#2C2C2C" BorderThickness="0,0,1,0">
        <StackPanel Margin="12,0" Spacing="1">
          <TextBlock Text="Settings" Classes="section" FontSize="{DynamicResource UiFontSizeSmall}" Margin="8,30,0,10" />
          <Button Theme="{StaticResource NavButton}" Classes.selected="{Binding IsGeneralPage}" Command="{Binding ShowGeneralCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <c:Icon Data="{StaticResource IconGear}" />
              <TextBlock Text="General" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Theme="{StaticResource NavButton}" Classes.selected="{Binding IsClaudeCodePage}" Command="{Binding ShowClaudeCodeCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <c:Icon Data="{StaticResource IconTerminal}" />
              <TextBlock Text="Claude Code" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Theme="{StaticResource NavButton}" Classes.selected="{Binding IsUpdatesPage}" Command="{Binding ShowUpdatesCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <c:Icon Data="{StaticResource IconUpdate}" />
              <TextBlock Text="Updates" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <!-- Pages -->
      <Panel Grid.Column="1">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Panel Margin="24,58,34,32">

            <!-- General -->
            <StackPanel IsVisible="{Binding IsGeneralPage}">
              <TextBlock Text="Appearance" Classes="pagetitle" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Interface font" Classes="rowlabel" />
                  <TextBlock Text="Font for the whole interface — menus, sidebar and transcript." Classes="rowhint" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding UiFonts}" SelectedItem="{Binding InterfaceFont}" />
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Code font" Classes="rowlabel" />
                  <TextBlock Text="Used for code blocks, inline code and tool details." Classes="rowhint" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding CodeFonts}" SelectedItem="{Binding CodeFont}" />
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <TextBlock Text="Interface text size" Classes="rowlabel" VerticalAlignment="Center" />
                <Border Grid.Column="1" Classes="segments">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="UiTextSize" IsChecked="{Binding IsUiTextSmall}" Content="Small" />
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="UiTextSize" IsChecked="{Binding IsUiTextMedium}" Content="Medium" />
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="UiTextSize" IsChecked="{Binding IsUiTextLarge}" Content="Large" />
                  </StackPanel>
                </Border>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <TextBlock Text="Transcript text size" Classes="rowlabel" VerticalAlignment="Center" />
                <Border Grid.Column="1" Classes="segments">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="TextSize" IsChecked="{Binding IsTextSmall}" Content="Small" />
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="TextSize" IsChecked="{Binding IsTextMedium}" Content="Medium" />
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="TextSize" IsChecked="{Binding IsTextLarge}" Content="Large" />
                  </StackPanel>
                </Border>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Transcript width" Classes="rowlabel" />
                  <TextBlock Text="Maximum width of the transcript and composer columns." Classes="rowhint" />
                </StackPanel>
                <Border Grid.Column="1" Classes="segments">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="Width" IsChecked="{Binding IsWidthNarrow}" Content="Narrow" />
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="Width" IsChecked="{Binding IsWidthMedium}" Content="Medium" />
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="Width" IsChecked="{Binding IsWidthWide}" Content="Wide" />
                  </StackPanel>
                </Border>
              </Grid>

              <TextBlock Text="Account" Classes="pagetitle" Margin="0,40,0,10" />
              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Display name" Classes="rowlabel" />
                  <TextBlock Text="Shown at the bottom of the sidebar. Empty uses your Windows user name." Classes="rowhint" />
                </StackPanel>
                <Border Grid.Column="1" Classes="field" Width="260">
                  <TextBox Theme="{StaticResource BareTextBox}" Text="{Binding DisplayName}" Watermark="Your name" FontSize="{DynamicResource UiFontSize}" />
                </Border>
              </Grid>
            </StackPanel>

            <!-- Claude Code -->
            <StackPanel IsVisible="{Binding IsClaudeCodePage}">
              <TextBlock Text="Claude Code" Classes="pagetitle" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="CLI path" Classes="rowlabel" />
                  <TextBlock Text="The claude executable Nomad.ai starts. &quot;claude&quot; looks it up on PATH." Classes="rowhint" />
                  <TextBlock Text="{Binding CliStatus}" Classes="rowhint" Classes.ok="{Binding CliFound}" FontSize="{DynamicResource UiFontSizeSmall}" />
                </StackPanel>
                <Border Grid.Column="1" Classes="field" Width="360">
                  <TextBox Theme="{StaticResource BareTextBox}" Text="{Binding CliPath}" Watermark="claude" FontSize="{DynamicResource UiFontSize}" FontFamily="{DynamicResource MonoFont}" />
                </Border>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Default model" Classes="rowlabel" />
                  <TextBlock Text="Model of new sessions; each session can switch from the status row." Classes="rowhint" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Models}" SelectedItem="{Binding DefaultModel}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="inf:ModelOption">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Default permission mode" Classes="rowlabel" />
                  <TextBlock Text="How new sessions ask before Claude changes things." Classes="rowhint" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Modes}" SelectedItem="{Binding DefaultMode}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="inf:ModeOption">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Default effort" Classes="rowlabel" />
                  <TextBlock Text="Thinking effort of new sessions (passed as --effort)." Classes="rowhint" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Efforts}" SelectedItem="{Binding DefaultEffort}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="inf:EffortOption">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>

              <TextBlock Text="Remote Control" Classes="pagetitle" Margin="0,40,0,10" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Remote Control for new sessions" Classes="rowlabel" />
                  <TextBlock Text="Continue sessions from the Claude app or claude.ai while they run here. Each session can turn it off with the phone icon in the status row."
                             Classes="rowhint" TextWrapping="Wrap" MaxWidth="460" HorizontalAlignment="Left" />
                </StackPanel>
                <Button Grid.Column="1" Theme="{StaticResource FlatButton}" Command="{Binding ToggleRemoteControlByDefaultCommand}" VerticalAlignment="Center" Padding="4">
                  <Border Classes="switch" Classes.on="{Binding RemoteControlByDefault}">
                    <Ellipse />
                  </Border>
                </Button>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Start sessions from the phone" Classes="rowlabel" />
                  <TextBlock Text="In these folders Nomad keeps Claude Code's Remote Control server running, so the Claude app and claude.ai/code can start new sessions here. They appear under Alive with a phone icon."
                             Classes="rowhint" TextWrapping="Wrap" MaxWidth="460" HorizontalAlignment="Left" />
                </StackPanel>
                <Button Grid.Column="1" Theme="{StaticResource LineButton}" Click="OnAddPhoneFolderClick" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:Icon Size="13" Data="{StaticResource IconPlus}" />
                    <TextBlock Text="Add folder…" FontWeight="Medium" />
                  </StackPanel>
                </Button>
              </Grid>

              <ItemsControl ItemsSource="{Binding PhoneFolders}" IsVisible="{Binding HasPhoneFolders}" Margin="0,0,0,4">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PhoneFolderRow">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,6">
                      <Ellipse Width="7" Height="7" Margin="2,0,10,0" VerticalAlignment="Center"
                               Fill="{StaticResource TextMutedBrush}"
                               IsVisible="{Binding !IsReady}" />
                      <Ellipse Width="7" Height="7" Margin="2,0,10,0" VerticalAlignment="Center"
                               Fill="{StaticResource SuccessBrush}"
                               IsVisible="{Binding IsReady}" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Folder}" FontFamily="{DynamicResource MonoFont}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Status}" Classes="rowhint" TextWrapping="Wrap" FontSize="{DynamicResource UiFontSizeSmall}" />
                      </StackPanel>
                      <Button Grid.Column="2" Theme="{StaticResource LineButton}" Margin="10,0,0,0" VerticalAlignment="Center"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              IsVisible="{Binding NeedsSetup}"
                              Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).SetUpPhoneFolderCommand}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="Opens claude remote-control in a terminal to answer its one-time questions">
                        <TextBlock Text="Set up" FontWeight="Medium" />
                      </Button>
                      <Button Grid.Column="3" Theme="{StaticResource LineButton}" Margin="10,0,0,0" VerticalAlignment="Center"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              IsVisible="{Binding CanRetry}"
                              Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RetryPhoneFolderCommand}"
                              CommandParameter="{Binding}">
                        <TextBlock Text="Retry" FontWeight="Medium" />
                      </Button>
                      <Button Grid.Column="4" Theme="{StaticResource IconButton}" Margin="6,0,0,0" VerticalAlignment="Center"
                              Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemovePhoneFolderCommand}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="Remove">
                        <c:Icon Size="13" Data="{StaticResource IconClose}" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Classes="rowhint" Margin="0,28,0,0" FontSize="{DynamicResource UiFontSizeSmall}">
                <Run Text="Settings are saved to" />
                <Run Text="{Binding SettingsPath}" FontFamily="{DynamicResource MonoFont}" />
              </TextBlock>
            </StackPanel>

            <!-- Updates -->
            <StackPanel IsVisible="{Binding IsUpdatesPage}">
              <TextBlock Text="Updates" Classes="pagetitle" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12,16,12">
                  <TextBlock Text="{Binding Updates.VersionLine}" Classes="rowlabel" />
                  <TextBlock Text="{Binding Updates.InstallHint}" IsVisible="{Binding !Updates.IsInstalled}" Classes="rowhint" />
                  <TextBlock Text="{Binding Updates.Status}"
                             IsVisible="{Binding Updates.HasStatus}"
                             Classes="rowhint"
                             Classes.attention="{Binding Updates.IsAttention}"
                             Classes.failed="{Binding Updates.IsFailed}" />
                </StackPanel>
                <Panel Grid.Column="1" VerticalAlignment="Center">
                  <Button Theme="{StaticResource PrimaryButton}"
                          IsVisible="{Binding Updates.ActionIsPrimary}"
                          IsEnabled="{Binding Updates.CanAct}"
                          Command="{Binding Updates.ActCommand}"
                          Content="{Binding Updates.ActionText}" />
                  <Button Theme="{StaticResource SecondaryButton}"
                          IsVisible="{Binding !Updates.ActionIsPrimary}"
                          IsEnabled="{Binding Updates.CanAct}"
                          Command="{Binding Updates.ActCommand}"
                          Content="{Binding Updates.ActionText}" />
                </Panel>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Install updates automatically" Classes="rowlabel" />
                  <TextBlock Text="Download new versions in the background and restart into them while no turn is running. Off: Nomad.ai only tells you about them."
                             Classes="rowhint" />
                </StackPanel>
                <Button Grid.Column="1"
                        Theme="{StaticResource FlatButton}"
                        Padding="6"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleAutoUpdateCommand}">
                  <Border Classes="switch" Classes.on="{Binding AutoUpdate}">
                    <Ellipse />
                  </Border>
                </Button>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Include pre-releases" Classes="rowlabel" />
                  <TextBlock Text="Also offer versions published as pre-releases on GitHub." Classes="rowhint" />
                </StackPanel>
                <Button Grid.Column="1"
                        Theme="{StaticResource FlatButton}"
                        Padding="6"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleIncludePrereleasesCommand}">
                  <Border Classes="switch" Classes.on="{Binding IncludePrereleases}">
                    <Ellipse />
                  </Border>
                </Button>
              </Grid>

              <Grid ColumnDefinitions="*,Auto" Margin="0,40,0,4">
                <TextBlock Text="Releases" Classes="pagetitle" Margin="0" VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Theme="{StaticResource LineButton}"
                        Command="{Binding Updates.OpenReleasesPageCommand}"
                        ToolTip.Tip="{Binding Updates.Feed.PageUrl}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="View on GitHub" FontSize="{DynamicResource UiFontSize}" VerticalAlignment="Center" />
                    <c:Icon Size="13" Data="{StaticResource IconArrowRight}" />
                  </StackPanel>
                </Button>
              </Grid>
              <TextBlock Text="{Binding ReleasesStatus}" IsVisible="{Binding HasReleasesStatus}" Classes="rowhint" Margin="0,6,0,10" />

              <ItemsControl ItemsSource="{Binding Releases}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ReleaseItemViewModel">
                    <StackPanel>
                      <Button Theme="{StaticResource LineButton}"
                              Command="{Binding ToggleCommand}"
                              HorizontalAlignment="Stretch"
                              Padding="0,11">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <c:Icon Classes="chev" Classes.open="{Binding IsExpanded}" Size="13" Data="{StaticResource IconChevronRight}" Margin="-3,0,0,0" />
                          <TextBlock Text="{Binding Tag}" FontSize="{DynamicResource UiFontSizeLarge}" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding DateText}" FontSize="{DynamicResource UiFontSize}" VerticalAlignment="Center" />
                          <Border Classes="tag installed" IsVisible="{Binding IsInstalled}">
                            <TextBlock Text="installed" />
                          </Border>
                          <Border Classes="tag newer" IsVisible="{Binding IsNewer}">
                            <TextBlock Text="newer" />
                          </Border>
                          <Border Classes="tag" IsVisible="{Binding IsPrerelease}">
                            <TextBlock Text="pre-release" />
                          </Border>
                        </StackPanel>
                      </Button>
                      <md:MarkdownView Markdown="{Binding VisibleNotes}" IsVisible="{Binding IsExpanded}" Margin="21,0,0,16" />
                      <TextBlock Text="No release notes." IsVisible="{Binding ShowNoNotes}" Classes="rowhint" Margin="21,0,0,16" />
                      <Border Classes="rowline" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Panel>
        </ScrollViewer>

        <Button Theme="{StaticResource IconButton}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,14,16,0"
                Foreground="{StaticResource TextPrimaryBrush}"
                Click="OnCloseClick"
                ToolTip.Tip="Close (Esc)">
          <c:Icon Data="{StaticResource IconClose}" StrokeThickness="1.6" />
        </Button>
      </Panel>
    </Grid>
  </Border>
</UserControl>
