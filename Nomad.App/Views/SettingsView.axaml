<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nomad.App.ViewModels"
             xmlns:inf="using:Nomad.App.Infrastructure"
             xmlns:c="using:Nomad.App.Controls"
             xmlns:agents="using:Nomad.Core.Agents"
             xmlns:md="using:Nomad.App.Markdown"
             x:Class="Nomad.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Focusable="True">

  <!-- Flat combo boxes: text + chevron, like the original's font pickers. -->
  <UserControl.Resources>
    <SolidColorBrush x:Key="ComboBoxBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="Transparent" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="Transparent" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBlock.pagetitle">
      <Setter Property="FontSize" Value="{DynamicResource UiFontSizeTitle}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="TextBlock.rowlabel">
      <Setter Property="FontSize" Value="{DynamicResource UiFontSizeLarge}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.rowhint">
      <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
    <Style Selector="Grid.row">
      <Setter Property="MinHeight" Value="56" />
    </Style>
    <Style Selector="Border.rowline">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource BgSegmentsBrush}" />
    </Style>
    <Style Selector="Border.segments">
      <Setter Property="Background" Value="{DynamicResource BgSegmentsBrush}" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinWidth" Value="200" />
      <Setter Property="HorizontalContentAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
      <Setter Property="MaxDropDownHeight" Value="420" />
    </Style>
    <!-- Color theme editor: a swatch, the token's name and its hex value; reset shows once it differs from Nomad's. -->
    <Style Selector="TextBlock.colorgroup">
      <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSmall}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBlock.colorlabel">
      <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
    <Style Selector="Border.swatch">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderInputBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <!-- The color theme picker's dots: a theme's background, accent and focus colors. -->
    <Style Selector="Ellipse.themedot">
      <Setter Property="Width" Value="11" />
      <Setter Property="Height" Value="11" />
      <Setter Property="Stroke" Value="{DynamicResource BorderInputBrush}" />
      <Setter Property="StrokeThickness" Value="1" />
    </Style>
    <Style Selector="Border.swatch:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="Button.reset">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.reset.changed">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <!-- Updates page: the status line's colours, release markers and the chevron of a release. -->
    <Style Selector="TextBlock.rowhint.attention">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBlock.rowhint.failed">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Border.tag">
      <Setter Property="Background" Value="{DynamicResource BgSegmentsBrush}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,1,6,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.tag > TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSmall}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Border.tag.installed">
      <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    </Style>
    <Style Selector="Border.tag.installed > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.tag.newer">
      <Setter Property="Background" Value="{DynamicResource LinkSubtleBrush}" />
    </Style>
    <Style Selector="Border.tag.newer > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
    </Style>
    <Style Selector="c|Icon.chev">
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
    </Style>
    <Style Selector="c|Icon.chev.open">
      <Setter Property="RenderTransform" Value="rotate(90deg)" />
    </Style>
    <!-- A page fades in and rises a little into place as it is shown. -->
    <Style Selector="StackPanel.page[IsVisible=True]">
      <Style.Animations>
        <Animation Duration="0:0:0.2" Easing="CubicEaseOut">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="8" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Border.field">
      <Setter Property="Background" Value="{DynamicResource BgFieldBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderFieldBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Height" Value="31" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource BgSettingsBrush}"
          BorderBrush="{DynamicResource BorderSettingsBrush}"
          BorderThickness="1"
          CornerRadius="12"
          MaxWidth="1278"
          MaxHeight="935"
          Margin="24,48"
          ClipToBounds="True"
          BoxShadow="0 16 48 0 #59000000">
    <Grid ColumnDefinitions="211,*">

      <!-- Navigation -->
      <Border Background="{DynamicResource BgMainBrush}" BorderBrush="{DynamicResource BorderCardBrush}" BorderThickness="0,0,1,0">
        <StackPanel Margin="12,0" Spacing="1">
          <TextBlock Text="Settings" Classes="section" FontSize="{DynamicResource UiFontSizeSmall}" Margin="8,30,0,10" />
          <Button Theme="{StaticResource NavButton}" Classes.selected="{Binding IsGeneralPage}" Command="{Binding ShowGeneralCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <c:Icon Data="{StaticResource IconGear}" />
              <TextBlock Text="General" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Theme="{StaticResource NavButton}" Classes.selected="{Binding IsClaudeCodePage}" Command="{Binding ShowClaudeCodeCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <c:Icon Data="{StaticResource IconTerminal}" />
              <TextBlock Text="Claude Code" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Theme="{StaticResource NavButton}" Classes.selected="{Binding IsUpdatesPage}" Command="{Binding ShowUpdatesCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <c:Icon Data="{StaticResource IconUpdate}" />
              <TextBlock Text="Updates" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <!-- Pages -->
      <Panel Grid.Column="1">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Panel Margin="24,58,34,32">

            <!-- General -->
            <StackPanel Classes="page" IsVisible="{Binding IsGeneralPage}">
              <StackPanel.RenderTransform><TranslateTransform /></StackPanel.RenderTransform>
              <TextBlock Text="Appearance" Classes="pagetitle" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Theme" Classes="rowlabel" />
                  <TextBlock Text="System follows the Windows app mode." Classes="rowhint" />
                </StackPanel>
                <Border Grid.Column="1" Classes="segments">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="Theme" IsChecked="{Binding IsThemeDark}" Content="Dark" />
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="Theme" IsChecked="{Binding IsThemeLight}" Content="Light" />
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="Theme" IsChecked="{Binding IsThemeSystem}" Content="System" />
                  </StackPanel>
                </Border>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12,16,12">
                  <TextBlock Text="Color theme" Classes="rowlabel" />
                  <TextBlock Text="Nomad and its presets are built in. Duplicate a theme to make one of your own and change its colors, or import one exported as JSON."
                             Classes="rowhint" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <ComboBox ItemsSource="{Binding ColorThemes}" SelectedItem="{Binding SelectedColorTheme}" MinWidth="160">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ThemeChoice">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <StackPanel Orientation="Horizontal" Spacing="-3" VerticalAlignment="Center">
                            <Ellipse Classes="themedot" Fill="{Binding Background}" />
                            <Ellipse Classes="themedot" Fill="{Binding Accent}" />
                            <Ellipse Classes="themedot" Fill="{Binding Focus}" />
                          </StackPanel>
                          <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Theme="{StaticResource LineButton}" Command="{Binding DuplicateThemeCommand}" VerticalAlignment="Center"
                          Foreground="{DynamicResource TextPrimaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <c:Icon Size="13" Data="{StaticResource IconCopy}" />
                      <TextBlock Text="Duplicate" FontWeight="Medium" />
                    </StackPanel>
                  </Button>
                  <Button Theme="{StaticResource LineButton}" Click="OnImportThemeClick" VerticalAlignment="Center"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          ToolTip.Tip="Add a theme from a JSON file">
                    <TextBlock Text="Import…" FontWeight="Medium" />
                  </Button>
                  <Button Theme="{StaticResource LineButton}" Click="OnExportThemeClick" VerticalAlignment="Center"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          ToolTip.Tip="Save this theme as a JSON file">
                    <TextBlock Text="Export…" FontWeight="Medium" />
                  </Button>
                  <Button Theme="{StaticResource IconButton}" Command="{Binding DeleteThemeCommand}" VerticalAlignment="Center"
                          IsVisible="{Binding IsCustomTheme}"
                          ToolTip.Tip="Delete this theme (to the Recycle Bin)">
                    <c:Icon Size="13" Data="{StaticResource IconClose}" />
                  </Button>
                </StackPanel>
              </Grid>

              <!-- Why an import or export failed. -->
              <TextBlock Classes="rowhint failed" Text="{Binding ThemeFileProblem}" Margin="0,0,0,12"
                         c:Fold.IsOpen="{Binding ThemeFileProblem, Converter={x:Static ObjectConverters.IsNotNull}}" IsVisible="False" />

              <!-- A custom theme's name and colors, folding open under its picker. -->
              <StackPanel c:Fold.IsOpen="{Binding IsCustomTheme}" IsVisible="False">
                <Border Classes="rowline" />
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <TextBlock Text="Theme name" Classes="rowlabel" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Classes="field" Width="240">
                    <TextBox Theme="{StaticResource BareTextBox}" Text="{Binding ThemeName}" Watermark="Name" FontSize="{DynamicResource UiFontSize}" />
                  </Border>
                </Grid>
                <Border Classes="rowline" />
                <StackPanel Margin="0,12,0,4">
                  <TextBlock Text="Colors" Classes="rowlabel" />
                  <TextBlock Text="{Binding ThemeColorsHint}" Classes="rowhint" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding ThemeColorGroups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ThemeColorGroup">
                      <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="{Binding Title}" Classes="colorgroup" />
                        <ItemsControl ItemsSource="{Binding Colors}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ThemeColorRow">
                              <Grid ColumnDefinitions="Auto,*,Auto,26" Margin="0,3,16,3">
                                <Border Classes="swatch" Background="{Binding Swatch}" PointerPressed="OnSwatchPressed" ToolTip.Tip="Pick a color">
                                  <FlyoutBase.AttachedFlyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="menu">
                                      <c:ColorPad Color="{Binding Color}" Margin="5" />
                                    </Flyout>
                                  </FlyoutBase.AttachedFlyout>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Label}" Classes="colorlabel" />
                                <Border Grid.Column="2" Classes="field" Width="96" Height="26" Padding="8,0">
                                  <TextBox Theme="{StaticResource BareTextBox}" Text="{Binding Hex}" MaxLength="9" FontSize="{DynamicResource UiFontSizeSmall}" />
                                </Border>
                                <Button Grid.Column="3" Theme="{StaticResource IconButton}" Classes="reset" Classes.changed="{Binding IsChanged}"
                                        Command="{Binding ResetCommand}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                        ToolTip.Tip="Back to Nomad's color">
                                  <c:Icon Size="12" Data="{StaticResource IconRewind}" />
                                </Button>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Interface font" Classes="rowlabel" />
                  <TextBlock Text="Font for the whole interface — menus, sidebar and transcript." Classes="rowhint" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding UiFonts}" SelectedItem="{Binding InterfaceFont}" />
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Code font" Classes="rowlabel" />
                  <TextBlock Text="Used for code blocks, inline code and tool details." Classes="rowhint" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding CodeFonts}" SelectedItem="{Binding CodeFont}" />
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <TextBlock Text="Interface text size" Classes="rowlabel" VerticalAlignment="Center" />
                <Border Grid.Column="1" Classes="segments">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="UiTextSize" IsChecked="{Binding IsUiTextSmall}" Content="Small" />
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="UiTextSize" IsChecked="{Binding IsUiTextMedium}" Content="Medium" />
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="UiTextSize" IsChecked="{Binding IsUiTextLarge}" Content="Large" />
                  </StackPanel>
                </Border>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <TextBlock Text="Transcript text size" Classes="rowlabel" VerticalAlignment="Center" />
                <Border Grid.Column="1" Classes="segments">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="TextSize" IsChecked="{Binding IsTextSmall}" Content="Small" />
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="TextSize" IsChecked="{Binding IsTextMedium}" Content="Medium" />
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="TextSize" IsChecked="{Binding IsTextLarge}" Content="Large" />
                  </StackPanel>
                </Border>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Transcript width" Classes="rowlabel" />
                  <TextBlock Text="Maximum width of the transcript and composer columns." Classes="rowhint" />
                </StackPanel>
                <Border Grid.Column="1" Classes="segments">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="Width" IsChecked="{Binding IsWidthNarrow}" Content="Narrow" />
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="Width" IsChecked="{Binding IsWidthMedium}" Content="Medium" />
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="Width" IsChecked="{Binding IsWidthWide}" Content="Wide" />
                  </StackPanel>
                </Border>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Usage ring" Classes="rowlabel" />
                  <TextBlock Text="The ring at the end of the status row: your weekly plan usage, spinning while Claude works. Click it for the usage limits."
                             Classes="rowhint" />
                </StackPanel>
                <Button Grid.Column="1" Theme="{StaticResource FlatButton}" Padding="6" VerticalAlignment="Center" Command="{Binding ToggleShowUsageRingCommand}">
                  <Border Classes="switch large" Classes.on="{Binding ShowUsageRing}">
                    <Ellipse />
                  </Border>
                </Button>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Folder tree on the right" Classes="rowlabel" />
                  <TextBlock Text="In a chat's Files view, the folder tree is on the right and the open file on the left. Off: the other way round."
                             Classes="rowhint" />
                </StackPanel>
                <Button Grid.Column="1" Theme="{StaticResource FlatButton}" Padding="6" VerticalAlignment="Center" Command="{Binding ToggleFileTreeOnRightCommand}">
                  <Border Classes="switch large" Classes.on="{Binding FileTreeOnRight}">
                    <Ellipse />
                  </Border>
                </Button>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Chat / Files key" Classes="rowlabel" />
                  <TextBlock Text="Switches a chat between its conversation and its Files view. Click, then press the key to use (Esc keeps the current one). In the composer, Tab still completes a / command or takes a suggestion first."
                             Classes="rowhint" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <Button Theme="{StaticResource FlatButton}"
                          Padding="4"
                          IsVisible="{Binding IsFilesViewKeyChanged}"
                          Command="{Binding ResetFilesKeyCommand}"
                          ToolTip.Tip="Back to Tab">
                    <c:Icon Size="13" Data="{StaticResource IconRewind}" />
                  </Button>
                  <Button Theme="{StaticResource FlatButton}"
                          MinWidth="96"
                          Padding="12,5"
                          HorizontalContentAlignment="Center"
                          Background="{DynamicResource BgButtonBrush}"
                          BorderBrush="{DynamicResource BorderInputBrush}"
                          BorderThickness="1"
                          Classes.capturing="{Binding IsCapturingFilesKey}"
                          Command="{Binding CaptureFilesKeyCommand}">
                    <TextBlock Text="{Binding FilesViewKeyText}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource UiFontSizeSmall}" />
                  </Button>
                </StackPanel>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Compact model picker" Classes="rowlabel" />
                  <TextBlock Text="The status row shows only the current model. The other models and the effort slider are in its menu."
                             Classes="rowhint" />
                </StackPanel>
                <Button Grid.Column="1" Theme="{StaticResource FlatButton}" Padding="6" VerticalAlignment="Center" Command="{Binding ToggleCompactModelPickerCommand}">
                  <Border Classes="switch large" Classes.on="{Binding CompactModelPicker}">
                    <Ellipse />
                  </Border>
                </Button>
              </Grid>

              <TextBlock Text="Sessions" Classes="pagetitle" Margin="0,40,0,10" />
              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Archive old sessions" Classes="rowlabel" />
                  <TextBlock Text="Archive sessions left untouched for a while. Alive and open ones are kept; &quot;Show archived&quot; in the sidebar lists them again."
                             Classes="rowhint" />
                </StackPanel>
                <Button Grid.Column="1"
                        Theme="{StaticResource FlatButton}"
                        Padding="6"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleAutoArchiveCommand}">
                  <Border Classes="switch large" Classes.on="{Binding AutoArchive}">
                    <Ellipse />
                  </Border>
                </Button>
              </Grid>
              <Border Classes="rowline" />
              <Grid Classes="row" ColumnDefinitions="*,Auto" IsEnabled="{Binding AutoArchive}">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Archive after" Classes="rowlabel" />
                  <TextBlock Text="Hours without activity before a session is archived (at least 1)." Classes="rowhint" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Border Classes="field" Width="72">
                    <TextBox Theme="{StaticResource BareTextBox}" Text="{Binding AutoArchiveHoursText}" Watermark="24" TextAlignment="Right" FontSize="{DynamicResource UiFontSize}" />
                  </Border>
                  <TextBlock Text="hours" Classes="rowhint" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>

              <TextBlock Text="Window" Classes="pagetitle" Margin="0,40,0,10" />
              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Close to the tray" Classes="rowlabel" />
                  <TextBlock Text="Closing the window keeps Nomad.ai running in the notification area, sessions and all. Click its icon to bring it back; Exit (in the menu or the icon's) quits."
                             Classes="rowhint" />
                </StackPanel>
                <Button Grid.Column="1"
                        Theme="{StaticResource FlatButton}"
                        Padding="6"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleCloseToTrayCommand}">
                  <Border Classes="switch large" Classes.on="{Binding CloseToTray}">
                    <Ellipse />
                  </Border>
                </Button>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Notifications" Classes="rowlabel" />
                  <TextBlock Text="A Windows notification when a session finishes or needs an answer while Nomad.ai is in the background. Click it to come back."
                             Classes="rowhint" />
                </StackPanel>
                <Button Grid.Column="1" Theme="{StaticResource FlatButton}" Padding="6" VerticalAlignment="Center" Command="{Binding ToggleNotifyWhenDoneCommand}">
                  <Border Classes="switch large" Classes.on="{Binding NotifyWhenDone}">
                    <Ellipse />
                  </Border>
                </Button>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Flash the taskbar" Classes="rowlabel" />
                  <TextBlock Text="The taskbar button flashes then too, until you bring the window up." Classes="rowhint" />
                </StackPanel>
                <Button Grid.Column="1" Theme="{StaticResource FlatButton}" Padding="6" VerticalAlignment="Center" Command="{Binding ToggleFlashTaskbarCommand}">
                  <Border Classes="switch large" Classes.on="{Binding FlashTaskbar}">
                    <Ellipse />
                  </Border>
                </Button>
              </Grid>

              <TextBlock Text="Account" Classes="pagetitle" Margin="0,40,0,10" />
              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Display name" Classes="rowlabel" />
                  <TextBlock Text="Shown at the bottom of the sidebar. Empty uses your Windows user name." Classes="rowhint" />
                </StackPanel>
                <Border Grid.Column="1" Classes="field" Width="260">
                  <TextBox Theme="{StaticResource BareTextBox}" Text="{Binding DisplayName}" Watermark="Your name" FontSize="{DynamicResource UiFontSize}" />
                </Border>
              </Grid>
            </StackPanel>

            <!-- Claude Code -->
            <StackPanel Classes="page" IsVisible="{Binding IsClaudeCodePage}">
              <StackPanel.RenderTransform><TranslateTransform /></StackPanel.RenderTransform>
              <TextBlock Text="Claude Code" Classes="pagetitle" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="CLI path" Classes="rowlabel" />
                  <TextBlock Text="The claude executable Nomad.ai starts. &quot;claude&quot; looks it up on PATH." Classes="rowhint" />
                  <TextBlock Text="{Binding CliStatus}" Classes="rowhint" Classes.ok="{Binding CliFound}" FontSize="{DynamicResource UiFontSizeSmall}" />
                </StackPanel>
                <Border Grid.Column="1" Classes="field" Width="360">
                  <TextBox Theme="{StaticResource BareTextBox}" Text="{Binding CliPath}" Watermark="claude" FontSize="{DynamicResource UiFontSize}" FontFamily="{DynamicResource MonoFont}" />
                </Border>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="OpenCode path" Classes="rowlabel" />
                  <TextBlock Text="The opencode executable, for sessions on OpenCode (the agent chip by the model). Its providers and models are OpenCode's own: opencode auth login." Classes="rowhint" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding OpenCodeStatus}" Classes="rowhint" Classes.ok="{Binding OpenCodeFound}" FontSize="{DynamicResource UiFontSizeSmall}" />
                </StackPanel>
                <Border Grid.Column="1" Classes="field" Width="360">
                  <TextBox Theme="{StaticResource BareTextBox}" Text="{Binding OpenCodePath}" Watermark="opencode" FontSize="{DynamicResource UiFontSize}" FontFamily="{DynamicResource MonoFont}" />
                </Border>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Main agent" Classes="rowlabel" />
                  <TextBlock Text="Its sessions show no logo in the sidebar; the other agents' sessions do. None: every session shows its logo." Classes="rowhint" TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding MainBackends}" SelectedItem="{Binding MainBackend}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="agents:AgentBackendInfo">
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Ask before switching models" Classes="rowlabel" />
                  <TextBlock Text="A conversation is cached for its model: after a switch the next reply reads all of it again, slower and using more of your plan."
                             Classes="rowhint" />
                </StackPanel>
                <Button Grid.Column="1"
                        Theme="{StaticResource FlatButton}"
                        Padding="6"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleConfirmModelSwitchCommand}">
                  <Border Classes="switch large" Classes.on="{Binding ConfirmModelSwitch}">
                    <Ellipse />
                  </Border>
                </Button>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="F1–F4 switch the model" Classes="rowlabel" />
                  <TextBlock Text="On the new session screen: F1 Fable, F2 Opus, F3 Sonnet, F4 Haiku, besides Ctrl+Shift+1…4."
                             Classes="rowhint" />
                </StackPanel>
                <Button Grid.Column="1"
                        Theme="{StaticResource FlatButton}"
                        Padding="6"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleModelFunctionKeysCommand}">
                  <Border Classes="switch large" Classes.on="{Binding ModelFunctionKeys}">
                    <Ellipse />
                  </Border>
                </Button>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Suggest the next prompt" Classes="rowlabel" />
                  <TextBlock Text="After a turn, Claude Code guesses what you'll ask next; it shows as grey text in the empty composer. Tab, → or a right-click takes it, Esc dismisses it. Applies to sessions started from now on."
                             Classes="rowhint" />
                </StackPanel>
                <Button Grid.Column="1"
                        Theme="{StaticResource FlatButton}"
                        Padding="6"
                        VerticalAlignment="Center"
                        Command="{Binding TogglePromptSuggestionsCommand}">
                  <Border Classes="switch large" Classes.on="{Binding PromptSuggestions}">
                    <Ellipse />
                  </Border>
                </Button>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Workflow size" Classes="rowlabel" />
                  <TextBlock Text="How many agents Claude's workflows aim to stay under: Small fewer than 5, Medium fewer than 10, Large fewer than 50. Running sessions take it at once."
                             Classes="rowhint" />
                </StackPanel>
                <Border Grid.Column="1" Classes="segments">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="WorkflowSize" IsChecked="{Binding IsWorkflowSmall}" Content="Small" />
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="WorkflowSize" IsChecked="{Binding IsWorkflowMedium}" Content="Medium" />
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="WorkflowSize" IsChecked="{Binding IsWorkflowLarge}" Content="Large" />
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="WorkflowSize" IsChecked="{Binding IsWorkflowUnrestricted}" Content="No limit" />
                  </StackPanel>
                </Border>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Default model" Classes="rowlabel" />
                  <TextBlock Text="Model of new sessions; each session can switch from the status row." Classes="rowhint" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Models}" SelectedItem="{Binding DefaultModel}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="inf:ModelOption">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Default permission mode" Classes="rowlabel" />
                  <TextBlock Text="How new sessions ask before Claude changes things." Classes="rowhint" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Modes}" SelectedItem="{Binding DefaultMode}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="inf:ModeOption">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Default effort" Classes="rowlabel" />
                  <TextBlock Text="Opus 5.5&apos;s starting effort (passed as --effort). Each model then keeps the effort last chosen with it; the others start at High." Classes="rowhint" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Efforts}" SelectedItem="{Binding DefaultEffort}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="inf:EffortOption">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>

              <TextBlock Text="Remote Control" Classes="pagetitle" Margin="0,40,0,10" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Remote Control for new sessions" Classes="rowlabel" />
                  <TextBlock Text="Continue sessions from the Claude app or claude.ai while they run here. Each session can turn it off with the phone icon in the status row."
                             Classes="rowhint" TextWrapping="Wrap" MaxWidth="460" HorizontalAlignment="Left" />
                </StackPanel>
                <Button Grid.Column="1" Theme="{StaticResource FlatButton}" Command="{Binding ToggleRemoteControlByDefaultCommand}" VerticalAlignment="Center" Padding="4">
                  <Border Classes="switch large" Classes.on="{Binding RemoteControlByDefault}">
                    <Ellipse />
                  </Border>
                </Button>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Start sessions from the phone" Classes="rowlabel" />
                  <TextBlock Text="In these folders Nomad keeps Claude Code's Remote Control server running, so the Claude app and claude.ai/code can start new sessions here. They appear under Alive with a phone icon."
                             Classes="rowhint" TextWrapping="Wrap" MaxWidth="460" HorizontalAlignment="Left" />
                </StackPanel>
                <Button Grid.Column="1" Theme="{StaticResource LineButton}" Click="OnAddPhoneFolderClick" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:Icon Size="13" Data="{StaticResource IconPlus}" />
                    <TextBlock Text="Add folder…" FontWeight="Medium" />
                  </StackPanel>
                </Button>
              </Grid>

              <ItemsControl ItemsSource="{Binding PhoneFolders}" IsVisible="{Binding HasPhoneFolders}" Margin="0,0,0,4">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PhoneFolderRow">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,6">
                      <Ellipse Width="7" Height="7" Margin="2,0,10,0" VerticalAlignment="Center"
                               Fill="{DynamicResource TextMutedBrush}"
                               IsVisible="{Binding !IsReady}" />
                      <Ellipse Width="7" Height="7" Margin="2,0,10,0" VerticalAlignment="Center"
                               Fill="{DynamicResource SuccessBrush}"
                               IsVisible="{Binding IsReady}" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Folder}" FontFamily="{DynamicResource MonoFont}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Status}" Classes="rowhint" TextWrapping="Wrap" FontSize="{DynamicResource UiFontSizeSmall}" />
                      </StackPanel>
                      <Button Grid.Column="2" Theme="{StaticResource LineButton}" Margin="10,0,0,0" VerticalAlignment="Center"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              IsVisible="{Binding NeedsSetup}"
                              Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).SetUpPhoneFolderCommand}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="Opens claude remote-control in a terminal to answer its one-time questions">
                        <TextBlock Text="Set up" FontWeight="Medium" />
                      </Button>
                      <Button Grid.Column="3" Theme="{StaticResource LineButton}" Margin="10,0,0,0" VerticalAlignment="Center"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              IsVisible="{Binding CanRetry}"
                              Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RetryPhoneFolderCommand}"
                              CommandParameter="{Binding}">
                        <TextBlock Text="Retry" FontWeight="Medium" />
                      </Button>
                      <Button Grid.Column="4" Theme="{StaticResource IconButton}" Margin="6,0,0,0" VerticalAlignment="Center"
                              Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemovePhoneFolderCommand}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="Remove">
                        <c:Icon Size="13" Data="{StaticResource IconClose}" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Classes="rowhint" Margin="0,28,0,0" FontSize="{DynamicResource UiFontSizeSmall}">
                <Run Text="Settings are saved to" />
                <Run Text="{Binding SettingsPath}" FontFamily="{DynamicResource MonoFont}" />
              </TextBlock>
            </StackPanel>

            <!-- Updates -->
            <StackPanel Classes="page" IsVisible="{Binding IsUpdatesPage}">
              <StackPanel.RenderTransform><TranslateTransform /></StackPanel.RenderTransform>
              <TextBlock Text="Updates" Classes="pagetitle" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12,16,12">
                  <TextBlock Text="{Binding Updates.VersionLine}" Classes="rowlabel" />
                  <TextBlock Text="{Binding Updates.InstallHint}" IsVisible="{Binding !Updates.IsInstalled}" Classes="rowhint" />
                  <TextBlock Text="{Binding Updates.Status}"
                             IsVisible="{Binding Updates.HasStatus}"
                             Classes="rowhint"
                             Classes.attention="{Binding Updates.IsAttention}"
                             Classes.failed="{Binding Updates.IsFailed}" />
                </StackPanel>
                <Panel Grid.Column="1" VerticalAlignment="Center">
                  <Button Theme="{StaticResource PrimaryButton}"
                          IsVisible="{Binding Updates.ActionIsPrimary}"
                          IsEnabled="{Binding Updates.CanAct}"
                          Command="{Binding Updates.ActCommand}"
                          Content="{Binding Updates.ActionText}" />
                  <Button Theme="{StaticResource SecondaryButton}"
                          IsVisible="{Binding !Updates.ActionIsPrimary}"
                          IsEnabled="{Binding Updates.CanAct}"
                          Command="{Binding Updates.ActCommand}"
                          Content="{Binding Updates.ActionText}" />
                </Panel>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Install updates automatically" Classes="rowlabel" />
                  <TextBlock Text="Download new versions in the background and restart into them while no turn is running. Off: Nomad.ai only tells you about them."
                             Classes="rowhint" />
                </StackPanel>
                <Button Grid.Column="1"
                        Theme="{StaticResource FlatButton}"
                        Padding="6"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleAutoUpdateCommand}">
                  <Border Classes="switch large" Classes.on="{Binding AutoUpdate}">
                    <Ellipse />
                  </Border>
                </Button>
              </Grid>
              <Border Classes="rowline" />

              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Include pre-releases" Classes="rowlabel" />
                  <TextBlock Text="Also offer versions published as pre-releases on GitHub." Classes="rowhint" />
                </StackPanel>
                <Button Grid.Column="1"
                        Theme="{StaticResource FlatButton}"
                        Padding="6"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleIncludePrereleasesCommand}">
                  <Border Classes="switch large" Classes.on="{Binding IncludePrereleases}">
                    <Ellipse />
                  </Border>
                </Button>
              </Grid>

              <Grid ColumnDefinitions="*,Auto" Margin="0,40,0,4">
                <TextBlock Text="Releases" Classes="pagetitle" Margin="0" VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Theme="{StaticResource LineButton}"
                        Command="{Binding Updates.OpenReleasesPageCommand}"
                        ToolTip.Tip="{Binding Updates.Feed.PageUrl}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="View on GitHub" FontSize="{DynamicResource UiFontSize}" VerticalAlignment="Center" />
                    <c:Icon Size="13" Data="{StaticResource IconArrowRight}" />
                  </StackPanel>
                </Button>
              </Grid>
              <TextBlock Text="{Binding ReleasesStatus}" IsVisible="{Binding HasReleasesStatus}" Classes="rowhint" Margin="0,6,0,10" />

              <ItemsControl ItemsSource="{Binding Releases}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ReleaseItemViewModel">
                    <StackPanel>
                      <Button Theme="{StaticResource LineButton}"
                              Command="{Binding ToggleCommand}"
                              HorizontalAlignment="Stretch"
                              Padding="0,11">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <c:Icon Classes="chev" Classes.open="{Binding IsExpanded}" Size="13" Data="{StaticResource IconChevronRight}" Margin="-3,0,0,0" />
                          <TextBlock Text="{Binding Tag}" FontSize="{DynamicResource UiFontSizeLarge}" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding DateText}" FontSize="{DynamicResource UiFontSize}" VerticalAlignment="Center" />
                          <Border Classes="tag installed" IsVisible="{Binding IsInstalled}">
                            <TextBlock Text="installed" />
                          </Border>
                          <Border Classes="tag newer" IsVisible="{Binding IsNewer}">
                            <TextBlock Text="newer" />
                          </Border>
                          <Border Classes="tag" IsVisible="{Binding IsPrerelease}">
                            <TextBlock Text="pre-release" />
                          </Border>
                        </StackPanel>
                      </Button>
                      <md:MarkdownView Markdown="{Binding VisibleNotes}" IsVisible="{Binding IsExpanded}" Margin="21,0,0,16" />
                      <TextBlock Text="No release notes." IsVisible="{Binding ShowNoNotes}" Classes="rowhint" Margin="21,0,0,16" />
                      <Border Classes="rowline" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Panel>
        </ScrollViewer>

        <Button Theme="{StaticResource IconButton}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,14,16,0"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Click="OnCloseClick"
                ToolTip.Tip="Close (Esc)">
          <c:Icon Data="{StaticResource IconClose}" StrokeThickness="1.6" />
        </Button>
      </Panel>
    </Grid>
  </Border>
</UserControl>
