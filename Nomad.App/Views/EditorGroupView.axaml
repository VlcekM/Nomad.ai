<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nomad.App.ViewModels"
             xmlns:c="using:Nomad.App.Controls"
             xmlns:ide="using:Nomad.App.Ide"
             x:Class="Nomad.App.Views.EditorGroupView"
             x:DataType="vm:EditorGroup">

  <!-- One group of the Files view, as in Visual Studio: a row of tabs over a card holding the file. The active tab is
       joined to the card (TabShape); pinned tabs come first, and the preview tab (in italics) sits at the right end. -->
  <UserControl.Resources>
    <ResourceDictionary>
    <!-- A tab: the row's and the preview slot's. -->
    <DataTemplate x:Key="TabTemplate" x:DataType="vm:FileTab">
      <Panel Classes="tab"
             Classes.active="{Binding IsActive}"
             Classes.pinned="{Binding IsPinned}"
             Classes.preview="{Binding IsPreview}"
             Classes.dirty="{Binding IsDirty}"
             ToolTip.Tip="{Binding Path}"
             ToolTip.ShowDelay="700"
             PointerPressed="OnTabPressed"
             Loaded="OnTabLoaded">
        <Panel.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{Binding PinText}" Command="{Binding Group.TogglePinCommand}" CommandParameter="{Binding}" />
            <MenuItem Header="Move to the side" Command="{Binding Group.OpenToSideCommand}" CommandParameter="{Binding}" />
            <Separator />
            <MenuItem Header="Close" InputGesture="Ctrl+W" Command="{Binding Group.CloseCommand}" CommandParameter="{Binding}" />
            <MenuItem Header="Close others" Command="{Binding Group.CloseOthersCommand}" CommandParameter="{Binding}" />
          </ContextMenu>
        </Panel.ContextMenu>
        <Border Classes="wash" />
        <ide:TabShape Classes.focused="{Binding IsFocused}" FlushLeft="{Binding IsFirst}" />
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="12,1,6,0" VerticalAlignment="Center">
          <c:Icon Classes="tabicon" Size="13" Data="{StaticResource IconFile}" />
          <TextBlock Classes="tabname" Text="{Binding Name}" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" Spacing="1" Margin="2,0,0,0">
            <Button Theme="{StaticResource IconButton}" Classes="tabaction tabpin" Command="{Binding Group.TogglePinCommand}" CommandParameter="{Binding}" ToolTip.Tip="{Binding PinText}">
              <c:Icon Size="11" Data="{StaticResource IconPin}" />
            </Button>
            <Panel>
              <!-- Unsaved edits: a dot where the close button is, which hover brings back. -->
              <Ellipse Classes="dirtydot" Width="8" Height="8" IsHitTestVisible="False" />
              <Button Theme="{StaticResource IconButton}" Classes="tabaction tabclose" Command="{Binding Group.CloseCommand}" CommandParameter="{Binding}" ToolTip.Tip="Close (Ctrl+W)">
                <c:Icon Size="10" Data="{StaticResource IconClose}" />
              </Button>
            </Panel>
          </StackPanel>
        </StackPanel>
      </Panel>
    </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Panel.tab">
      <Setter Property="Height" Value="32" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Panel.tab TextBlock.tabname">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.15" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Panel.tab:pointerover TextBlock.tabname, Panel.tab.active TextBlock.tabname">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Panel.tab.preview TextBlock.tabname">
      <Setter Property="FontStyle" Value="Italic" />
    </Style>
    <Style Selector="Panel.tab c|Icon.tabicon">
      <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <!-- Hover on an inactive tab: a soft rounded wash; the active one is drawn by its shape. -->
    <Style Selector="Panel.tab Border.wash">
      <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
      <Setter Property="CornerRadius" Value="7,7,0,0" />
      <Setter Property="Margin" Value="0,3,0,1" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Panel.tab:pointerover:not(.active) Border.wash">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Panel.tab ide|TabShape">
      <Setter Property="Fill" Value="{DynamicResource CodeBackgroundBrush}" />
      <Setter Property="Stroke" Value="{DynamicResource BorderCardBrush}" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Panel.tab.active ide|TabShape">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Panel.tab ide|TabShape.focused">
      <Setter Property="Accent" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- Pin and close: shown on the active tab and on hover; a pinned tab keeps its pin and has no close. -->
    <Style Selector="Panel.tab Button.tabaction">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Panel.tab:pointerover Button.tabaction, Panel.tab.active Button.tabclose, Panel.tab.pinned Button.tabpin">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Panel.tab Ellipse.dirtydot">
      <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Panel.tab.dirty:not(:pointerover) Ellipse.dirtydot">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Panel.tab.dirty:not(:pointerover) Button.tabclose">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Panel.tab.pinned Button.tabclose">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Panel.tab.pinned Button.tabpin">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Border.docbar">
      <Setter Property="Padding" Value="14,7,8,7" />
      <Setter Property="Background" Value="{DynamicResource BgRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.docbar Button">
      <Setter Property="Height" Value="26" />
    </Style>
    <!-- In a style, not on the card itself, so .flush can override it. -->
    <Style Selector="Border#Card">
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <!-- Compare: on while the diff shows. -->
    <Style Selector="Button.difftoggle">
      <Setter Property="Height" Value="22" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSmall}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.difftoggle.on">
      <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- The diff view: over the text, fading in and out. -->
    <Style Selector="Border.diffview">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.diffview.on">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="Border.diffrow">
      <Setter Property="MinHeight" Value="17" />
    </Style>
    <Style Selector="Border.diffrow.added">
      <Setter Property="Background" Value="{DynamicResource DiffAddBgBrush}" />
    </Style>
    <Style Selector="Border.diffrow.removed">
      <Setter Property="Background" Value="{DynamicResource DiffDelBgBrush}" />
    </Style>
    <Style Selector="Border.diffrow.gap">
      <Setter Property="Background" Value="{DynamicResource BgRaisedBrush}" />
      <Setter Property="Margin" Value="0,4" />
      <Setter Property="Padding" Value="0,2" />
    </Style>
    <Style Selector="TextBlock.diffnum">
      <Setter Property="Foreground" Value="{DynamicResource CodeLineNumberBrush}" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="TextBlock.diffsign">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="Border.diffrow.added TextBlock.diffsign">
      <Setter Property="Foreground" Value="{DynamicResource DiffAddBrush}" />
    </Style>
    <Style Selector="Border.diffrow.removed TextBlock.diffsign">
      <Setter Property="Foreground" Value="{DynamicResource DiffDelBrush}" />
    </Style>
    <Style Selector="TextBlock.difftext">
      <Setter Property="Foreground" Value="{DynamicResource CodeTextBrush}" />
      <Setter Property="Margin" Value="0,0,24,0" />
    </Style>
    <Style Selector="Border.diffrow.gap TextBlock.difftext">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="FontStyle" Value="Italic" />
    </Style>

    <!-- The navigation bar's type and member: fade in and out as the caret moves between them. -->
    <Style Selector="StackPanel.crumb">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="StackPanel.crumb.on">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- The find box: a raised card that fades and drops a little into place. -->
    <Style Selector="Border.findbox">
      <Setter Property="Background" Value="{DynamicResource BgMenuBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="3,4,6,4" />
      <Setter Property="BoxShadow" Value="0 6 20 0 #4D000000" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform" Value="translateY(-6px)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.findbox.raised">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="translateY(0px)" />
    </Style>
    <Style Selector="Border.findfield">
      <Setter Property="Background" Value="{DynamicResource BgInputBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderInputBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="7,0,2,0" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.findfield.nomatch">
      <Setter Property="BorderBrush" Value="{DynamicResource DiffDelBrush}" />
    </Style>
    <Style Selector="Border.findfield TextBox">
      <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSmall}" />
    </Style>
    <Style Selector="Button.findtool">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSmall}" />
    </Style>
    <Style Selector="Button.findword">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="Padding" Value="7,0" />
    </Style>
    <Style Selector="Button.findtoggle TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Button.findtoggle.on">
      <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBlock.findstatus">
      <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSmall}" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
    <!-- The replace toggle's chevron: right while closed, down while open, crossfading. -->
    <Style Selector="Button.findexpand c|Icon">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.findexpand c|Icon.down, Button.findexpand.open c|Icon.right">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.findexpand.open c|Icon.down">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border#Card.flush">
      <Setter Property="CornerRadius" Value="0,10,10,10" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">
    <!-- The tabs, one pixel over the card so the active one covers its border. -->
    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,-1" ZIndex="1">
      <ItemsControl ItemsSource="{Binding Tabs}" ClipToBounds="True" ItemTemplate="{StaticResource TabTemplate}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,8,0" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>

      <!-- The preview tab, on its own at the right end of the row, as in Visual Studio. -->
      <ContentControl Grid.Column="1" Content="{Binding PreviewTab}" ContentTemplate="{StaticResource TabTemplate}" IsVisible="{Binding HasPreview}" Margin="8,0,6,0" />

      <!-- The file shown here moves to a second group beside this one. -->
      <Button Grid.Column="2"
              Theme="{StaticResource IconButton}"
              Width="26"
              Height="26"
              Margin="0,0,4,2"
              VerticalAlignment="Center"
              IsVisible="{Binding CanSplit}"
              IsEnabled="{Binding HasTabs}"
              Command="{Binding OpenToSideCommand}"
              CommandParameter="{Binding ActiveTab}"
              ToolTip.Tip="Move to the side">
        <c:Icon Size="14" Data="{StaticResource IconPanelRight}" />
      </Button>
    </Grid>

    <!-- The file's card; its top-left corner squares off while the first tab, joined to it there, is the active one. -->
    <Border Grid.Row="1"
            Name="Card"
            Classes.flush="{Binding IsFirstActive}"
            Background="{DynamicResource CodeBackgroundBrush}"
            BorderBrush="{DynamicResource BorderCardBrush}"
            BorderThickness="1"
            ClipToBounds="True">
      <Panel>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" IsVisible="{Binding !HasTabs}">
          <c:Icon Size="22" Data="{StaticResource IconFile}" Stroke="{DynamicResource TextMutedBrush}" />
          <TextBlock Text="Pick a file in the tree" Classes="muted" HorizontalAlignment="Center" />
        </StackPanel>

        <DockPanel Name="Document" IsVisible="{Binding HasTabs}">
          <!-- Where the file is, as Visual Studio's navigation bar sits over the code. -->
          <Border DockPanel.Dock="Top" Height="28" Padding="14,0,6,0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
            <!-- The diff with the last commit, in place of the text (and back). -->
            <Button DockPanel.Dock="Right"
                    Theme="{StaticResource FlatButton}"
                    Classes="difftoggle"
                    Classes.on="{Binding ActiveTab.ShowDiff, FallbackValue=False}"
                    IsVisible="{Binding ActiveTab.HasGitBase, FallbackValue=False}"
                    Command="{Binding ActiveTab.ToggleDiffCommand}"
                    ToolTip.Tip="Compare with the last commit">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <c:Icon Size="12" Data="{StaticResource IconGitBranch}" />
                <TextBlock Text="Compare" />
              </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" TextElement.FontSize="{DynamicResource UiFontSizeSmall}">
              <TextBlock Text="{Binding ActiveTab.RelativeFolder}" Classes="muted" MaxWidth="420" TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding ActiveTab.HasRelativeFolder}" VerticalAlignment="Center" />
              <TextBlock Text="/" Classes="muted" IsVisible="{Binding ActiveTab.HasRelativeFolder}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ActiveTab.Name}" Foreground="{DynamicResource TextChromeBrush}" VerticalAlignment="Center" />
              <!-- The type and member the caret is in, as Visual Studio's navigation bar. -->
              <StackPanel Orientation="Horizontal" Spacing="6" Classes="crumb" Classes.on="{Binding ActiveTab.CaretType, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="&#x203A;" Classes="muted" VerticalAlignment="Center" />
                <ide:CodeSymbolIcon Kind="{Binding ActiveTab.CaretType.Kind, FallbackValue=Class}" Width="14" Height="14" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ActiveTab.CaretType.Name}" Foreground="{DynamicResource TextChromeBrush}" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" Classes="crumb" Classes.on="{Binding ActiveTab.CaretMember, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="&#x203A;" Classes="muted" VerticalAlignment="Center" />
                <ide:CodeSymbolIcon Kind="{Binding ActiveTab.CaretMember.Kind, FallbackValue=Method}" Width="14" Height="14" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ActiveTab.CaretMember.Name}" Foreground="{DynamicResource TextChromeBrush}" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{Binding ActiveTab.Note}" Classes="muted" Margin="10,0,0,0" IsVisible="{Binding ActiveTab.HasNote}" VerticalAlignment="Center" />
            </StackPanel>
            </DockPanel>
          </Border>

          <!-- Closing a tab with unsaved edits asks first. -->
          <Border DockPanel.Dock="Top" Classes="docbar" IsVisible="{Binding ActiveTab.IsAskingToClose, Mode=OneTime, FallbackValue=False}" c:Fold.IsOpen="{Binding ActiveTab.IsAskingToClose, FallbackValue=False}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                <Button Theme="{StaticResource GhostButton}" Content="Cancel" Command="{Binding CancelCloseCommand}" CommandParameter="{Binding ActiveTab}" />
                <Button Theme="{StaticResource SecondaryButton}" Content="Don't save" Command="{Binding CloseWithoutSavingCommand}" CommandParameter="{Binding ActiveTab}" />
                <Button Theme="{StaticResource PrimaryButton}" Content="Save" Command="{Binding SaveAndCloseCommand}" CommandParameter="{Binding ActiveTab}" />
              </StackPanel>
              <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                <Run Text="Save your changes to" /> <Run Text="{Binding ActiveTab.Name}" FontWeight="Medium" /><Run Text="?" />
              </TextBlock>
            </DockPanel>
          </Border>

          <!-- Another program wrote the file while it had unsaved edits here. -->
          <Border DockPanel.Dock="Top" Classes="docbar" IsVisible="{Binding ActiveTab.ChangedOnDisk, Mode=OneTime, FallbackValue=False}" c:Fold.IsOpen="{Binding ActiveTab.ChangedOnDisk, FallbackValue=False}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                <Button Theme="{StaticResource SecondaryButton}" Content="Keep mine" Command="{Binding ActiveTab.KeepMineCommand}" ToolTip.Tip="Saving then overwrites the change on disk" />
                <Button Theme="{StaticResource PrimaryButton}" Content="Reload" Command="{Binding ActiveTab.ReloadCommand}" ToolTip.Tip="Take the file as it is now, dropping your edits" />
              </StackPanel>
              <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="The file changed on disk since you started editing it." />
            </DockPanel>
          </Border>

          <Panel>
          <!-- Visual Studio's editor size: 10 pt (13.33 px) on 17 px lines; only the lines in view are drawn. -->
          <ScrollViewer Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ide:CodeView Name="Code"
                          Document="{Binding ActiveTab.Document}"
                          FontFamily="{DynamicResource MonoFont}"
                          FontSize="13.333"
                          Foreground="{DynamicResource CodeTextBrush}"
                          SelectionBrush="{DynamicResource TextSelectionBrush}"
                          CaretBrush="{DynamicResource TextCaretBrush}"
                          LineHeight="17"
                          Padding="0,12,18,24" />
          </ScrollViewer>

          <!-- The diff with the last commit: removed lines red, added green, unchanged runs folded. -->
          <Border Classes="diffview" Classes.on="{Binding ActiveTab.ShowDiff, FallbackValue=False}" Background="{DynamicResource CodeBackgroundBrush}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding ActiveTab.DiffRows, FallbackValue={x:Null}}" Margin="0,8,0,24"
                            TextElement.FontFamily="{DynamicResource MonoFont}" TextElement.FontSize="13.333">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DiffRow">
                    <Border Classes="diffrow" Classes.added="{Binding IsAdded}" Classes.removed="{Binding IsRemoved}" Classes.gap="{Binding IsGap}">
                      <Grid ColumnDefinitions="44,44,18,*">
                        <TextBlock Text="{Binding OldNumber}" Classes="diffnum" />
                        <TextBlock Grid.Column="1" Text="{Binding NewNumber}" Classes="diffnum" />
                        <TextBlock Grid.Column="2" Text="{Binding Kind}" Classes="diffsign" />
                        <TextBlock Grid.Column="3" Text="{Binding Text}" Classes="difftext" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>

          <!-- The find's matches beside the scroll bar. -->
          <ide:CodeMarkerBar Document="{Binding ActiveTab.Document}" Width="6" HorizontalAlignment="Right" Margin="0,2,2,14" />

          <!-- Find and replace (Ctrl+F, Ctrl+H), over the code's top right as in Visual Studio. -->
          <Border Name="FindBox"
                  Classes="findbox"
                  Classes.raised="{Binding Find.IsRaised}"
                  IsVisible="{Binding Find.IsShown}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="0,6,22,0">
            <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto">
              <Button Theme="{StaticResource IconButton}" Classes="findtool findexpand" Classes.open="{Binding Find.IsReplaceShown}" Width="20" Height="24" Grid.RowSpan="2" VerticalAlignment="Top"
                      Command="{Binding Find.ToggleReplaceCommand}" ToolTip.Tip="Toggle replace (Ctrl+H)">
                <Panel>
                  <c:Icon Classes="right" Size="12" Data="{StaticResource IconChevronRight}" />
                  <c:Icon Classes="down" Size="12" Data="{StaticResource IconChevronDown}" />
                </Panel>
              </Button>
              <Border Grid.Column="1" Classes="findfield" Classes.nomatch="{Binding Find.HasNoMatch}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Name="FindQuery" Theme="{StaticResource BareTextBox}" Width="200" Watermark="Find" Text="{Binding Find.Query}" VerticalAlignment="Center" KeyDown="OnFindKeyDown" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="1">
                    <Button Theme="{StaticResource IconButton}" Classes="findtool findtoggle" Classes.on="{Binding Find.MatchCase}" Command="{Binding Find.ToggleMatchCaseCommand}" ToolTip.Tip="Match case">
                      <TextBlock Text="Aa" />
                    </Button>
                    <Button Theme="{StaticResource IconButton}" Classes="findtool findtoggle" Classes.on="{Binding Find.WholeWord}" Command="{Binding Find.ToggleWholeWordCommand}" ToolTip.Tip="Match whole word">
                      <TextBlock Text="ab" TextDecorations="Underline" />
                    </Button>
                    <Button Theme="{StaticResource IconButton}" Classes="findtool findtoggle" Classes.on="{Binding Find.UseRegex}" Command="{Binding Find.ToggleRegexCommand}" ToolTip.Tip="Use regular expressions">
                      <TextBlock Text=".*" />
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="1" Margin="6,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Find.Status}" Classes="muted findstatus" MinWidth="64" VerticalAlignment="Center" />
                <Button Theme="{StaticResource IconButton}" Classes="findtool" Command="{Binding Find.PreviousCommand}" ToolTip.Tip="Previous (Shift+F3)">
                  <c:Icon Size="12" Data="{StaticResource IconChevronRight}" RenderTransform="rotate(-90deg)" />
                </Button>
                <Button Theme="{StaticResource IconButton}" Classes="findtool" Command="{Binding Find.NextCommand}" ToolTip.Tip="Next (F3)">
                  <c:Icon Size="12" Data="{StaticResource IconChevronRight}" RenderTransform="rotate(90deg)" />
                </Button>
                <Button Theme="{StaticResource IconButton}" Classes="findtool" Click="OnFindClose" ToolTip.Tip="Close (Esc)">
                  <c:Icon Size="10" Data="{StaticResource IconClose}" />
                </Button>
              </StackPanel>
              <Border Grid.Row="1" Grid.Column="1" Classes="findfield" Margin="0,4,0,0" IsVisible="{Binding Find.IsReplaceShown}">
                <TextBox Name="FindReplace" Theme="{StaticResource BareTextBox}" Width="200" Watermark="Replace" Text="{Binding Find.ReplaceText}" VerticalAlignment="Center" KeyDown="OnReplaceKeyDown" />
              </Border>
              <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="1" Margin="6,4,0,0" IsVisible="{Binding Find.IsReplaceShown}">
                <Button Theme="{StaticResource IconButton}" Classes="findtool findword" Command="{Binding Find.ReplaceCommand}" ToolTip.Tip="Replace next (Alt+R)">
                  <TextBlock Text="Replace" />
                </Button>
                <Button Theme="{StaticResource IconButton}" Classes="findtool findword" Command="{Binding Find.ReplaceAllCommand}" ToolTip.Tip="Replace all (Alt+A)">
                  <TextBlock Text="All" />
                </Button>
              </StackPanel>
            </Grid>
          </Border>
          </Panel>
        </DockPanel>
      </Panel>
    </Border>
  </Grid>
</UserControl>
