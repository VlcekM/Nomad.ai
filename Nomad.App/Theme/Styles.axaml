<Styles xmlns="https://github.com/avaloniaui"
        xmlns:c="using:Nomad.App.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource BgMainBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
  </Style>

  <!-- Every scroller eases to its wheel target instead of jumping (Controls/SmoothScroll.cs). -->
  <Style Selector="ScrollViewer">
    <Setter Property="c:SmoothScroll.IsEnabled" Value="True" />
    <!-- Middle-button autoscroll, as in a browser (Controls/AutoScroll.cs). -->
    <Setter Property="c:AutoScroll.IsEnabled" Value="True" />
  </Style>

  <!-- Text roles -->
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <!-- A plan limit that, at the rate so far, runs out before it resets. -->
  <Style Selector="TextBlock.muted.warn">
    <Setter Property="Foreground" Value="{DynamicResource WaitingBrush}" />
  </Style>
  <!-- A plan limit's reset time: fades in only while the pointer is over its card (or the usage popup). -->
  <Style Selector="TextBlock.resets">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector=":is(Control).usage:pointerover TextBlock.resets">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <!-- The usage card's retry button while it reads again. -->
  <Style Selector="c|Icon.spin">
    <Style.Animations>
      <Animation Duration="0:0:0.9" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="360" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- A plan limit that is close to (or past) running out. -->
  <Style Selector="c|FillSlider.high">
    <Setter Property="FillBrush" Value="{DynamicResource DangerBrush}" />
  </Style>
  <!-- A branch's unpushed commits (↑N): fades in when it shows. -->
  <Style Selector="StackPanel.ahead">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="StackPanel.ahead.on">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="TextBlock.chrome">
    <Setter Property="Foreground" Value="{DynamicResource TextChromeBrush}" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSmall}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="{DynamicResource UiFontSizeTiny}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="TextBlock.mono, SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSmall}" />
  </Style>

  <Style Selector="SelectableTextBlock">
    <Setter Property="SelectionBrush" Value="{DynamicResource TextSelectionBrush}" />
  </Style>

  <!-- The working line's shimmer: muted text with a bright (dark: light, light: dark) band passing over it. -->
  <Style Selector="c|Shimmer">
    <Setter Property="BaseColor" Value="{DynamicResource ShimmerBaseColor}" />
    <Setter Property="HighlightColor" Value="{DynamicResource ShimmerHighlightColor}" />
  </Style>

  <!-- Scrollbars appear while the pointer is over the scroll area (or while scrolling). -->
  <Style Selector="ScrollViewer /template/ ScrollBar">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ScrollViewer:pointerover /template/ ScrollBar">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- Popup menus -->
  <Style Selector="FlyoutPresenter.menu">
    <Setter Property="Background" Value="{DynamicResource BgMenuBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MaxWidth" Value="480" />
    <Setter Property="MaxHeight" Value="640" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>
  <Style Selector="FlyoutPresenter.menu /template/ Border#LayoutRoot">
    <Setter Property="BoxShadow" Value="0 8 24 0 #73000000" />
  </Style>

  <!-- Separators inside menus and lists -->
  <!-- On/off switch (fast mode): a pill with a sliding knob; the knob glides and the colour crossfades. -->
  <Style Selector="Border.switch">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="14" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="{DynamicResource SwitchOffBrush}" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.switch.on">
    <Setter Property="Background" Value="{DynamicResource RingBrush}" />
  </Style>
  <Style Selector="Border.switch > Ellipse">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="Fill" Value="White" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="RenderTransform" Value="translateX(0px)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.switch.on > Ellipse">
    <Setter Property="RenderTransform" Value="translateX(10px)" />
  </Style>
  <!-- The settings' switches: a size up. -->
  <Style Selector="Border.switch.large">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="20" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Border.switch.large > Ellipse">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>
  <Style Selector="Border.switch.large.on > Ellipse">
    <Setter Property="RenderTransform" Value="translateX(16px)" />
  </Style>

  <Style Selector="Border.rule">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Margin" Value="6,4" />
  </Style>
  <!-- A context menu's separator: the same rule. -->
  <Style Selector="ContextMenu Separator">
    <Setter Property="Height" Value="1" />
    <Setter Property="MinHeight" Value="1" />
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Margin" Value="6,4" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- Tooltips -->
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource BgMenuBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource TextChromeBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSmall}" />
    <Setter Property="Padding" Value="8,5" />
  </Style>
  <Style Selector="ToolTip.fit">
    <Setter Property="MaxWidth" Value="1000" />
  </Style>
</Styles>
