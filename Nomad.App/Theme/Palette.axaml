<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Nomad palette, dark and light. Dark: measured off the reference screenshots of the pre-restyle Claude desktop
    app (docs/reference, 1920x1080 at 100 %); where DESIGN.md's estimates differ, the screenshots win. Light: the
    same roles on Claude's warm paper tones. Accent values are the exact brand tokens. Everything that depends on
    the theme is looked up with DynamicResource, so a theme switch applies at once.
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <!-- Surfaces -->
      <Color x:Key="BgSidebarColor">#101010</Color>
      <Color x:Key="BgMainColor">#141414</Color>
      <Color x:Key="BgRaisedColor">#1F1F1F</Color>
      <Color x:Key="BgSelectedColor">#2B2B29</Color>
      <Color x:Key="BgHoverColor">#0BFFFFFF</Color>
      <Color x:Key="BgPressedColor">#16FFFFFF</Color>
      <Color x:Key="BgInputColor">#20201E</Color>
      <Color x:Key="BgSearchColor">#1C1C1C</Color>
      <Color x:Key="BgCodeColor">#1A1A19</Color>
      <Color x:Key="BgChipColor">#262626</Color>
      <Color x:Key="BgMenuColor">#20201E</Color>
      <Color x:Key="BgOverlayColor">#80000000</Color>
