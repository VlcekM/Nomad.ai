<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Nomad.App.Controls">
  <!--
    Control themes. Nomad replaces Fluent's button/textbox/scrollbar templates with flat ones, so
    hover and pressed states are exactly the palette's (Bg.Hover etc.) instead of Fluent's.
  -->

  <!-- Flat button: transparent, Bg.Hover on hover. The base of every Nomad button. -->
  <ControlTheme x:Key="FlatButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextChromeBrush}" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Padding="{TemplateBinding Padding}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          Foreground="{TemplateBinding Foreground}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource BgPressedBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
  </ControlTheme>

  <!-- 28x28 icon button (title bar, composer "+", sidebar header "+"). -->
  <ControlTheme x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </ControlTheme>

  <!-- Window caption buttons, 46x36 (close turns Windows red). -->
  <ControlTheme x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextChromeBrush}" />
    <Style Selector="^.close:pointerover">
      <Setter Property="Background" Value="{DynamicResource CaptionCloseHoverBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="^.close:pressed">
      <Setter Property="Background" Value="#A32519" />
    </Style>
  </ControlTheme>

  <!-- Sidebar rows: 30 px, radius 6, selected = Bg.Selected + weight 500. -->
  <ControlTheme x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource TextChromeBrush}" />
    <Style Selector="^.selected">
      <Setter Property="Background" Value="{DynamicResource BgSelectedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
  </ControlTheme>

  <!-- Status-row chips (folder, mode, model): flat, Bg.Chip when hovered or open. -->
  <ControlTheme x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Foreground" Value="{DynamicResource TextChromeBrush}" />
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource BgChipBrush}" />
    </Style>
    <Style Selector="^.open">
      <Setter Property="Background" Value="{DynamicResource BgChipBrush}" />
    </Style>
    <!-- The current model among the model chips. -->
    <Style Selector="^.selected">
      <Setter Property="Background" Value="{DynamicResource BgChipBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
  </ControlTheme>

  <!-- Popup menu items: 24 px rows, radius 6. -->
  <ControlTheme x:Key="MenuItemButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontWeight" Value="Normal" />
  </ControlTheme>

  <!-- Context menus look like the popup menus (FlyoutPresenter.menu with MenuItemButton rows). -->
  <ControlTheme x:Key="ContextMenuItem" TargetType="MenuItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_LayoutRoot"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}"
                MinHeight="{TemplateBinding MinHeight}">
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <ContentPresenter Name="PART_HeaderPresenter"
                              Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                              VerticalAlignment="Center" />
            <TextBlock Name="PART_InputGestureText"
                       Grid.Column="1"
                       Margin="24,0,0,0"
                       Text="{TemplateBinding InputGesture}"
                       FontSize="{DynamicResource UiFontSizeSmall}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       VerticalAlignment="Center" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover, ^:selected">
      <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource BgPressedBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <!-- Delete and the like. -->
    <Style Selector="^.danger">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ContextMenu}" TargetType="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource BgMenuBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="MinWidth" Value="160" />
    <Setter Property="MaxWidth" Value="480" />
    <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="WindowManagerAddShadowHint" Value="False" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource ContextMenuItem}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}"
                MinWidth="{TemplateBinding MinWidth}"
                MaxWidth="{TemplateBinding MaxWidth}"
                BoxShadow="0 8 24 0 #73000000">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsPresenter Name="PART_ItemsPresenter"
                            ItemsPanel="{TemplateBinding ItemsPanel}"
                            KeyboardNavigation.TabNavigation="Continue" />
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- Text-only line (tool groups, thinking): muted, brighter on hover, no fill. -->
  <ControlTheme x:Key="LineButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
    <Setter Property="Padding" Value="0,2" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Cursor" Value="Hand" />
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextChromeBrush}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </ControlTheme>

  <!-- Small square button on the agent status line (stop). -->
  <ControlTheme x:Key="SquareButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="{DynamicResource BgButtonBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextChromeBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource BgButtonHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
  </ControlTheme>

  <!-- Round "scroll to bottom" button. -->
  <ControlTheme x:Key="RoundButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Background" Value="{DynamicResource BgRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextChromeBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource BgSelectedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
  </ControlTheme>

  <!-- Composer send / stop: 28 px, accent fill for send. -->
  <ControlTheme x:Key="SendButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentEmphasisBrush}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource AccentEmphasisBrush}" />
    </Style>
    <Style Selector="^.stop">
      <Setter Property="Background" Value="{DynamicResource BgButtonBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="^.stop:pointerover">
      <Setter Property="Background" Value="{DynamicResource BgButtonHoverBrush}" />
    </Style>
  </ControlTheme>

  <!-- Rows of the new-session folder card: 34 px. -->
  <ControlTheme x:Key="CardRowButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource TextChromeBrush}" />
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
  </ControlTheme>

  <!-- Question card option: a rounded row, hover fill, brighter when chosen. (Its list sits 4 px out, so the text stays
       near the question's: a negative margin here would be clipped by the list.) -->
  <ControlTheme x:Key="OptionButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource TextChromeBrush}" />
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="^.selected">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
    </Style>
  </ControlTheme>

  <!-- Primary: accent fill, dark label. -->
  <ControlTheme x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Height" Value="30" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentEmphasisBrush}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource AccentEmphasisBrush}" />
    </Style>
  </ControlTheme>

  <!-- Inverted: the text colour as fill (white on dark, near-black on light), as the question card's Submit. -->
  <ControlTheme x:Key="InvertedButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
    <Setter Property="Background" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource BgMainBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Opacity" Value="0.88" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Opacity" Value="0.8" />
    </Style>
  </ControlTheme>

  <!-- Secondary: raised fill with a border. -->
  <ControlTheme x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
    <Setter Property="Background" Value="{DynamicResource BgRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Height" Value="30" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource BgSelectedBrush}" />
    </Style>
  </ControlTheme>

  <!-- Ghost: label only; Deny turns Danger on hover. -->
  <ControlTheme x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Height" Value="30" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Style Selector="^.danger:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
      <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}" />
    </Style>
  </ControlTheme>

  <!-- Text box without chrome (composer, search boxes); the host draws the frame. -->
  <ControlTheme x:Key="BareTextBox" TargetType="TextBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextCaretBrush}" />
    <Setter Property="Cursor" Value="IBeam" />
    <Setter Property="SelectionBrush" Value="{DynamicResource TextSelectionBrush}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ScrollViewer.IsScrollChainingEnabled" Value="True" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
          <ScrollViewer Name="PART_ScrollViewer"
                        HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                        VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                        IsScrollChainingEnabled="{TemplateBinding (ScrollViewer.IsScrollChainingEnabled)}"
                        AllowAutoHide="True">
            <Panel>
              <TextBlock Name="PART_Watermark"
                         Text="{TemplateBinding Watermark}"
                         Foreground="{DynamicResource TextMutedBrush}"
                         TextWrapping="{TemplateBinding TextWrapping}"
                         VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                         IsHitTestVisible="False"
                         IsVisible="{TemplateBinding Text, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
              <TextPresenter Name="PART_TextPresenter"
                             Text="{TemplateBinding Text, Mode=TwoWay}"
                             CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                             CaretIndex="{TemplateBinding CaretIndex}"
                             SelectionStart="{TemplateBinding SelectionStart}"
                             SelectionEnd="{TemplateBinding SelectionEnd}"
                             TextAlignment="{TemplateBinding TextAlignment}"
                             TextWrapping="{TemplateBinding TextWrapping}"
                             LineHeight="{TemplateBinding LineHeight}"
                             PasswordChar="{TemplateBinding PasswordChar}"
                             RevealPassword="{TemplateBinding RevealPassword}"
                             SelectionBrush="{TemplateBinding SelectionBrush}"
                             SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                             CaretBrush="Transparent"
                             VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
              <!-- The caret itself: the presenter's is transparent, see TextCaret. -->
              <c:TextCaret Presenter="{Binding #PART_TextPresenter}" CaretBrush="{TemplateBinding CaretBrush}" />
            </Panel>
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- BareTextBox showing Markdown as it is typed (MarkdownPresenter), list bullets as dots, and list writing
       (MarkdownEditing): the composer. -->
  <ControlTheme x:Key="MarkdownTextBox" TargetType="TextBox" BasedOn="{StaticResource BareTextBox}">
    <Setter Property="c:MarkdownEditing.IsEnabled" Value="True" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
          <ScrollViewer Name="PART_ScrollViewer"
                        HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                        VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                        IsScrollChainingEnabled="{TemplateBinding (ScrollViewer.IsScrollChainingEnabled)}"
                        AllowAutoHide="True">
            <Panel>
              <TextBlock Name="PART_Watermark"
                         Text="{TemplateBinding Watermark}"
                         Foreground="{DynamicResource TextMutedBrush}"
                         TextWrapping="{TemplateBinding TextWrapping}"
                         VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                         IsHitTestVisible="False"
                         IsVisible="{TemplateBinding Text, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
              <c:MarkdownPresenter Name="PART_TextPresenter"
                                   Text="{TemplateBinding Text, Mode=TwoWay}"
                                   CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                   CaretIndex="{TemplateBinding CaretIndex}"
                                   SelectionStart="{TemplateBinding SelectionStart}"
                                   SelectionEnd="{TemplateBinding SelectionEnd}"
                                   TextAlignment="{TemplateBinding TextAlignment}"
                                   TextWrapping="{TemplateBinding TextWrapping}"
                                   LineHeight="{TemplateBinding LineHeight}"
                                   PasswordChar="{TemplateBinding PasswordChar}"
                                   RevealPassword="{TemplateBinding RevealPassword}"
                                   SelectionBrush="{TemplateBinding SelectionBrush}"
                                   SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                   CaretBrush="Transparent"
                                   MarkerBrush="{DynamicResource TextMutedBrush}"
                                   ListBrush="{DynamicResource AccentBrush}"
                                   CodeBrush="{DynamicResource InlineCodeBrush}"
                                   LinkBrush="{DynamicResource LinkBrush}"
                                   QuoteBrush="{DynamicResource TextSecondaryBrush}"
                                   CodeFontFamily="{DynamicResource MonoFont}"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
              <c:MarkdownBullets Presenter="{Binding #PART_TextPresenter}" Fill="{DynamicResource AccentBrush}" />
              <c:TextCaret Presenter="{Binding #PART_TextPresenter}" CaretBrush="{TemplateBinding CaretBrush}" />
            </Panel>
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- Thin scrollbars: 6 px thumb, no track or arrows; shown while the pointer is over the scroll area. -->
  <ControlTheme x:Key="ThinThumb" TargetType="Thumb">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="ThumbVisual" Background="{DynamicResource ScrollThumbBrush}" CornerRadius="3" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#ThumbVisual">
      <Setter Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
    <Setter Property="Cursor" Value="Arrow" />
    <Style Selector="^:vertical">
      <Setter Property="Width" Value="10" />
      <Setter Property="Template">
        <ControlTemplate>
          <Track Name="PART_Track"
                 Margin="2,2"
                 Minimum="{TemplateBinding Minimum}"
                 Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value, Mode=TwoWay}"
                 ViewportSize="{TemplateBinding ViewportSize}"
                 Orientation="{TemplateBinding Orientation}"
                 IsDirectionReversed="True">
            <Thumb Theme="{StaticResource ThinThumb}" Width="6" HorizontalAlignment="Center" />
          </Track>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="^:horizontal">
      <Setter Property="Height" Value="10" />
      <Setter Property="Template">
        <ControlTemplate>
          <Track Name="PART_Track"
                 Margin="2,2"
                 Minimum="{TemplateBinding Minimum}"
                 Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value, Mode=TwoWay}"
                 ViewportSize="{TemplateBinding ViewportSize}"
                 Orientation="{TemplateBinding Orientation}">
            <Thumb Theme="{StaticResource ThinThumb}" Height="6" VerticalAlignment="Center" />
          </Track>
        </ControlTemplate>
      </Setter>
    </Style>
  </ControlTheme>

  <!-- Segmented control segment (settings): checked = lighter fill with a 1 px border. -->
  <ControlTheme x:Key="SegmentButton" TargetType="RadioButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextChromeBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="11,0" />
    <Setter Property="Height" Value="27" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Padding="{TemplateBinding Padding}"
                          Content="{TemplateBinding Content}"
                          Foreground="{TemplateBinding Foreground}"
                          VerticalContentAlignment="Center"
                          HorizontalContentAlignment="Center" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Background" Value="{DynamicResource BgSegmentCheckedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderInputBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
  </ControlTheme>

  <!-- Settings navigation rows: 32 px, selected = #383838. -->
  <ControlTheme x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="FontSize" Value="{DynamicResource UiFontSizeLarge}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource TextNavBrush}" />
    <Style Selector="^.selected">
      <Setter Property="Background" Value="{DynamicResource BgNavSelectedBrush}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
