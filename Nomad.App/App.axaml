<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Nomad.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Nomad.ai/Theme/Palette.axaml" />
        <ResourceInclude Source="avares://Nomad.ai/Theme/Icons.axaml" />
        <ResourceInclude Source="avares://Nomad.ai/Theme/Controls.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <!-- Fluent, dark only, with its palette recoloured from the Nomad tokens. -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark"
                               Accent="#D97757"
                               RegionColor="#141414"
                               AltHigh="#141414"
                               AltLow="#141414"
                               AltMedium="#141414"
                               AltMediumHigh="#141414"
                               AltMediumLow="#141414"
                               BaseHigh="#EEEDE8"
                               BaseLow="#363636"
                               BaseMedium="#8A8883"
                               BaseMediumHigh="#C4C3BB"
                               BaseMediumLow="#5A5955"
                               ChromeAltLow="#EEEDE8"
                               ChromeBlackHigh="#000000"
                               ChromeBlackLow="#C4C3BB"
                               ChromeBlackMedium="#000000"
                               ChromeBlackMediumLow="#000000"
                               ChromeDisabledHigh="#363636"
                               ChromeDisabledLow="#5A5955"
                               ChromeGray="#8A8883"
                               ChromeHigh="#4C4C4C"
                               ChromeLow="#1C1C1C"
                               ChromeMedium="#20201E"
                               ChromeMediumLow="#1A1A1A"
                               ChromeWhite="#FFFFFF"
                               ListLow="#0BFFFFFF"
                               ListMedium="#2B2B29"
                               ErrorText="#E0605A" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Nomad.ai/Theme/Styles.axaml" />
  </Application.Styles>
</Application>
